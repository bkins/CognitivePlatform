<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CognitivePlatform.Admin</AssemblyName>
    <UserSecretsId>cp-admin-local-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CP.Shared.Primitives\CP.Shared.Primitives\CP.Shared.Primitives.csproj" />
    <ProjectReference Include="..\..\CP.Client.Core\CP.Client.Core\CP.Client.Core.csproj" />
    <!-- Verify this is the latest stable MudBlazor version for .NET 10 -->
    <PackageReference Include="MudBlazor"            Version="8.3.0"  />
    <!-- Markdown rendering in Journal Admin (revision text view) -->
    <PackageReference Include="Markdig"              Version="0.38.0" />
    <PackageReference Include="System.Management.Automation" Version="7.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="CP.Shared.Primitives.Avails.Extensions" />
  </ItemGroup>

</Project>
