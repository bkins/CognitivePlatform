@inherits LayoutComponentBase
@inject AdminSessionService SessionService
@inject NavigationManager   NavManager
@inject EnvironmentService  EnvService

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (SessionService.IsAuthenticated)
{
    <MudLayout>
        <MudAppBar Elevation="2" Style="@AppBarStyle">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@ToggleDrawer" />

            <MudText Typo="Typo.h6" Class="ml-3" Style="color:white">CP Admin</MudText>

            <MudSpacer />

            @* ── Environment switcher ── *@
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.65);margin-right:8px;font-family:monospace">
                @EnvService.BaseUrl
            </MudText>
            @foreach (var env in new[] { "DEV", "QA", "PROD" })
            {
                <MudButton Size="Size.Small"
                           Variant="@(EnvService.Current == env ? Variant.Filled : Variant.Outlined)"
                           Style="@(EnvService.Current == env
                                        ? "color:white;border-color:rgba(255,255,255,0.9);min-width:52px;margin-left:4px;font-weight:700"
                                        : "color:rgba(255,255,255,0.7);border-color:rgba(255,255,255,0.4);min-width:52px;margin-left:4px")"
                           Disabled="@(EnvService.Current == env)"
                           OnClick="@(() => SwitchEnvironment(env))">
                    @env
                </MudButton>
            }
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;

    private string AppBarStyle => EnvService.Current switch
    {
        "QA"   => "background:#e65100;"
      , "PROD" => "background:#b71c1c;"
      , _      => "background:#1b5e20;"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender.Not()) return;

        if (SessionService.IsAuthenticated.Not())
            NavManager.NavigateTo("/login");
    }

    private void SwitchEnvironment(string env)
    {
        EnvService.Switch(env);
        StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
