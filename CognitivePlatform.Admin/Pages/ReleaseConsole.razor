    /// <summary>Finds wt.exe (Windows Terminal) — typically in WindowsApps on a Store install.</summary>
    private static string ResolveWt()
    {
        var wtPaths = new[]
        {
            Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.LocalApplicationData)
                       , @"Microsoft\WindowsApps\wt.exe")
        };
        foreach (var path in wtPaths)
            if (File.Exists(path)) return path;

        // Also try PATH
        var pathVar = System.Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
        foreach (var dir in pathVar.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            try
            {
                var candidate = Path.Combine(dir.Trim(), "wt.exe");
                if (File.Exists(candidate)) return candidate;
            }
            catch { /* skip */ }
        }
        return "wt";
    }

    private async Task StartApiAsync(string env)
    {
        var profile     = ApiTerminalProfile(env);
        var wt          = ResolveWt();
        const string processName = "CognitivePlatform.Api";

        TerminalService.Clear("release");

        var already = Process.GetProcessesByName(processName);
        if (already.Length > 0)
        {
            TerminalService.AppendLine("release", new TerminalLine($"[{processName} is already running — PID {already[0].Id}]"));
            TerminalService.SetExitCode("release", 0);
            return;
        }

        TerminalService.AppendLine("release", new TerminalLine($"$ wt -p \"{profile}\""));
        TerminalService.AppendLine("release", new TerminalLine($"Opening Windows Terminal profile \"{profile}\"…"));

        try
        {
            Process.Start(new ProcessStartInfo
            {
                FileName        = wt
              , Arguments       = $@"-p ""{profile}"""
              , UseShellExecute = true
            });

            const int secondsToWait = 5;
            TerminalService.AppendLine("release", new TerminalLine($"Waiting {secondsToWait} s for API to initialise…"));

            await Task.Delay(secondsToWait * 1000);

            var running = Process.GetProcessesByName(processName);
            if (running.Length > 0)
            {
                TerminalService.AppendLine("release", new TerminalLine($"[Running — PID {running[0].Id}. Live output is in the Terminal window.]"));
                TerminalService.SetExitCode("release", 0);
            }
            else
            {
                TerminalService.AppendLine("release", new TerminalLine($"[API process not found after {secondsToWait} s — check the Terminal window for startup errors.]", TerminalLineKind.Error));
                TerminalService.SetExitCode("release", 1);
            }
        }
        catch (Exception ex)
        {
            TerminalService.SetError("release", ex.Message);
            TerminalService.AppendLine("release", new TerminalLine($"[Error: {ex.Message}]", TerminalLineKind.Error));
            TerminalService.SetExitCode("release", 1);
        }
    }

