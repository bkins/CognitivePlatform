    // ── Core execution ─────────────────────────────────────────────────────────

    private async Task RunCoreAsync(string workDir, params (string Exe, string Args)[] steps)
    {
        var state = TerminalService.Get("release");
        if (state.IsRunning) return;

        TerminalService.Clear("release");
        TerminalService.MarkRunning("release", true);

        var effectiveWorkDir = workDir;
        if ( ! string.IsNullOrWhiteSpace(effectiveWorkDir) 
         &&  ! Directory.Exists(effectiveWorkDir))
        {
            TerminalService.AppendLine("release"
                                     , new TerminalLine($"[Warning: directory '{effectiveWorkDir}' does not exist — running without a set CWD]"
                                                      , TerminalLineKind.Error));
            effectiveWorkDir = string.Empty;
        }

        int? lastExitCode = null;
        try
        {
            foreach (var (exe, args) in steps)
            {
                TerminalService.AppendLine("release", new TerminalLine($"$ {exe} {args}"));
                TerminalService.AppendLine("release", new TerminalLine(string.Empty));

                var startInfo = new ProcessStartInfo
                {
                    FileName               = exe
                  , Arguments              = args
                  , WorkingDirectory       = effectiveWorkDir
                  , RedirectStandardOutput = true
                  , RedirectStandardError  = true
                  , UseShellExecute        = false
                  , CreateNoWindow         = true
                };

                lastExitCode = await TerminalService.RunProcessAsync("release"
                                                                   , startInfo
                                                                   , (text, isError) => new TerminalLine(text
                                                                                                       , isError 
                                                                                                             ? TerminalLineKind.Error 
                                                                                                             : TerminalLineKind.Normal));

                if (lastExitCode is not 0) break;

                TerminalService.AppendLine("release", new TerminalLine(string.Empty));
            }

            if (lastExitCode is 0)
            {
                var deployedComponents = new List<(string ComponentName, string Location)>();
                foreach (var step in steps)
                {
                    var args = step.Args;
                    if (args.Contains("API-Deploy.ps1"))
                    {
                        var env = _selectedEnvironment;
                        var envDir = DeployStateEnvName(env);
                        deployedComponents.Add(("CognitivePlatform API", $"C:\\CP\\Deploy\\API\\{envDir}"));
                    }
                    else if (args.Contains("Coco-Deploy.ps1"))
                    {
                        var env = _selectedEnvironment;
                        var envDir = DeployStateEnvName(env);
                        deployedComponents.Add(("Coco.API", $"C:\\CP\\Deploy\\Coco\\{envDir}"));
                    }
                    else if (args.Contains("Laa-Deploy.ps1"))
                    {
                        deployedComponents.Add(("Local AI Assistant (Android)", "Target physical Android device via ADB"));
                    }
                    else if (args.Contains("LAA-Windows-Deploy.ps1"))
                    {
                        var env = _selectedEnvironment;
                        var envDir = DeployStateEnvName(env);
                        deployedComponents.Add(("Local AI Assistant (Windows)", $"C:\\CP\\Deploy\\LaaWindows\\{envDir}"));
                    }
                }

                if (deployedComponents.Count > 0)
                {
                    TerminalService.AppendLine("release", new TerminalLine(string.Empty));
                    TerminalService.AppendLine("release", new TerminalLine("==========================================================================", TerminalLineKind.PassSummary));
                    TerminalService.AppendLine("release", new TerminalLine("                      DEPLOYMENT PIPELINE SUMMARY                         ", TerminalLineKind.PassSummary));
                    TerminalService.AppendLine("release", new TerminalLine("==========================================================================", TerminalLineKind.PassSummary));
                    foreach (var (comp, loc) in deployedComponents)
                    {
                        TerminalService.AppendLine("release", new TerminalLine($"   • Deployed: {comp}", TerminalLineKind.PassSummary));
                        TerminalService.AppendLine("release", new TerminalLine($"     Version:  {_version}", TerminalLineKind.PassSummary));
                        TerminalService.AppendLine("release", new TerminalLine($"     Target:   {loc}", TerminalLineKind.PassSummary));
                        TerminalService.AppendLine("release", new TerminalLine(string.Empty));
                    }
                    TerminalService.AppendLine("release", new TerminalLine("==========================================================================", TerminalLineKind.PassSummary));
                    await ScrollToBottomAsync();
                }
            }
        }
        finally
        {
            TerminalService.SetExitCode("release", lastExitCode);
            TerminalService.MarkRunning("release", false);
        }
    }

    private void Abort()       => TerminalService.Abort("release");
    private void ClearOutput() => TerminalService.Clear("release");

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("eval"
                                   , "var el=document.getElementById('terminal-end');if(el)el.scrollIntoView({behavior:'instant'});");
        }
        catch { /* Ignore during disposal or when DOM is not ready */ }
    }

    public ValueTask DisposeAsync()
    {
        TerminalService.StateChanged -= OnTerminalChanged;
        return ValueTask.CompletedTask;
    }
