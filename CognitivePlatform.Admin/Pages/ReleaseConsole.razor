    };

    private static string GenerateVersion()
    {
        var now = DateTime.Now;

        // All four AssemblyVersion components must fit in a UInt16 (0–65535).
        // yyyyMMdd (up to 20991231) and HHmmss (up to 235959) both exceed that limit.
        //
        // Encoding:
        //   build    = (year % 100) * 1000 + dayOfYear   → e.g. 26154 for 2026-Jun-03
        //   revision = hour * 100 + minute               → e.g. 1334  for 13:34
        //
        // Both stay ≤ 65535 and the result is still roughly human-readable.
        var build    = (now.Year % 100) * 1000 + now.DayOfYear;
        var revision = now.Hour * 100 + now.Minute;
        return $"1.0.{build}.{revision}";
    }

    private void RegenerateVersion() => _version = GenerateVersion();

    private static Color EnvButtonColor(string env) => env switch
    {
        "PROD" => Color.Error
      , "QA"   => Color.Warning
      , _      => Color.Success
    };

    private static Color EnvChipColor(string env) => env.ToUpperInvariant() switch
    {
        "PROD" or "PRODUCTION" => Color.Error
      , "QA"                   => Color.Warning
      , _                      => Color.Success
    };

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        TerminalService.StateChanged += OnTerminalChanged;
        _workingDirectory = Configuration["ReleaseConsole:WorkingDirectory"] ?? string.Empty;
        LoadArtifacts();
        LoadDeploymentState();
        LoadAuditLog();
    }

    private void OnTerminalChanged(string id)
    {
        if (id != "release") return;
        try { _ = InvokeAsync(async () => { StateHasChanged(); await ScrollToBottomAsync(); }); }
        catch { /* component disposed */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var savedCwd = await Js.InvokeAsync<string?>("localStorage.getItem"
                                                    , "releaseConsole:workingDirectory");
        if (!string.IsNullOrWhiteSpace(savedCwd))
            _workingDirectory = savedCwd;

        var savedGit = await Js.InvokeAsync<string?>("localStorage.getItem"
                                                    , "releaseConsole:gitDirectory");
        if (!string.IsNullOrWhiteSpace(savedGit))
            _gitDirectory = savedGit;

        StateHasChanged();
    }

    private Task ReloadPanelsAsync()
    {
        LoadArtifacts();
        LoadDeploymentState();
        LoadAuditLog();
        return Task.CompletedTask;
    }

    // ── Directory persistence ──────────────────────────────────────────────────

    private async Task SaveWorkingDirectoryAsync(string value)
    {
        _workingDirectory = value;
        _workDirWarning   = ValidateDirectory(value);
        await Js.InvokeVoidAsync("localStorage.setItem"
                               , "releaseConsole:workingDirectory"
                               , value);
    }

    private async Task SaveGitDirectoryAsync(string value)
    {
        _gitDirectory  = value;
        _gitDirWarning = ValidateDirectory(value);
        await Js.InvokeVoidAsync("localStorage.setItem"
                               , "releaseConsole:gitDirectory"
                               , value);
    }

    private static string? ValidateDirectory(string? path)
        => !string.IsNullOrWhiteSpace(path) && !Directory.Exists(path)
               ? $"Directory not found: {path}"
               : null;

    // ── Panel data loading ─────────────────────────────────────────────────────

    private void LoadArtifacts()
    {
        _artifacts.Clear();
        if (!Directory.Exists(ArtifactsRoot)) return;

        foreach (var compDir in Directory.GetDirectories(ArtifactsRoot))
        {
            var component = Path.GetFileName(compDir);

            foreach (var versionDir in Directory.GetDirectories(compDir)
                                                .OrderByDescending(Path.GetFileName))
            {
                ArtifactMeta? meta = null;
                var metaFile = Path.Combine(versionDir, "metadata.json");
                if (File.Exists(metaFile))
                {
                    try { meta = JsonSerializer.Deserialize<ArtifactMeta>(File.ReadAllText(metaFile), JsonOpts); }
                    catch { /* skip malformed metadata */ }
                }

                var zipPath = Path.Combine(versionDir, $"{component}.zip");
                _artifacts.Add(new ArtifactEntry(
                    Component : component
                  , Version   : Path.GetFileName(versionDir)
                  , Directory : versionDir
                  , ZipPath   : File.Exists(zipPath) ? zipPath : null
                  , Meta      : meta));
            }
        }
    }

    private void LoadDeploymentState()
    {
        _deployments.Clear();
        if (!File.Exists(DeploymentStatePath)) return;

        try
        {
            var dict = JsonSerializer.Deserialize<Dictionary<string, DeployStateEntry>>(
                           File.ReadAllText(DeploymentStatePath), JsonOpts);
            if (dict is null) return;

            _deployments = [..dict.Values
                                  .OrderBy(d => d.Environment)
                                  .ThenBy(d => d.ComponentName)];
        }
        catch { /* ignore parse errors */ }
    }

    private void LoadAuditLog()
    {
        _auditEntries.Clear();
        if (!File.Exists(AuditLogPath)) return;

        try
        {
            // Read last 30 lines (newest first in the file = append order)
            var lines = File.ReadAllLines(AuditLogPath)
                            .Reverse()
                            .Where(l => !string.IsNullOrWhiteSpace(l))
                            .Take(30);

            foreach (var line in lines)
            {
                try
                {
                    var entry = JsonSerializer.Deserialize<AuditLogEntry>(line, JsonOpts);
                    if (entry is not null) _auditEntries.Add(entry);
                }
                catch { /* skip malformed lines */ }
            }
        }
        catch { /* ignore file errors */ }
    }

