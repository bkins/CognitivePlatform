    // ── Deploy from artifact store ─────────────────────────────────────────────

    private async Task DeployArtifactAsync(ArtifactEntry artifact, string environment)
    {
        if (artifact.ZipPath is null || !File.Exists(artifact.ZipPath))
        {
            _output.Clear();
            _output.Add(new($"[Error: zip not found — {artifact.ZipPath}]", IsError: true));
            StateHasChanged();
            return;
        }

        var tempDir = Path.Combine(Path.GetTempPath(), $"cp-deploy-{Guid.NewGuid():N}");
        try
        {
            Directory.CreateDirectory(tempDir);
            ZipFile.ExtractToDirectory(artifact.ZipPath, tempDir);

            await RunCoreAsync(tempDir
                             , ( PwshExe, $@"-NonInteractive -File ""{ScriptsDir}\API-Deploy.ps1"" -Environment {environment} -SourcePath ""{tempDir}"" -Version {artifact.Version}" ));
        }
        finally
        {
            try { Directory.Delete(tempDir, recursive: true); }
            catch { /* ignore cleanup failure */ }

            // Refresh deployment state so the table reflects the new deploy
            LoadDeploymentState();
            LoadAuditLog();
            StateHasChanged();
        }
    }

