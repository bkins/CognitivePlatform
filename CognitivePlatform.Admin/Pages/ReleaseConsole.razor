    // ── Execution helpers ──────────────────────────────────────────────────────

    private Task RunAsync(string exe, string args)
        => RunCoreAsync(_workingDirectory, ( exe, args ));

    private Task RunInGitRepoAsync(string exe, string args)
        => RunCoreAsync(_gitDirectory, ( exe, args ));

    // ── Core execution ─────────────────────────────────────────────────────────

    private async Task RunCoreAsync(string workDir, params (string Exe, string Args)[] steps)
    {
        if (_running) return;

        _running  = true;
        _exitCode = null;
        _runError = null;

        _output.Clear();

        _cts = new CancellationTokenSource();

        StateHasChanged();

        var effectiveWorkDir = workDir;
        if (!string.IsNullOrWhiteSpace(effectiveWorkDir) && !Directory.Exists(effectiveWorkDir))
        {
            _output.Add(new($"[Warning: directory '{effectiveWorkDir}' does not exist — running without a set CWD]"
                          , IsError: true));
            effectiveWorkDir = string.Empty;
        }

        try
        {
            foreach (var (exe, args) in steps)
            {
                _output.Add(new($"$ {exe} {args}", false));
                _output.Add(new(string.Empty, false));

                await InvokeAsync(StateHasChanged);
                await ScrollToBottomAsync();

                var startInfo = new ProcessStartInfo
                {
                    FileName               = exe
                  , Arguments              = args
                  , WorkingDirectory       = effectiveWorkDir
                  , RedirectStandardOutput = true
                  , RedirectStandardError  = true
                  , UseShellExecute        = false
                  , CreateNoWindow         = true
                };

                _process = new Process { StartInfo = startInfo };

                _process.OutputDataReceived += async (_, eventArgs) =>
                {
                    if (eventArgs.Data is null) return;
                    _output.Add(new(eventArgs.Data, false));
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottomAsync();
                };

                _process.ErrorDataReceived += async (_, eventArgs) =>
                {
                    if (eventArgs.Data is null) return;
                    _output.Add(new(eventArgs.Data, true));
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottomAsync();
                };

                var stepAborted = false;
                try
                {
                    _process.Start();
                    _process.BeginOutputReadLine();
                    _process.BeginErrorReadLine();

                    await _process.WaitForExitAsync(_cts.Token);

                    _exitCode = _process.ExitCode;
                }
                catch (OperationCanceledException)
                {
                    _output.Add(new("[Aborted by user]", true));
                    stepAborted = true;
                }
                catch (Exception ex)
                {
                    _runError = ex.Message;
                    _output.Add(new($"[Error: {ex.Message}]", true));
                    stepAborted = true;
                }
                finally
                {
                    _process?.Dispose();
                    _process = null;
                }

                if (stepAborted
                 || _exitCode != 0) break;

                _output.Add(new(string.Empty, false));
            }
        }
        finally
        {
            _running = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync();
        }
    }

    private void Abort()
    {
        _cts?.Cancel();
        try { _process?.Kill(entireProcessTree: true); }
        catch { /* process may have already exited */ }
    }

    private void ClearOutput()
    {
        _output.Clear();
        _exitCode = null;
        _runError = null;
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("eval"
                                   , "var el=document.getElementById('terminal-end');if(el)el.scrollIntoView({behavior:'instant'});");
        }
        catch { /* Ignore during disposal or when DOM is not ready */ }
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        try { _process?.Kill(entireProcessTree: true); }
        catch { /* ignore */ }
        _process?.Dispose();
    }
