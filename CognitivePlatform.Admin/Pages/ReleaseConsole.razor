    private async Task StartBackgroundProcessAsync(string exePath, string processName, string workDir)
    {
        _output.Clear();
        _exitCode = null;
        _runError = null;
        await InvokeAsync(StateHasChanged);

        if (!File.Exists(exePath))
        {
            _output.Add(new($"[Error: executable not found — {exePath}]", IsError: true));
            _exitCode = 1;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var already = Process.GetProcessesByName(processName);
        if (already.Length > 0)
        {
            _output.Add(new($"[{processName} is already running — PID {already[0].Id}]", IsError: false));
            _exitCode = 0;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _output.Add(new($"$ {exePath}", false));
        _output.Add(new(string.Empty, false));
        await InvokeAsync(StateHasChanged);

        Process? proc = null;
        try
        {
            // Redirect output so startup logs (and crash traces) are captured in the
            // terminal here rather than disappearing in a closing console window.
            var startInfo = new ProcessStartInfo
            {
                FileName               = exePath
              , WorkingDirectory       = workDir
              , UseShellExecute        = false
              , CreateNoWindow         = true
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
            };

            proc = new Process { StartInfo = startInfo };

            proc.OutputDataReceived += async (_, e) =>
            {
                if (e.Data is null) return;
                _output.Add(new(e.Data, false));
                try { await InvokeAsync(StateHasChanged); await ScrollToBottomAsync(); }
                catch { /* component may have been disposed */ }
            };

            proc.ErrorDataReceived += async (_, e) =>
            {
                if (e.Data is null) return;
                _output.Add(new(e.Data, true));
                try { await InvokeAsync(StateHasChanged); await ScrollToBottomAsync(); }
                catch { /* component may have been disposed */ }
            };

            proc.Start();
            proc.BeginOutputReadLine();
            proc.BeginErrorReadLine();

            var pid = proc.Id;
            _output.Add(new($"[PID {pid} — waiting 2 s for startup…]", false));
            await InvokeAsync(StateHasChanged);

            // Wait long enough for the process to bind ports or crash
            await Task.Delay(2000);

            if (proc.HasExited)
            {
                _output.Add(new($"[Process exited with code {proc.ExitCode} — see output above for the crash details.]"
                              , IsError: true));
                _exitCode = proc.ExitCode == 0 ? 1 : proc.ExitCode;
                proc.Dispose();
                proc = null;
            }
            else
            {
                // Stop capturing — we only needed startup output; the process runs on
                try { proc.CancelOutputRead(); } catch { /* ignore */ }
                try { proc.CancelErrorRead();  } catch { /* ignore */ }
                _output.Add(new(string.Empty, false));
                _output.Add(new($"[Running — PID {pid}. Output above is from the startup window only.]", false));
                _exitCode = 0;
                proc = null; // detach — keep running
            }
        }
        catch (Exception ex)
        {
            _runError = ex.Message;
            _output.Add(new($"[Error: {ex.Message}]", IsError: true));
            _exitCode = 1;
            proc?.Dispose();
            proc = null;
        }

        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();
    }

