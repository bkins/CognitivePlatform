    // ── Deploy from artifact store ─────────────────────────────────────────────

    private async Task DeployArtifactAsync(ArtifactEntry artifact, string environment)
    {
        if (artifact.ZipPath is null || !File.Exists(artifact.ZipPath))
        {
            TerminalService.Clear("release");
            TerminalService.AppendLine("release", new TerminalLine($"[Error: zip not found — {artifact.ZipPath}]", TerminalLineKind.Error));
            return;
        }

        var tempDir = Path.Combine(Path.GetTempPath(), $"cp-deploy-{Guid.NewGuid():N}");
        try
        {
            Directory.CreateDirectory(tempDir);
            ZipFile.ExtractToDirectory(artifact.ZipPath, tempDir);

            await RunCoreAsync(tempDir
                             , ( PwshExe, $@"-NonInteractive -ExecutionPolicy Bypass -File ""{ScriptsDir}\API-Deploy.ps1"" -Environment {environment} -SourcePath ""{tempDir}"" -Version {artifact.Version}" ));
        }
        finally
        {
            try { Directory.Delete(tempDir, recursive: true); }
            catch { /* ignore cleanup failure */ }

            // Refresh deployment state so the table reflects the new deploy
            if (TerminalService.Get("release").ExitCode == 0)
                await WriteDeploymentStateAsync(artifact.Component, environment
                                               , apkName: $"CognitivePlatform.Api.{DeployStateEnvName(environment)}.exe"
                                               , appId:   Path.Combine(StagingApiDir, DeployStateEnvName(environment)));
            LoadDeploymentState();
            LoadAuditLog();
            StateHasChanged();
        }
    }

