    // ── Artifact metadata ──────────────────────────────────────────────────────

    /// <summary>
    /// Writes metadata.json into the versioned artifact directory and updates
    /// the top-level metadata.json (latest-build pointer) for the component.
    /// </summary>
    private async Task WriteArtifactMetadataAsync(string componentName, string artifactDir)
    {
        if (!Directory.Exists(artifactDir)) return;

        var gitHash = await GetGitHashAsync();

        var meta = new
        {
            ComponentName  = componentName
          , Version        = _version
          , BuiltFor       = _selectedEnvironment
          , GitCommitHash  = gitHash ?? string.Empty
          , BuildTimestamp = DateTime.UtcNow
          , BuildMachine   = System.Environment.MachineName
          , ConsoleVersion = "2.0.0"
        };

        var opts     = new JsonSerializerOptions { WriteIndented = true };
        var metaJson = JsonSerializer.Serialize(meta, opts);

        // Per-version metadata — read by LoadArtifacts() to populate the Artifact Store panel
        await File.WriteAllTextAsync(Path.Combine(artifactDir, "metadata.json"), metaJson);

        // Top-level metadata — latest-build pointer, one level up from version dir
        var componentDir = Directory.GetParent(artifactDir)?.FullName;
        if (componentDir is not null)
            await File.WriteAllTextAsync(Path.Combine(componentDir, "metadata.json"), metaJson);

        LoadArtifacts();
        await InvokeAsync(StateHasChanged);
    }

    // ── Deployment state ───────────────────────────────────────────────────────

    /// <summary>
    /// Writes (or overwrites) the entry for this component+environment in
    /// deployment-state.json and refreshes the Deployment State panel.
    /// </summary>
    private async Task WriteDeploymentStateAsync( string  componentName
                                                 , string  environment
                                                 , string? apkName = null
                                                 , string? appId   = null )
    {
        var envName = DeployStateEnvName(environment);
        var key     = $"{componentName}_{envName}";

        // Load existing state (create directory if needed)
        Dictionary<string, DeployStateEntry> state;
        if (File.Exists(DeploymentStatePath))
        {
            try
            {
                state = JsonSerializer.Deserialize<Dictionary<string, DeployStateEntry>>(
                            await File.ReadAllTextAsync(DeploymentStatePath), JsonOpts)
                        ?? new Dictionary<string, DeployStateEntry>(StringComparer.Ordinal);
            }
            catch { state = new Dictionary<string, DeployStateEntry>(StringComparer.Ordinal); }
        }
        else
        {
            var stateDir = Path.GetDirectoryName(DeploymentStatePath);
            if (stateDir is not null) Directory.CreateDirectory(stateDir);
            state = new Dictionary<string, DeployStateEntry>(StringComparer.Ordinal);
        }

        state[key] = new DeployStateEntry
        {
            ComponentName = componentName
          , Environment   = envName
          , Version       = _version
          , ApkName       = apkName
          , AppId         = appId
          , DeployedAt    = DateTime.UtcNow
          , DeployedBy    = System.Environment.UserName
        };

        // Write with camelCase to match the existing file format
        var writeOpts = new JsonSerializerOptions
        {
            WriteIndented        = true
          , PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        };
        await File.WriteAllTextAsync(DeploymentStatePath
                                   , JsonSerializer.Serialize(state, writeOpts));

        LoadDeploymentState();
        await InvokeAsync(StateHasChanged);
    }

    private static string DeployStateEnvName(string env) => env switch
    {
        "DEV"  => "Dev"
      , "QA"   => "Qa"
      , "PROD" => "Prod"
      , _      => env
    };

    /// <summary>Returns the current HEAD commit hash from _gitDirectory, or null if unavailable.</summary>
    private async Task<string?> GetGitHashAsync()
    {
        if (string.IsNullOrWhiteSpace(_gitDirectory) || !Directory.Exists(_gitDirectory))
            return null;

        try
        {
            var psi = new ProcessStartInfo
            {
                FileName               = "git"
              , Arguments              = "rev-parse HEAD"
              , WorkingDirectory       = _gitDirectory
              , RedirectStandardOutput = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };
            using var proc = Process.Start(psi);
            if (proc is null) return null;
            var output = await proc.StandardOutput.ReadToEndAsync();
            await proc.WaitForExitAsync();
            return proc.ExitCode == 0 ? output.Trim() : null;
        }
        catch { return null; }
    }

