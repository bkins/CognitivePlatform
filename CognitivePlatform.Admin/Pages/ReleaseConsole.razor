@page "/release"
@using System.Diagnostics
@using System.IO.Compression
@using System.Text.Json
@implements IAsyncDisposable
@inject IConfiguration Configuration
@inject IJSRuntime Js

<PageTitle>Release Console — CP Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Release Console</MudText>
    <MudSpacer />
    @if (_running)
    {
        <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.RunCircle">Running…</MudChip>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Stop"
                   OnClick="@Abort">
            Abort
        </MudButton>
    }
    else if (_exitCode.HasValue)
    {
        @if (_exitCode == 0)
        {
            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Exit 0 — OK</MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Error">Exit @_exitCode — Failed</MudChip>
        }
    }
    <MudTooltip Text="Reload artifact store, deployment state, and audit log">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       OnClick="@ReloadPanelsAsync"
                       Disabled="@_running" />
    </MudTooltip>
</MudStack>

@* ── Working directory (for build/deploy scripts) ── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudTextField Value="_workingDirectory"
                  ValueChanged="@((string val) => SaveWorkingDirectoryAsync(val))"
                  Label="Working directory (build / deploy scripts)"
                  HelperText="CWD for Build, Deploy, NuGet, and Custom commands. Saved in your browser."
                  FullWidth="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Folder" />
    @if (_workDirWarning is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">@_workDirWarning</MudText>
    }
</MudPaper>

@* ── Git repository directory ── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudTextField Value="_gitDirectory"
                  ValueChanged="@((string val) => SaveGitDirectoryAsync(val))"
                  Label="Git repository directory"
                  HelperText="Used exclusively for Git Status / Pull buttons. Saved in your browser."
                  FullWidth="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.FolderOpen" />
    @if (_gitDirWarning is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">@_gitDirWarning</MudText>
    }
</MudPaper>

@* ── Version + Environment ── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="3" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_version"
                      Label="Version"
                      HelperText="Used by Build and Deploy scripts."
                      Style="min-width:220px" />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@_running"
                   OnClick="@RegenerateVersion">
            Regenerate
        </MudButton>
        <MudSpacer />
        <MudText Typo="Typo.body2" Style="line-height:40px;padding-right:4px">Environment:</MudText>
        @foreach (var env in new[] { "DEV", "QA", "PROD" })
        {
            <MudButton Variant="@(_selectedEnvironment == env ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary"
                       Disabled="@_running"
                       OnClick="@(() => _selectedEnvironment = env)">
                @env
            </MudButton>
        }
    </MudStack>
</MudPaper>

@* ── API ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2">API</MudText>
<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Build"
               Disabled="@_running"
               OnClick="@BuildApiAsync">
        Build API
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.Upload"
               Disabled="@_running"
               OnClick="@DeployApiAsync">
        Deploy API → @_selectedEnvironment
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PlayArrow"
               Disabled="@_running"
               OnClick="@BuildAndDeployApiAsync">
        Build + Deploy API → @_selectedEnvironment
    </MudButton>
</MudStack>

@* ── LAA Android ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2">Local AI Assistant (Android)</MudText>
<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Build"
               Disabled="@_running"
               OnClick="@BuildLaaAsync">
        Build LAA
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.PhoneAndroid"
               Disabled="@_running"
               OnClick="@DeployLaaAsync">
        Deploy LAA → @_selectedEnvironment
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PlayArrow"
               Disabled="@_running"
               OnClick="@BuildAndDeployLaaAsync">
        Build + Deploy LAA → @_selectedEnvironment
    </MudButton>
</MudStack>

@* ── LAA Windows ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2">Local AI Assistant (Windows)</MudText>
<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Build"
               Disabled="@_running"
               OnClick="@BuildLaaWindowsAsync">
        Build LAA Windows
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.Computer"
               Disabled="@_running"
               OnClick="@DeployLaaWindowsAsync">
        Deploy LAA Windows → @_selectedEnvironment
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PlayArrow"
               Disabled="@_running"
               OnClick="@BuildAndDeployLaaWindowsAsync">
        Build + Deploy LAA Windows → @_selectedEnvironment
    </MudButton>
</MudStack>

@* ── NuGet ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2">NuGet Packages (local feed)</MudText>
<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Inventory"
               Disabled="@_running"
               OnClick="@PublishNuGetsAsync">
        Publish All NuGets
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Inventory"
               Disabled="@_running"
               OnClick="@PublishNuGetPrimitivesAsync">
        Publish Primitives
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Inventory"
               Disabled="@_running"
               OnClick="@PublishNuGetCoreAsync">
        Publish Core
    </MudButton>
</MudStack>

@* ── Git + Tests ── *@
<MudText Typo="Typo.subtitle2" Class="mb-2">Git &amp; Tests</MudText>
<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4">
    <MudButton Variant="Variant.Outlined"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Info"
               Disabled="@_running"
               OnClick="@(() => RunInGitRepoAsync("git", "status"))">
        Git Status
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Download"
               Disabled="@_running"
               OnClick="@(() => RunInGitRepoAsync("git", "pull"))">
        Git Pull
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Science"
               Disabled="@_running"
               OnClick="@(() => RunCoreAsync(CpRepoRoot, ("dotnet", $@"test ""{CpRepoRoot}\src\CognitivePlatform.Tests\CognitivePlatform.Tests.csproj""")))">
        Run Tests
    </MudButton>
</MudStack>

@* ═══════════════════════════════════════════════════════════════════════════
   INFO PANELS  (Artifact Store · Deployment State · Audit Log · DB Actions)
   ═══════════════════════════════════════════════════════════════════════════ *@
<MudExpansionPanels MultiExpansion="true" Class="mb-4">

    @* ── Artifact Store ── *@
    <MudExpansionPanel @bind-IsExpanded="_artifactsExpanded"
                       Text="Artifact Store"
                       Icon="@Icons.Material.Filled.Inventory2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family:monospace">
                @ArtifactsRoot
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           OnClick="@LoadArtifacts" />
        </MudStack>

        @if (!Directory.Exists(ArtifactsRoot))
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Artifact root not found: @ArtifactsRoot
            </MudAlert>
        }
        else if (_artifacts.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No artifacts found.</MudText>
        }
        else
        {
            @foreach (var group in _artifacts.GroupBy(artifact => artifact.Component)
                                             .OrderBy(group => group.Key))
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">@group.Key</MudText>
                <MudDataGrid Items="@group.AsEnumerable()"
                             Dense="true"
                             Hover="true"
                             SortMode="SortMode.None"
                             Elevation="1">
                    <Columns>
                        <PropertyColumn Property="@(a => a.Version)" Title="Version" />
                        <TemplateColumn Title="Built">
                            <CellTemplate>
                                <MudText Typo="Typo.caption" Style="white-space:nowrap">
                                    @AdminDateFormat.Short(context.Item.Meta?.BuildTimestamp)
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Env">
                            <CellTemplate>
                                <MudText Typo="Typo.caption">@(context.Item.Meta?.BuiltFor ?? "—")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Commit">
                            <CellTemplate>
                                @{
                                    var hash = context.Item.Meta?.GitCommitHash;
                                    var shortHash = hash?.Length > 7 ? hash[..7] : hash;
                                }
                                <MudText Typo="Typo.caption" Style="font-family:monospace">@(shortHash ?? "—")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Deploy to environment" SortBy="@(_ => string.Empty)">
                            <CellTemplate>
                                @if (context.Item.CanDeployFromArtifact)
                                {
                                    <MudStack Row="true" Spacing="1">
                                        @foreach (var env in new[] { "DEV", "QA", "PROD" })
                                        {
                                            var capturedEnv     = env;
                                            var capturedArtifact = context.Item;
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Outlined"
                                                       Color="@EnvButtonColor(capturedEnv)"
                                                       Disabled="@_running"
                                                       OnClick="@(() => DeployArtifactAsync(capturedArtifact, capturedEnv))">
                                                @capturedEnv
                                            </MudButton>
                                        }
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Deploy via ReleaseConsole
                                    </MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            }
        }
    </MudExpansionPanel>

    @* ── Deployment State ── *@
    <MudExpansionPanel @bind-IsExpanded="_stateExpanded"
                       Text="Deployment State"
                       Icon="@Icons.Material.Filled.Dashboard">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family:monospace">
                @DeploymentStatePath
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           OnClick="@LoadDeploymentState" />
        </MudStack>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            This state is written by the ReleaseConsole PowerShell deploy scripts and reflects
            the last recorded deployment. It may be stale if deployments were made outside this console.
        </MudAlert>

        @if (!File.Exists(DeploymentStatePath))
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No deployment state file found — run a deployment from ReleaseConsole to create it.
            </MudAlert>
        }
        else if (_deployments.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No deployment entries.</MudText>
        }
        else
        {
            <MudDataGrid Items="@_deployments"
                         Dense="true"
                         Hover="true"
                         SortMode="SortMode.Single"
                         Elevation="1">
                <Columns>
                    <PropertyColumn Property="@(d => d.ComponentName)" Title="Component" />
                    <TemplateColumn Title="Environment" SortBy="@(d => d.Environment)">
                        <CellTemplate>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="@EnvChipColor(context.Item.Environment)">
                                @context.Item.Environment
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="@(d => d.Version)" Title="Version" />
                    <TemplateColumn Title="Deployed">
                        <CellTemplate>
                            <MudText Typo="Typo.caption" Style="white-space:nowrap">
                                @AdminDateFormat.Short(context.Item.DeployedAt)
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="@(d => d.DeployedBy)" Title="By" />
                </Columns>
            </MudDataGrid>
        }
    </MudExpansionPanel>

    @* ── Audit Log ── *@
    <MudExpansionPanel @bind-IsExpanded="_auditExpanded"
                       Text="Audit Log (last 30)"
                       Icon="@Icons.Material.Filled.History">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family:monospace">
                @AuditLogPath
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           OnClick="@LoadAuditLog" />
        </MudStack>

        @if (!File.Exists(AuditLogPath))
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No audit log found — run a build or deployment from ReleaseConsole to create it.
            </MudAlert>
        }
        else if (_auditEntries.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No audit entries.</MudText>
        }
        else
        {
            <MudDataGrid Items="@_auditEntries"
                         Dense="true"
                         Hover="true"
                         SortMode="SortMode.None"
                         Elevation="1">
                <Columns>
                    <TemplateColumn Title="Time">
                        <CellTemplate>
                            <MudText Typo="Typo.caption" Style="white-space:nowrap">
                                @AdminDateFormat.Short(context.Item.Timestamp)
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Cmd" SortBy="@(e => e.Command)">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @context.Item.Command
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="@(e => e.Component)"  Title="Component" />
                    <PropertyColumn Property="@(e => e.Environment)" Title="Env" />
                    <TemplateColumn Title="✓">
                        <CellTemplate>
                            @if (context.Item.Success)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Color="Color.Success"
                                         Size="Size.Small" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Error"
                                         Color="Color.Error"
                                         Size="Size.Small" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Details">
                        <CellTemplate>
                            <MudText Typo="Typo.caption"
                                     Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:340px"
                                     Color="@(context.Item.Success ? Color.Default : Color.Error)">
                                @(context.Item.ErrorMessage ?? context.Item.Details)
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </MudExpansionPanel>

    @* ── Start Deployed Apps ── *@
    <MudExpansionPanel Text="Start Deployed Apps"
                       Icon="@Icons.Material.Filled.PlayCircle">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            Launches the deployed executable for the selected environment.
            Checks whether the process is already running before starting.
            Output is not captured — the process runs in the background.
        </MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Style="min-width:80px">API:</MudText>
            @foreach (var env in new[] { "DEV", "QA", "PROD" })
            {
                var capturedEnv = env;
                <MudButton Variant="Variant.Outlined"
                           Color="@EnvButtonColor(capturedEnv)"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@_running"
                           OnClick="@(() => StartApiAsync(capturedEnv))">
                    @capturedEnv
                </MudButton>
            }
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Style="min-width:80px">LAA Windows:</MudText>
            @foreach (var env in new[] { "DEV", "QA", "PROD" })
            {
                var capturedEnv = env;
                <MudButton Variant="Variant.Outlined"
                           Color="@EnvButtonColor(capturedEnv)"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Computer"
                           Disabled="@_running"
                           OnClick="@(() => StartLaaWindowsAsync(capturedEnv))">
                    @capturedEnv
                </MudButton>
            }
        </MudStack>
    </MudExpansionPanel>

    @* ── Database Actions ── *@
    <MudExpansionPanel Text="Database Actions"
                       Icon="@Icons.Material.Filled.Storage">
        <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
            <MudCard Elevation="1" Style="max-width:340px">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2">Swap Prod → Dev</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        Copies <code>C:\CP\Data\Prod\platform.db</code> to dev, then resets
                        the workspace to <em>"personal"</em> so all production rows are visible
                        in the dev environment. Backs up the existing dev DB first.
                        Requires the API to be stopped.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.SwapHoriz"
                               Disabled="@_running"
                               OnClick="@SwapDbAsync">
                        Swap DB
                    </MudButton>
                </MudCardActions>
            </MudCard>

            <MudCard Elevation="1" Style="max-width:340px">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2">Restore Dev DB</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        Restores the most recent dev backup created by a previous Swap operation
                        (<code>platform.dev.backup-*.db</code>).
                        Requires the API to be stopped.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Restore"
                               Disabled="@_running"
                               OnClick="@RestoreDbAsync">
                        Restore Dev DB
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudStack>
    </MudExpansionPanel>

</MudExpansionPanels>

@* ── Custom command ── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Custom Command</MudText>
    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_customExe"
                      Label="Executable"
                      Placeholder="dotnet, git, pwsh …"
                      Style="min-width:120px" />
        <MudTextField @bind-Value="_customArgs"
                      Label="Arguments"
                      Placeholder="build, status, -File script.ps1 …"
                      Style="min-width:300px" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="@(string.IsNullOrWhiteSpace(_customExe) || _running)"
                   OnClick="@RunCustomAsync">
            Run
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Clear"
                   Disabled="@_running"
                   OnClick="@ClearOutput">
            Clear
        </MudButton>
    </MudStack>
</MudPaper>

@* ── Terminal output ── *@
@if (_runError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2">Failed to start process: @_runError</MudAlert>
}

<MudPaper Elevation="4"
          Style="background:#1e1e1e;padding:16px;height:500px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:0.83rem;">
    @if (_output.Count == 0)
    {
        <span style="color:#6b7280;font-style:italic">Run a command to see output here…</span>
    }
    else
    {
        @foreach (var line in _output)
        {
            <div style="color:@(line.IsError ? "#ff6b6b" : "#d4d4d4");white-space:pre-wrap;line-height:1.55">@line.Text</div>
        }
    }
    <div id="terminal-end"></div>
</MudPaper>

@code {
    // ── Record types ───────────────────────────────────────────────────────────

    private sealed record OutputLine(string Text, bool IsError);

    private sealed record ArtifactEntry(
        string        Component
      , string        Version
      , string        Directory
      , string?       ZipPath
      , ArtifactMeta? Meta)
    {
        // API artifacts have a single zip; LAA artifacts are env-specific APK subdirs
        public bool CanDeployFromArtifact => ZipPath is not null && File.Exists(ZipPath);
    }

    private sealed record ArtifactMeta
    {
        public string?   ComponentName  { get; init; }
        public string?   Version        { get; init; }
        public string?   BuiltFor       { get; init; }
        public string?   GitCommitHash  { get; init; }
        public DateTime? BuildTimestamp { get; init; }
        public string?   BuildMachine   { get; init; }
        public string?   ConsoleVersion { get; init; }
    }

    private sealed record DeployStateEntry
    {
        public string    ComponentName { get; init; } = string.Empty;
        public string    Environment   { get; init; } = string.Empty;
        public string    Version       { get; init; } = string.Empty;
        public string?   ApkName       { get; init; }
        public string?   AppId         { get; init; }
        public DateTime? DeployedAt    { get; init; }
        public string?   DeployedBy    { get; init; }
    }

    private sealed record AuditLogEntry
    {
        public DateTime Timestamp    { get; init; }
        public string   Command      { get; init; } = string.Empty;
        public string   Component    { get; init; } = string.Empty;
        public string?  Environment  { get; init; }
        public string   User         { get; init; } = string.Empty;
        public string   Details      { get; init; } = string.Empty;
        public bool     Success      { get; init; }
        public string?  ErrorMessage { get; init; }
    }

    // ── Static paths ───────────────────────────────────────────────────────────

    private static readonly string ScriptsDir           = @"C:\Users\benho\source\repos\ReleaseConsole\ReleaseConsole\Scripts";
    private static readonly string CpRepoRoot           = @"C:\Users\benho\source\repos\CognitivePlatform";
