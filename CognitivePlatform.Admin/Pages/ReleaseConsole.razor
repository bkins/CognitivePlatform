    private async Task StartBackgroundProcessAsync( string                       exePath
                                                   , string                       processName
                                                   , string                       workDir
                                                   , Dictionary<string, string>?  envVars = null)
    {
        TerminalService.Clear("release");

        if (!File.Exists(exePath))
        {
            TerminalService.AppendLine("release", new TerminalLine($"[Error: executable not found — {exePath}]", TerminalLineKind.Error));
            TerminalService.SetExitCode("release", 1);
            return;
        }

        var already = Process.GetProcessesByName(processName);
        if (already.Length > 0)
        {
            TerminalService.AppendLine("release", new TerminalLine($"[{processName} is already running — PID {already[0].Id}]"));
            TerminalService.SetExitCode("release", 0);
            return;
        }

        TerminalService.AppendLine("release", new TerminalLine($"$ {exePath}"));
        TerminalService.AppendLine("release", new TerminalLine(string.Empty));

        Process? proc = null;
        try
        {
            var startInfo = new ProcessStartInfo
            {
                FileName               = exePath
              , WorkingDirectory       = workDir
              , UseShellExecute        = false
              , CreateNoWindow         = true
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
            };

            if (envVars is not null)
            {
                foreach (var (key, value) in envVars)
                    startInfo.EnvironmentVariables[key] = value;
            }

            proc = new Process { StartInfo = startInfo };

            proc.OutputDataReceived += (_, e) =>
            {
                if (e.Data is null) return;
                TerminalService.AppendLine("release", new TerminalLine(e.Data));
            };

            proc.ErrorDataReceived += (_, e) =>
            {
                if (e.Data is null) return;
                TerminalService.AppendLine("release", new TerminalLine(e.Data, TerminalLineKind.Error));
            };

            proc.Start();
            proc.BeginOutputReadLine();
            proc.BeginErrorReadLine();

            var pid = proc.Id;
            TerminalService.AppendLine("release", new TerminalLine($"[PID {pid} — waiting 2 s for startup…]"));

            await Task.Delay(2000);

            if (proc.HasExited)
            {
                TerminalService.AppendLine("release", new TerminalLine(
                    $"[Process exited with code {proc.ExitCode} — see output above for the crash details.]"
                  , TerminalLineKind.Error));
                TerminalService.SetExitCode("release", proc.ExitCode == 0 ? 1 : proc.ExitCode);
                proc.Dispose();
                proc = null;
            }
            else
            {
                try { proc.CancelOutputRead(); } catch { /* ignore */ }
                try { proc.CancelErrorRead();  } catch { /* ignore */ }
                TerminalService.AppendLine("release", new TerminalLine(string.Empty));
                TerminalService.AppendLine("release", new TerminalLine($"[Running — PID {pid}. Output above is from the startup window only.]"));
                TerminalService.SetExitCode("release", 0);
                proc = null; // detach — keep running
            }
        }
        catch (Exception ex)
        {
            TerminalService.SetError("release", ex.Message);
            TerminalService.AppendLine("release", new TerminalLine($"[Error: {ex.Message}]", TerminalLineKind.Error));
            TerminalService.SetExitCode("release", 1);
            proc?.Dispose();
            proc = null;
        }
    }

