    // ── Panel data loading ─────────────────────────────────────────────────────

    private void LoadArtifacts()
    {
        _artifacts.Clear();
        if (!Directory.Exists(ArtifactsRoot)) return;

        foreach (var compDir in Directory.GetDirectories(ArtifactsRoot))
        {
            var component = Path.GetFileName(compDir);

            foreach (var versionDir in Directory.GetDirectories(compDir)
                                                .OrderByDescending(Path.GetFileName))
            {
                ArtifactMeta? meta = null;
                var metaFile = Path.Combine(versionDir, "metadata.json");
                if (File.Exists(metaFile))
                {
                    try { meta = JsonSerializer.Deserialize<ArtifactMeta>(File.ReadAllText(metaFile), JsonOpts); }
                    catch { /* skip malformed metadata */ }
                }

                var zipPath = Path.Combine(versionDir, $"{component}.zip");
                _artifacts.Add(new ArtifactEntry(
                    Component : component
                  , Version   : Path.GetFileName(versionDir)
                  , Directory : versionDir
                  , ZipPath   : File.Exists(zipPath) ? zipPath : null
                  , Meta      : meta));
            }
        }
    }

    private void LoadDeploymentState()
    {
        _deployments.Clear();
        if (!File.Exists(DeploymentStatePath)) return;

        try
        {
            var dict = JsonSerializer.Deserialize<Dictionary<string, DeployStateEntry>>(
                           File.ReadAllText(DeploymentStatePath), JsonOpts);
            if (dict is null) return;

            _deployments = [..dict.Values
                                  .OrderBy(d => d.Environment)
                                  .ThenBy(d => d.ComponentName)];
        }
        catch { /* ignore parse errors */ }
    }

    private void LoadAuditLog()
    {
        _auditEntries.Clear();
        if (!File.Exists(AuditLogPath)) return;

        try
        {
            // Read last 30 lines (newest first in the file = append order)
            var lines = File.ReadAllLines(AuditLogPath)
                            .Reverse()
                            .Where(l => !string.IsNullOrWhiteSpace(l))
                            .Take(30);

            foreach (var line in lines)
            {
                try
                {
                    var entry = JsonSerializer.Deserialize<AuditLogEntry>(line, JsonOpts);
                    if (entry is not null) _auditEntries.Add(entry);
                }
                catch { /* skip malformed lines */ }
            }
        }
        catch { /* ignore file errors */ }
    }

