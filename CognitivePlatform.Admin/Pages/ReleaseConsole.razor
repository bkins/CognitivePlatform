    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var savedCwd = await Js.InvokeAsync<string?>("localStorage.getItem"
                                                    , "releaseConsole:workingDirectory");
        if (!string.IsNullOrWhiteSpace(savedCwd))
            _workingDirectory = savedCwd;

        var savedGit = await Js.InvokeAsync<string?>("localStorage.getItem"
                                                    , "releaseConsole:gitDirectory");
        if (!string.IsNullOrWhiteSpace(savedGit))
            _gitDirectory = savedGit;

        StateHasChanged();
    }

