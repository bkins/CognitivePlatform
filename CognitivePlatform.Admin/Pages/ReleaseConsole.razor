@code {
    // ── Record types ───────────────────────────────────────────────────────────

    private sealed record ArtifactEntry( string        Component
                                       , string        Version
                                       , string        Directory
                                       , string?       ZipPath
                                       , ArtifactMeta? Meta)
    {
        // API artifacts have a single zip; LAA artifacts are env-specific APK subdirs
        public bool CanDeployFromArtifact => ZipPath is not null && File.Exists(ZipPath);
    }

    private sealed record ArtifactMeta
    {
        public string?   ComponentName  { get; init; }
        public string?   Version        { get; init; }
        public string?   BuiltFor       { get; init; }
        public string?   GitCommitHash  { get; init; }
        public DateTime? BuildTimestamp { get; init; }
        public string?   BuildMachine   { get; init; }
        public string?   ConsoleVersion { get; init; }
    }

    private sealed record DeployStateEntry
    {
        public string    ComponentName { get; init; } = string.Empty;
        public string    Environment   { get; init; } = string.Empty;
        public string    Version       { get; init; } = string.Empty;
        public string?   ApkName       { get; init; }
        public string?   AppId         { get; init; }
        public DateTime? DeployedAt    { get; init; }
        public string?   DeployedBy    { get; init; }
    }

    private sealed record AuditLogEntry
    {
        public DateTime Timestamp    { get; init; }
        public string   Command      { get; init; } = string.Empty;
        public string   Component    { get; init; } = string.Empty;
        public string?  Environment  { get; init; }
        public string   User         { get; init; } = string.Empty;
        public string   Details      { get; init; } = string.Empty;
        public bool     Success      { get; init; }
        public string?  ErrorMessage { get; init; }
    }

    // ── Static paths ───────────────────────────────────────────────────────────

    private static readonly string ScriptsDir           = @"C:\Users\benho\source\repos\ReleaseConsole\ReleaseConsole\Scripts";
    private static readonly string CpRepoRoot           = @"C:\Users\benho\source\repos\CognitivePlatform";
    private static readonly string StagingApiDir        = @"C:\CP\Deploy\Api";
    private static readonly string StagingLaaDir        = @"C:\CP\Deploy\Laa";
    private static readonly string StagingLaaWindowsDir = @"C:\CP\Deploy\LaaWindows";
    private static readonly string StagingCocoDir        = @"C:\CP\Deploy\Coco";
    private static readonly string ArtifactsRoot        = @"C:\CP\Artifacts";

    private static readonly string PwshExe = ResolvePwsh();

    private static string ResolvePwsh()
    {
        // 1. Well-known PowerShell 7 install paths (MSI / system-wide)
        string[] hardcoded =
        [
            @"C:\Program Files\PowerShell\7\pwsh.exe"
          , @"C:\Program Files\PowerShell\pwsh.exe"
          , Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.LocalApplicationData)
                       , @"Microsoft\WindowsApps\pwsh.exe")
        ];
        foreach (var path in hardcoded)
        {
            if (File.Exists(path)) return path;
        }

        // 2. Walk every directory in the current process PATH.
        //    Handles Store installs, winget installs, and non-standard locations.
        var pathVar = System.Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
        foreach (var dir in pathVar.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            try
            {
                var candidate = Path.Combine(dir.Trim(), "pwsh.exe");
                if (File.Exists(candidate)) return candidate;
            }
            catch { /* skip inaccessible or malformed entries */ }
        }

        // 3. PowerShell 7 not found — fall back to Windows PowerShell 5.1 which is
        //    always present on Windows and handles the same -NonInteractive -ExecutionPolicy Bypass -File syntax.
        const string ps51 = @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe";
        if (File.Exists(ps51)) return ps51;

        return "powershell"; // guaranteed to exist on any Windows machine
    }

    private static readonly string DeploymentStatePath =
        Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.LocalApplicationData)
                   , "ReleaseConsole", "deployment-state.json");

    private static readonly string AuditLogPath =
