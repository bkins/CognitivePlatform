    private void ToggleDoneColumn() => _isDoneColumnCollapsed = !_isDoneColumnCollapsed;

    private IReadOnlyList<BacklogStoryDto> VisibleStories
    {
        get
        {
            if (_board is null) return Array.Empty<BacklogStoryDto>();
            var stories = _board.Stories.Where(MatchesFilters);
            return _sortMode switch
            {
                "priority"      => stories.OrderBy(story => story.Priority).ThenBy(story => story.Title).ToList(),
                "priority-desc" => stories.OrderByDescending(story => story.Priority).ThenBy(story => story.Title).ToList(),
                "title"         => stories.OrderBy(story => story.Title).ToList(),
                _                => stories.OrderBy(story => story.ColumnKey).ThenBy(story => story.Rank).ThenBy(story => story.DisplayId).ToList()
            };
        }
    }

    private bool CanReorder => string.IsNullOrWhiteSpace(_searchText)
                               && string.IsNullOrWhiteSpace(_filterProjectKey)
                               && string.IsNullOrWhiteSpace(_filterAreaKey)
                               && string.IsNullOrWhiteSpace(_filterStreamKey)
                               && string.IsNullOrWhiteSpace(_filterItemTypeKey)
                               && string.IsNullOrWhiteSpace(_filterColumnKey)
                               && _sortMode == "board";

    private bool MatchesFilters(BacklogStoryDto story)
    {
        if (!string.IsNullOrWhiteSpace(_filterProjectKey) && !string.Equals(story.ProjectKey, _filterProjectKey, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(_filterAreaKey) && !string.Equals(story.AreaKey, _filterAreaKey, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(_filterStreamKey) && !string.Equals(story.StreamKey, _filterStreamKey, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(_filterItemTypeKey) && !string.Equals(story.ItemTypeKey, _filterItemTypeKey, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(_filterColumnKey) && !string.Equals(story.ColumnKey, _filterColumnKey, StringComparison.OrdinalIgnoreCase)) return false;
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var search = _searchText.Trim();
        return story.DisplayId.Contains(search, StringComparison.OrdinalIgnoreCase)
               || story.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
               || story.Description.Contains(search, StringComparison.OrdinalIgnoreCase)
               || story.ProjectKey.Contains(search, StringComparison.OrdinalIgnoreCase)
               || story.AreaKey.Contains(search, StringComparison.OrdinalIgnoreCase)
               || story.ItemTypeKey.Contains(search, StringComparison.OrdinalIgnoreCase)
               || (story.StreamKey?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
               || story.Properties.Any(property => property.Key.Contains(search, StringComparison.OrdinalIgnoreCase) || property.Value.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private void ClearFilters()
    {
        _searchText = _filterProjectKey = _filterAreaKey = _filterStreamKey = _filterItemTypeKey = _filterColumnKey = null;
        _sortMode = "board";
    }

    private void BeginEdit(BacklogStoryDto story)
    {
        _editingStory = story;
        _editTitle = story.Title;
        _editDescription = story.Description;
        _editPriority = story.Priority;
        _editProjectKey = story.ProjectKey;
        _editAreaKey = story.AreaKey;
        _editStreamKey = story.StreamKey;
        _editItemTypeKey = story.ItemTypeKey;
        _editProperties.Clear();
        foreach (var property in story.Properties)
            _editProperties[property.Key] = property.Value;
        _scrollToOperatorDetails = true;
    }

    private void CancelEdit() => _editingStory = null;

    private async Task SaveEditAsync()
    {
        if (_editingStory is null || string.IsNullOrWhiteSpace(_editTitle) || string.IsNullOrWhiteSpace(_editDescription))
        {
            SetMessage(Severity.Warning, "A title and description are required.");
            return;
        }

        _saving = true;
        try
        {
            await BacklogClient.UpdateStoryAsync(_editingStory.Id, new UpdateBacklogStoryRequest(
                _editTitle, _editDescription, _editProjectKey, _editAreaKey, _editItemTypeKey, _editPriority,
                string.IsNullOrWhiteSpace(_editStreamKey) ? null : _editStreamKey,
                new Dictionary<string, string>(_editProperties, StringComparer.OrdinalIgnoreCase), _editingStory.Revision));
            _editingStory = null;
            await RefreshAsync();
            SetMessage(Severity.Success, "Story changes saved.");
        }
        catch (Exception exception)
        {
            SetMessage(Severity.Error, $"Could not save story: {exception.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private IReadOnlyDictionary<string, string> GetNewProperties()
    {
        var properties = new Dictionary<string, string>(_customProperties, StringComparer.OrdinalIgnoreCase)
               {
                   ["release"] = _release
                 , ["owner"] = _owner
                 , ["estimate"] = _estimate
                 , ["dependency"] = _dependency
                 , ["customer-impact"] = _customerImpact
               };
        return properties;
    }

    private string GetCustomPropertyValue(string key) =>
        _customProperties.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetCustomPropertyValue(string key, string value) => _customProperties[key] = value;

    private string GetEditPropertyValue(string key) =>
        _editProperties.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetEditPropertyValue(string key, string value) => _editProperties[key] = value;

    private void SetDefaultsFromBoard()
    {
        if (_board is null) return;
        _newProjectKey = GetDefaultKey(_newProjectKey, _board.Projects);
        _newAreaKey = GetDefaultKey(_newAreaKey, _board.Areas);
        _newItemTypeKey = GetDefaultKey(_newItemTypeKey, _board.ItemTypes);
        _newColumnKey = GetDefaultKey(_newColumnKey, _board.Columns);
    }

    private int GetReferenceCount(string referenceType)
    {
        return referenceType switch
        {
            "project"  => _board?.Projects.Count ?? 0
          , "area"     => _board?.Areas.Count ?? 0
          , "stream"   => _board?.Streams.Count ?? 0
          , "column"   => _board?.Columns.Count ?? 0
          , "type"     => _board?.ItemTypes.Count ?? 0
          , "property" => _board?.PropertyDefinitions.Count ?? 0
          , _           => 0
        };
    }

    private IReadOnlyList<BacklogReferenceDto> GetReferences(string referenceType) => referenceType switch
    {
        "project"  => _board?.Projects ?? Array.Empty<BacklogReferenceDto>(),
        "area"     => _board?.Areas ?? Array.Empty<BacklogReferenceDto>(),
        "stream"   => _board?.Streams ?? Array.Empty<BacklogReferenceDto>(),
        "column"   => _board?.Columns ?? Array.Empty<BacklogReferenceDto>(),
        "type"     => _board?.ItemTypes ?? Array.Empty<BacklogReferenceDto>(),
        "property" => _board?.PropertyDefinitions ?? Array.Empty<BacklogReferenceDto>(),
        _           => Array.Empty<BacklogReferenceDto>()
    };

    private void SelectReferenceForEdit(string key)
    {
        _editReferenceKey = key;
        var reference = GetReferences(_editReferenceType).FirstOrDefault(item => item.Key == key);
        if (reference is null) return;
        _editReferenceName = reference.Name;
        _editReferenceSortOrder = reference.SortOrder;
        _editReferenceArchived = reference.IsArchived;
    }

    private static string GetDefaultKey(string currentKey, IReadOnlyList<BacklogReferenceDto> references)
    {
        return references.Any(reference => reference.Key == currentKey && !reference.IsArchived)
            ? currentKey
            : references.FirstOrDefault(reference => !reference.IsArchived)?.Key ?? string.Empty;
    }

    private void SetMessage(Severity severity, string message)
    {
        _messageSeverity = severity;
        _message = message;
    }

    private static readonly HashSet<string> DefaultPropertyKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "release", "owner", "estimate", "dependency", "customer-impact"
    };
