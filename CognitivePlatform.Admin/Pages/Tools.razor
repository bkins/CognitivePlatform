@page "/tools"
@using CognitivePlatform.Admin.Services.ToolScript
@using CognitivePlatform.Admin.Services.ToolScript.Helpers
@using CognitivePlatform.Admin.Services.ToolScript.Interfaces
@using CognitivePlatform.Admin.Services.ToolScript.Models

@inject ToolScriptService     ToolScriptingService
@inject IToolScriptRunner     ToolScriptRunner
@inject ITerminalStateService TerminalStateService

<PageTitle>
    Tools
</PageTitle>

<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Class="mb-4">
    
    <MudText Typo="Typo.h4">
        Tools
    </MudText>
    
    <MudSpacer/>

    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.ClearAll"
               OnClick="ClearConsole">
        Clear Output
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Error"
               StartIcon="@Icons.Material.Filled.Stop">
        Abort
    </MudButton>
</MudStack>

@foreach (var category in ValidToolGroups)
{
    <MudDivider Class="mt-6 mb-2"/>

    <MudText Typo="Typo.h5">
        @category.Key
    </MudText>
    
    @* <MudText Typo="Typo.h5" Class="mt-4 mb-2"> *@
    @*     @category.Key *@
    @* </MudText> *@

    @foreach (var request in category)
    {
        <MudCard Class="mb-4">
            
                <MudCardHeader>
                    <MudText Typo="Typo.h6">
                        @request.Tool.Metadata.Name
                    </MudText>
                </MudCardHeader>
                <MudCardContent>
                    @if (request.Tool.Metadata.Description.HasValue())
                    {
                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary"
                                 Class="mb-4">
                            @request.Tool.Metadata.Description
                        </MudText>
                    }

                    <MudGrid>

                        @foreach (var parameter in request.Tool.Parameters)
                        {
                            <MudItem xs="12" md="6">

                                @switch (parameter.ParameterType)
                                {
                                    case ToolParameterType.Text:
                                        <MudTextField T="string"
                                                      Label="@parameter.Label"
                                                      Value="@(GetString(request
                                                                       , parameter))"
                                                      ValueChanged="@(v => SetValue(request
                                                                                  , parameter
                                                                                  , v))"
                                                      FullWidth="true"/>
                                        break;

                                    case ToolParameterType.Boolean:
                                        <MudCheckBox T="bool"
                                                     Label="@parameter.Label"
                                                     Value="@(GetBool(request
                                                                    , parameter))"
                                                     ValueChanged="@(v => SetValue(request
                                                                                 , parameter
                                                                                 , v))"/>
                                        break;

                                    case ToolParameterType.Selection:
                                        <MudSelect T="string"
                                                   Label="@parameter.Label"
                                                   Value="@(GetString(request
                                                                    , parameter))"
                                                   ValueChanged="@(v => SetValue(request
                                                                               , parameter
                                                                               , v))"
                                                   FullWidth="true">

                                            @foreach (var option in parameter.AllowedValues)
                                            {
                                                <MudSelectItem T="string" Value="@option">
                                                    @option
                                                </MudSelectItem>
                                            }

                                        </MudSelect>
                                        break;
                                }

                            </MudItem>
                        }

                    </MudGrid>

                </MudCardContent>
                <MudCardActions>

                    <MudSpacer/>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@Terminal.IsRunning"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="@(() => RunTool(request))">

                        @(Terminal.IsRunning
                                ? "Running..."
                                : "Run")

                    </MudButton>

                </MudCardActions>
        </MudCard>
    }   
}
@if (InvalidTools.Any())
{
    <MudExpansionPanels Class="mb-4">

        <MudExpansionPanel Text="@($"Scripts requiring attention ({InvalidTools.Count()})")"
                           Icon="@Icons.Material.Filled.Warning">

            <MudAlert Severity="Severity.Warning"
                      Dense="true"
                      Variant="Variant.Outlined">

                <MudText Typo="Typo.h6">
                    Scripts requiring attention (@InvalidTools.Count()) in @ScriptFolder
                </MudText>

                <MudText Typo="Typo.body2">
                    These PowerShell scripts were discovered but could not be loaded as runnable tools.
                </MudText>

            </MudAlert>

            <MudTable Items="InvalidTools"
                      Context="toolRequest"
                      Dense="true">

                <HeaderContent>
                    <MudTh>Status</MudTh>
                    <MudTh>Script</MudTh>
                    <MudTh>Issue</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        <MudIcon Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Error"/>
                        @toolRequest.Tool.Status
                    </MudTd>
                    <MudTd>
                        @Path.GetFileName(toolRequest.Tool.ScriptPath)
                    </MudTd>

                    <MudTd>
                        @toolRequest.Tool.StatusMessage
                    </MudTd>
                </RowTemplate>

            </MudTable>


        </MudExpansionPanel>

    </MudExpansionPanels>
}

@if (false && InvalidTools.Any())
{
    <MudDivider Class="my-6"/>

    <MudAlert Severity="Severity.Warning"
              Dense="true"
              Variant="Variant.Outlined">

        <MudText Typo="Typo.h6">
            Scripts requiring attention (@InvalidTools.Count()) in @ScriptFolder
        </MudText>

        <MudText Typo="Typo.body2">
            These PowerShell scripts were discovered but could not be loaded as runnable tools.
        </MudText>

    </MudAlert>

    <MudTable Items="InvalidTools"
              Context="toolRequest"
              Dense="true">

        <HeaderContent>
            <MudTh>Status</MudTh>
            <MudTh>Script</MudTh>
            <MudTh>Issue</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>
                <MudIcon Color="Color.Error"
                         Icon="@Icons.Material.Filled.Error"/>
                @toolRequest.Tool.Status
            </MudTd>
            <MudTd>
                @Path.GetFileName(toolRequest.Tool.ScriptPath)
            </MudTd>

            <MudTd>
                @toolRequest.Tool.StatusMessage
            </MudTd>
        </RowTemplate>

    </MudTable>

}

<MudPaper Elevation="4"
          Class="pa-4 mt-6"
          Style="background:#1e1e1e;height:500px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;">

    @if (Terminal.Lines.Count == 0)
    {
        <div style="color:#888">
            Run a tool to see output...
        </div>
    }
    else
    {
        <div style="background:#1e1e1e;
                    color:#d4d4d4;
                    padding:16px;
                    overflow-y:auto;
                    height:500px;
                    font-family:'Cascadia Code','Consolas',monospace;
                    white-space:pre-wrap;">

            @foreach (var line in Terminal.Lines)
            {
                var color = line.Kind switch
                {
                        TerminalLineKind.Error   => "#ff6b6b",
                        TerminalLineKind.Warning => "#ffd166",
                        _                        => "#d4d4d4"
                };

                <div style="color:@color">@line.Text</div>
            }

        </div>
    }
    

</MudPaper>

@code
{
    private List<ToolExecutionRequest> _requests = [];

    private const string        TerminalId = "Tools";
    private       TerminalState Terminal => TerminalStateService.Get(TerminalId);

    private string? ScriptFolder;
    
    private IEnumerable<IGrouping<string, ToolExecutionRequest>> ValidToolGroups =>
            _requests.Where(request => request.Tool.Status == ToolLoadStatus.Valid 
                                     && request.Tool.Metadata.Hidden.Not())
                     .OrderBy(request => request.Tool.Metadata.Order)
                     .GroupBy(request => request.Tool.Metadata.Category);

    private IEnumerable<ToolExecutionRequest> InvalidTools =>
            _requests.Where(request => request.Tool.Status != ToolLoadStatus.Valid)
                     .OrderBy(request => Path.GetFileName(request.Tool.ScriptPath));
    
    protected override void OnInitialized()
    {
        _requests = ToolScriptingService.GetTools()
                                        .Select(tool =>
                                         {
                                             var request = new ToolExecutionRequest { Tool = tool };
                                             //To have default values:
                                             /*
                                                foreach (var parameter in tool.Parameters)
                                                {
                                                    request.Values[parameter.Name] = parameter.DefaultValue;
                                                }
                                              */
                                             return request;
                                         })
                                        .ToList();
        ScriptFolder = Path.GetDirectoryName(_requests.FirstOrDefault()?.Tool.ScriptPath);
    }

    private static string GetString( ToolExecutionRequest request
                                   , ToolParameter        parameter )
    {
        return request.Values.TryGetValue(parameter.Name
                                        , out var value)
                       ? value?.ToString() ?? ""
                       : "";
    }

    private static bool GetBool( ToolExecutionRequest request
                               , ToolParameter        parameter )
    {
        return request.Values.TryGetValue(parameter.Name, out var value)
            && value is true;
    }

    private void SetValue( ToolExecutionRequest request
                         , ToolParameter        parameter
                         , object?              value )
    {
        request.Values[parameter.Name] = value;
    }

    private async Task RunTool( ToolExecutionRequest request )
    {

        await ToolScriptRunner.RunAsync(terminalId: TerminalId
                                      , tool: request.Tool
                                      , values: request.Values);
    }

    private void ClearConsole()
    {
        Terminal.Lines.Clear();
    }
}