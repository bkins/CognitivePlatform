@page "/evaluation"
@using System.Diagnostics
@using CognitivePlatform.Admin.CpAdminClients
@using CognitivePlatform.Admin.Services
@implements IAsyncDisposable
@inject IAdminTrainingClient Training
@inject IJSRuntime            Js

<PageTitle>Evaluation — CP Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Evaluation Dashboard</MudText>

<MudGrid Spacing="4">

    @* ── Run + status row ──────────────────────────────────────────────────────── *@
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Filled.Speed" />
                <MudText Typo="Typo.h6">Interpreter Evaluator</MudText>

                @if (_evalRunning)
                {
                    <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.RunCircle" Size="Size.Small">
                        Running…
                    </MudChip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Stop" OnClick="@AbortEval">
                        Abort
                    </MudButton>
                }
                else if (_evalExitCode.HasValue)
                {
                    @if (_evalExitCode == 0)
                    {
                        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small">
                            Last run OK
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Error" Size="Size.Small">
                            Exit @_evalExitCode
                        </MudChip>
                    }
                }

                <MudSpacer />

                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@_evalRunning" OnClick="@RunEvalAsync">
                    Run Now
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@_evalRunning" OnClick="@RefreshAll">
                    Refresh
                </MudButton>
            </MudStack>

            @if (_evalRunError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_evalRunError</MudAlert>
            }

            @if (_evalOutput.Count > 0 || _evalRunning)
            {
                <MudExpansionPanels Class="mt-3" Elevation="0">
                    <MudExpansionPanel Text="Evaluator Output" IsExpanded="@_evalRunning">
                        <MudPaper Elevation="4"
                                  Style="background:#1e1e1e;padding:16px;max-height:350px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:0.82rem;">
                            @foreach (var line in _evalOutput)
                            {
                                <div style="color:@EvalLineColor(line.Kind);white-space:pre-wrap;line-height:1.5">@line.Text</div>
                            }
                            <div id="eval-end"></div>
                        </MudPaper>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudPaper>
    </MudItem>

    @* ── Latest run summary ─────────────────────────────────────────────────────── *@
    @if (_latestRunRows.Count > 0)
    {
        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-2">
                Latest Run — @_latestRunRows[0].RunDate.ToString("yyyy-MM-dd HH:mm")
            </MudText>
            <MudGrid Spacing="3">
                @foreach (var row in _latestRunRows)
                {
                    var scoreColor = ScoreToColor(row.AvgScore);
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="3">
                            <MudCardContent Class="pb-1">
                                <MudText Typo="Typo.subtitle2" Class="mb-1" Style="opacity:0.75">@row.Model</MudText>
                                <MudText Typo="Typo.h4" Style="@($"color:{scoreColor};font-weight:700")">
                                    @row.AvgScore.ToString("F1")
                                </MudText>
                                <MudText Typo="Typo.caption" Style="opacity:0.6">avg score / 100</MudText>
                            </MudCardContent>
                            <MudDivider />
                            <MudCardContent Class="pt-1 pb-1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.caption">@row.Tests tests</MudText>
                                    <MudText Typo="Typo.caption">@row.TokPerSecond.ToString("F1") tok/s</MudText>
                                </MudStack>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                    <MudText Typo="Typo.caption" Style="color:#ff6b6b">@row.JsonFails JSON fail</MudText>
                                    <MudText Typo="Typo.caption" Style="color:#ffa726">@row.ParamFails param fail</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    }

    @* ── Score History ──────────────────────────────────────────────────────────── *@
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-3">Score History</MudText>

            @if (_historyError is not null)
            {
                <MudAlert Severity="Severity.Error">@_historyError</MudAlert>
            }
            else if (_historyRows.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style:italic">
                    No eval result files found in C:\CP\Data\EvalResults\
                </MudText>
            }
            else
            {
                <MudTable T="HistoryRow" Items="@_historyRows" Dense="true" Hover="true" Striped="true"
                          SortLabel="Sort By" Elevation="0">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<HistoryRow,object>(r=>r.RunDate)">Date</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<HistoryRow,object>(r=>r.Model)">Model</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<HistoryRow,object>(r=>r.AvgScore)">Avg Score</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right">Δ vs Prior</MudTh>
                        <MudTh Style="text-align:right">JSON Fails</MudTh>
                        <MudTh Style="text-align:right">Param Fails</MudTh>
                        <MudTh Style="text-align:right">Tok/s</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd>@row.RunDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd><MudText Style="font-family:monospace">@row.Model</MudText></MudTd>
                        <MudTd Style="@ScoreCellStyle(row)">@row.AvgScore.ToString("F1")</MudTd>
                        <MudTd Style="@DeltaCellStyle(row)">@row.DeltaDisplay</MudTd>
                        <MudTd Style="text-align:right">@row.JsonFails</MudTd>
                        <MudTd Style="text-align:right">@row.ParamFails</MudTd>
                        <MudTd Style="text-align:right">@row.TokPerSecond.ToString("F1")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>

    @* ── Training corpus stats ──────────────────────────────────────────────────── *@
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-3">Training Corpus</MudText>

            @if (_stats is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style:italic">
                    Corpus stats unavailable — API may be unreachable.
                </MudText>
            }
            else
            {
                <MudGrid Spacing="3">
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="0" Class="pa-2" Style="background:#1e1e2e;border-radius:8px;text-align:center">
                            <MudText Typo="Typo.h5" Style="color:#c0caf5;font-weight:700">@_stats.TotalRecords.ToString("N0")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.65">Total Records</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="0" Class="pa-2" Style="background:#1e1e2e;border-radius:8px;text-align:center">
                            <MudText Typo="Typo.h5" Style="color:#9ece6a;font-weight:700">@((_stats.SuccessRate * 100).ToString("F1"))%</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.65">Success Rate</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="0" Class="pa-2" Style="background:#1e1e2e;border-radius:8px;text-align:center">
                            <MudText Typo="Typo.h5" Style="color:#7aa2f7;font-weight:700">@_stats.AvgLatencyMs.ToString("N0") ms</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.65">Avg Latency</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="0" Class="pa-2" Style="background:#1e1e2e;border-radius:8px;text-align:center">
                            <MudText Typo="Typo.h5" Style="color:#e0af68;font-weight:700">@_recentRatePerDay.ToString("F1")</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.65">Records / Day (7d)</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="0" Class="pa-2" Style="background:#1e1e2e;border-radius:8px;text-align:center">
                            <MudText Typo="Typo.h5" Style="color:#bb9af7;font-weight:700">@_daysSinceFirst</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.65">Days Active</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="0" Class="pa-2" Style="background:#1e1e2e;border-radius:8px;text-align:center">
                            <MudText Typo="Typo.h5" Style="color:#f7768e;font-weight:700">@_daysTo10K</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:0.65">Est. Days to 10K</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
    </MudItem>

</MudGrid>

@code {

    // ── Types ─────────────────────────────────────────────────────────────────────

    private sealed record HistoryRow(
        DateTime RunDate
      , string   Model
      , double   AvgScore
      , int      JsonFails
      , int      ParamFails
      , double   TokPerSecond
      , double?  Delta
      , ScoreQuality Quality)
    {
        public string DeltaDisplay => Delta is null
            ? "—"
            : Delta.Value > 0 ? $"+{Delta.Value:F1}" : $"{Delta.Value:F1}";
    }

    private enum ScoreQuality { Normal, Best, Worst }

    private sealed record EvalLine(string Text, EvalLineKind Kind = EvalLineKind.Normal);

    private enum EvalLineKind { Normal, Pass, Fail, Error }

    private const string CpRepoDir = @"C:\Users\benho\source\repos\CognitivePlatform";

    // ── State ─────────────────────────────────────────────────────────────────────

    private List<HistoryRow>             _historyRows    = [];
    private List<EvalModelRow>           _latestRunRows  = [];
    private string?                      _historyError;

    private TrainingCorpusStatsDto?      _stats;
    private double                       _recentRatePerDay;
    private string                       _daysSinceFirst = "—";
    private string                       _daysTo10K      = "—";

    private readonly List<EvalLine>      _evalOutput     = [];
    private bool                         _evalRunning;
    private int?                         _evalExitCode;
    private string?                      _evalRunError;
    private Process?                     _evalProcess;
    private CancellationTokenSource?     _evalCts;

    // Resolved once at startup; null means PS7 is not installed.
    private static readonly string? Pwsh7Exe = FindPwsh7();

    private static string? FindPwsh7()
    {
        string[] candidates =
        [
            @"C:\Program Files\PowerShell\7\pwsh.exe"
          , @"C:\Program Files\PowerShell\pwsh.exe"
          , Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData)
                       , @"Microsoft\WindowsApps\pwsh.exe")
        ];
        foreach (var path in candidates)
            if (File.Exists(path)) return path;

        var pathEnv = Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
        foreach (var dir in pathEnv.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            try
            {
                var candidate = Path.Combine(dir.Trim(), "pwsh.exe");
                if (File.Exists(candidate)) return candidate;
            }
            catch { /* skip */ }
        }

        return null;
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        LoadEvalHistory();
        await LoadCorpusStatsAsync();
    }

    private async Task RefreshAll()
    {
        LoadEvalHistory();
        await LoadCorpusStatsAsync();
        StateHasChanged();
    }

    // ── Eval history loading ──────────────────────────────────────────────────────

    private void LoadEvalHistory()
    {
        _historyError = null;

        try
        {
            var rawRows = EvalResultParser.LoadAll();

            if (rawRows.Count == 0)
            {
                _historyRows   = [];
                _latestRunRows = [];
                return;
            }

            var latestDate  = rawRows.Max(row => row.RunDate.Date);
            _latestRunRows  = rawRows.Where(row => row.RunDate.Date == latestDate).ToList();

            // Per-model best/worst across all runs
            var perModel = rawRows.GroupBy(row => row.Model).ToDictionary(
                group => group.Key
              , group => (Best: group.Max(row => row.AvgScore), Worst: group.Min(row => row.AvgScore)));

            // Previous run date per model (for delta)
            var allSorted = rawRows
                .OrderByDescending(row => row.RunDate)
                .ToList();

            _historyRows = allSorted.Select(raw =>
            {
                var prior = allSorted
                    .Where(row => row.Model == raw.Model && row.RunDate < raw.RunDate)
                    .FirstOrDefault();

                var delta = prior is null ? (double?)null : raw.AvgScore - prior.AvgScore;

                var (best, worst) = perModel[raw.Model];
                var quality = raw.AvgScore >= best  ? ScoreQuality.Best
                            : raw.AvgScore <= worst && best != worst ? ScoreQuality.Worst
                            : ScoreQuality.Normal;

                return new HistoryRow(raw.RunDate, raw.Model, raw.AvgScore
                                    , raw.JsonFails, raw.ParamFails, raw.TokPerSecond
                                    , delta, quality);
            }).ToList();
        }
        catch (Exception ex)
        {
            _historyError = ex.Message;
        }
    }

    // ── Corpus stats loading ──────────────────────────────────────────────────────

    private async Task LoadCorpusStatsAsync()
    {
        _stats = await Training.GetStatsAsync();

        if (_stats is null) return;

        // Days since first record (DailyCounts are ordered DESC by the API)
        if (_stats.DailyCounts.Count > 0)
        {
            var oldest = _stats.DailyCounts[^1].Day;
            if (DateTime.TryParse(oldest, out var firstDate))
            {
                var elapsed = (DateTime.UtcNow.Date - firstDate.Date).Days;
                _daysSinceFirst = elapsed.ToString();
            }
        }

        // Recent records-per-day (last 7 days in the DailyCounts list)
        var recent7 = _stats.DailyCounts.Take(7).Sum(day => day.RecordCount);
        _recentRatePerDay = recent7 / 7.0;

        // Estimated days to 10K
        if (_recentRatePerDay > 0 && _stats.TotalRecords < 10_000)
        {
            var daysNeeded = (int)Math.Ceiling((10_000 - _stats.TotalRecords) / _recentRatePerDay);
            _daysTo10K = daysNeeded.ToString("N0");
        }
        else if (_stats.TotalRecords >= 10_000)
        {
            _daysTo10K = "✓";
        }
    }

    // ── Evaluator execution ───────────────────────────────────────────────────────

    private async Task RunEvalAsync()
    {
        if (_evalRunning) return;

        _evalRunning  = true;
        _evalExitCode = null;
        _evalRunError = null;
        _evalOutput.Clear();
        _evalCts = new CancellationTokenSource();

        StateHasChanged();

        // Prefer PS7; fall back to PS5.1 with a notice (script is PS5.1-safe).
        var psExe      = Pwsh7Exe ?? @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe";
        var scriptPath = Path.Combine(CpRepoDir, @"Scripts\Run-InterpreterEval.ps1");
        var psArgs     = $@"-NonInteractive -ExecutionPolicy Bypass -File ""{scriptPath}""";

        if (Pwsh7Exe is null)
            _evalOutput.Add(new("[Note: PowerShell 7 not found — using Windows PowerShell 5.1. Install PS7 from https://aka.ms/install-powershell for best results.]", EvalLineKind.Normal));

        _evalOutput.Add(new($"$ {psExe} {psArgs}"));
        _evalOutput.Add(new(string.Empty));
        await InvokeAsync(StateHasChanged);
        await ScrollAsync();

        try
        {
            var startInfo = new ProcessStartInfo
            {
                FileName               = psExe
              , Arguments              = psArgs
              , WorkingDirectory       = CpRepoDir
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            _evalProcess = new Process { StartInfo = startInfo };

            _evalProcess.OutputDataReceived += async (_, e) =>
            {
                if (e.Data is null) return;
                await InvokeAsync(() => { _evalOutput.Add(new(e.Data, ClassifyEvalLine(e.Data))); StateHasChanged(); });
                await ScrollAsync();
            };

            _evalProcess.ErrorDataReceived += async (_, e) =>
            {
                if (e.Data is null) return;
                await InvokeAsync(() => { _evalOutput.Add(new(e.Data, EvalLineKind.Error)); StateHasChanged(); });
                await ScrollAsync();
            };

            try
            {
                _evalProcess.Start();
                _evalProcess.BeginOutputReadLine();
                _evalProcess.BeginErrorReadLine();
                await _evalProcess.WaitForExitAsync(_evalCts.Token);
                _evalExitCode = _evalProcess.ExitCode;
            }
            catch (OperationCanceledException) { _evalOutput.Add(new("[Aborted by user]", EvalLineKind.Error)); }
            catch (Exception ex)
            {
                _evalRunError = ex.Message;
                _evalOutput.Add(new($"[Error: {ex.Message}]", EvalLineKind.Error));
            }
            finally
            {
                _evalProcess?.Dispose();
                _evalProcess = null;
            }
        }
        finally
        {
            _evalRunning = false;
            await InvokeAsync(StateHasChanged);
            await ScrollAsync();

            // Auto-refresh results when the run completes successfully
            if (_evalExitCode == 0)
                await RefreshAll();
        }
    }

    private void AbortEval()
    {
        _evalCts?.Cancel();
        try { _evalProcess?.Kill(entireProcessTree: true); }
        catch { /* already exited */ }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────────

    private static EvalLineKind ClassifyEvalLine(string text)
    {
        var t = text.TrimStart();
        if (t.Contains("[PASS]", StringComparison.OrdinalIgnoreCase) || t.Contains("✓") || t.Contains("✔"))
            return EvalLineKind.Pass;
        if (t.Contains("[FAIL]", StringComparison.OrdinalIgnoreCase) || t.Contains("✗") || t.Contains("✘"))
            return EvalLineKind.Fail;
        return EvalLineKind.Normal;
    }

    private static string EvalLineColor(EvalLineKind kind) => kind switch
    {
        EvalLineKind.Pass  => "#4ec9b0"
      , EvalLineKind.Fail  => "#ff6b6b"
      , EvalLineKind.Error => "#ff6b6b"
      , _                  => "#d4d4d4"
    };

    private static string ScoreToColor(double score)
        => score >= 85 ? "#9ece6a"
         : score >= 70 ? "#e0af68"
         : "#f7768e";

    private static string ScoreCellStyle(HistoryRow row)
    {
        var color = row.Quality switch
        {
            ScoreQuality.Best  => "color:#9ece6a;font-weight:700"
          , ScoreQuality.Worst => "color:#f7768e"
          , _                  => string.Empty
        };
        return $"text-align:right;{color}";
    }

    private static string DeltaCellStyle(HistoryRow row)
    {
        if (row.Delta is null) return "text-align:right;opacity:0.4";
        return row.Delta > 0.5  ? "text-align:right;color:#9ece6a"
             : row.Delta < -0.5 ? "text-align:right;color:#f7768e"
             : "text-align:right;opacity:0.6";
    }

    private async Task ScrollAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("eval"
                                   , "var el=document.getElementById('eval-end');if(el)el.scrollIntoView({behavior:'instant'});");
        }
        catch { /* ignore during disposal */ }
    }

    // ── Disposal ──────────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        _evalCts?.Cancel();
        _evalCts?.Dispose();
        try { _evalProcess?.Kill(entireProcessTree: true); }
        catch { /* already exited */ }
        _evalProcess?.Dispose();
        await ValueTask.CompletedTask;
    }
}
