                    sb.AppendLine(line);
                }
                if (test.Output.Count > 12)
                {
                    sb.AppendLine("...");
                }
                sb.AppendLine("```");
            }
            sb.AppendLine();
        }

        await Js.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
    }

    private static bool TryExtractPngPath(string text, out string path)
    {
        path = string.Empty;
        if (string.IsNullOrWhiteSpace(text)) return false;
        var idx = text.IndexOf(".png", StringComparison.OrdinalIgnoreCase);
        if (idx == -1) return false;

        var match = System.Text.RegularExpressions.Regex.Match(text, @"[A-Za-z]:\\[^\s]+\.png");
        if (match.Success)
        {
            path = match.Value;
            return true;
        }
        return false;
    }

