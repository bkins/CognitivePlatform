    // ── Unit Tests execution ──────────────────────────────────────────────────────

    private async Task RunUnitTestsAsync()
    {
        var unitTestsState = TerminalService.Get("test-unit-tests");
        if (unitTestsState.IsRunning) return;

        TerminalService.Clear("test-unit-tests");
        TerminalService.MarkRunning("test-unit-tests", true);

        try
        {
            var testProjects = DetectTestProjects();

            if (testProjects.Count == 0)
            {
                TerminalService.AppendLine("test-unit-tests", new TerminalLine("No test projects detected.", TerminalLineKind.Error));
                return;
            }

            int overallExitCode = 0;

            await using var api = new ApiLifecycle(TerminalService, "test-unit-tests");
            bool apiStarted = false;

            foreach (var project in testProjects)
            {
                var projectName = Path.GetFileNameWithoutExtension(project);
                var workingDir = Path.GetDirectoryName(project) ?? @"C:\Users\benho\source\repos";

                // 1. Build the project
                TerminalService.AppendLine("test-unit-tests", new TerminalLine(string.Empty));
                TerminalService.AppendLine("test-unit-tests", new TerminalLine($"=== Building: {projectName} ===", TerminalLineKind.Normal));
                TerminalService.AppendLine("test-unit-tests", new TerminalLine(string.Empty));

                var buildStartInfo = new ProcessStartInfo
                {
                    FileName               = "dotnet"
                  , Arguments              = $"build \"{project}\""
                  , WorkingDirectory       = workingDir
                  , RedirectStandardOutput = true
                  , RedirectStandardError  = true
                  , UseShellExecute        = false
                  , CreateNoWindow         = true
                };

                // Run build without custom ClassifyLine to keep MSBuild output separate from test logs
                var buildExitCode = await TerminalService.RunProcessAsync("test-unit-tests", buildStartInfo);
                if (buildExitCode is null)
                {
                    overallExitCode = -1;
                    break;
                }
                if (buildExitCode != 0)
                {
                    overallExitCode = buildExitCode.Value;
                    TerminalService.AppendLine("test-unit-tests", new TerminalLine($"Build failed for {projectName}. Skipping tests.", TerminalLineKind.Error));
                    continue;
                }

                // 2. Start API if needed
                if (projectName.Contains("Integration", StringComparison.OrdinalIgnoreCase) && !apiStarted)
                {
                    await api.StartIfNeededAsync();
                    apiStarted = true;
                }

                // 3. Run tests with --no-build
                TerminalService.AppendLine("test-unit-tests", new TerminalLine(string.Empty));
                TerminalService.AppendLine("test-unit-tests", new TerminalLine($"=== Running tests for: {projectName} ===", TerminalLineKind.Normal));
                TerminalService.AppendLine("test-unit-tests", new TerminalLine(string.Empty));

                var dotnetArgs = $"test \"{project}\" --no-build --logger \"console;verbosity=normal\"";
                TerminalService.AppendLine("test-unit-tests", new TerminalLine($"$ dotnet {dotnetArgs}"));
                TerminalService.AppendLine("test-unit-tests", new TerminalLine(string.Empty));

                var startInfo = new ProcessStartInfo
                {
                    FileName               = "dotnet"
                  , Arguments              = dotnetArgs
                  , WorkingDirectory       = workingDir
                  , RedirectStandardOutput = true
                  , RedirectStandardError  = true
                  , UseShellExecute        = false
                  , CreateNoWindow         = true
                };

                // Wait for this project's run to complete
                var exitCode = await TerminalService.RunProcessAsync("test-unit-tests", startInfo, ClassifyLine, timeout: TimeSpan.FromMinutes(2.5));
                
                if (exitCode is null)
                {
                    // User aborted
                    overallExitCode = -1;
                    break;
                }
                
                if (exitCode != 0)
                {
                    overallExitCode = exitCode.Value;
                }
            }

            TerminalService.SetExitCode("test-unit-tests", overallExitCode == -1 ? null : overallExitCode);

            var snapshot = unitTestsState.Snapshot();
            int totalPassed = snapshot.Count(l => l.Kind == TerminalLineKind.Pass);
            int totalFailed = snapshot.Count(l => l.Kind == TerminalLineKind.Fail);
            var failedTests = ParseFailedTests(snapshot, "Unit Tests");

            TerminalService.AppendLine("test-unit-tests", new TerminalLine(string.Empty));
            TerminalService.AppendLine("test-unit-tests", new TerminalLine("==================================================================", TerminalLineKind.Normal));
            TerminalService.AppendLine("test-unit-tests", new TerminalLine($"  Grand Total Across All Projects: {totalPassed} Passed, {totalFailed} Failed (Total {totalPassed + totalFailed})", totalFailed == 0 ? TerminalLineKind.PassSummary : TerminalLineKind.FailSummary));
            TerminalService.AppendLine("test-unit-tests", new TerminalLine("==================================================================", TerminalLineKind.Normal));

            if (failedTests.Count > 0)
            {
                AppendFailureSummaryToTerminal(TerminalService, "test-unit-tests", failedTests);
            }

            // Generate report
            try
            {
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("# Test Failures Report");
                sb.AppendLine();
                sb.AppendLine($"**Generated on:** {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
                sb.AppendLine($"**Total Failures:** {failedTests.Count}");
                sb.AppendLine();

                if (failedTests.Count == 0)
                {
                    sb.AppendLine("🎉 All tests passed successfully!");
                }
                else
                {
                    var grouped = failedTests.GroupBy(t => t.Project);
                    foreach (var group in grouped)
                    {
                        sb.AppendLine($"## Project: {group.Key}");
                        sb.AppendLine();

                        foreach (var test in group)
                        {
                            sb.AppendLine($"### ❌ {test.TestName}");
                            sb.AppendLine("```");
                            foreach (var line in test.Output)
                            {
                                sb.AppendLine(line);
                            }
                            sb.AppendLine("```");
                            sb.AppendLine();
                        }
                    }
                }

                var reportContent = sb.ToString();

                // 1. Write to repo folder
                var reportPath = @"C:\Users\benho\source\repos\CognitivePlatform\.agents\artifacts\test_failures_report.md";
                var reportDir = Path.GetDirectoryName(reportPath);
                if (reportDir != null && !Directory.Exists(reportDir))
                {
                    Directory.CreateDirectory(reportDir);
                }
                File.WriteAllText(reportPath, reportContent);

                // 2. Write to session artifacts folder
                var sessionReportPath = @"C:\Users\benho\.gemini\antigravity\brain\dee025af-8abd-4cce-b0e8-0cca881839dc\test_failures_report.md";
                File.WriteAllText(sessionReportPath, reportContent);
            }
            catch (Exception ex)
            {
                TerminalService.AppendLine("test-unit-tests", new TerminalLine($"[Failed to write failures report: {ex.Message}]", TerminalLineKind.Error));
            }
        }
        finally
        {
            TerminalService.MarkRunning("test-unit-tests", false);
        }
    }

    private void AbortUnitTests()  => TerminalService.Abort("test-unit-tests");
    private void ClearUnitTests()  => TerminalService.Clear("test-unit-tests");

