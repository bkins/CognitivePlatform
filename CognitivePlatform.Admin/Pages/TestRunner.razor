                        </MudChip>
                    }
                }
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@androidState.IsRunning"
                           OnClick="@RunAndroidAsync">
                    Run
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           Disabled="@androidState.IsRunning"
                           OnClick="@ClearAndroid">
                    Clear
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Disabled="@(androidLines.Length == 0)"
                           OnClick="@(() => CopyTerminalAsync("test-android"))">
                    Copy All
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Disabled="@(androidLines.Length == 0)"
                           OnClick="@(() => CopyFailuresSummaryAsync("test-android"))">
                    Copy Failures
                </MudButton>
                <MudSpacer />
                <MudCheckBox @bind-Value="@_forceFailureAndroid" Label="Force Failure" Color="Color.Error" Dense="true" Disabled="@androidState.IsRunning" />
            </MudStack>

            @if (androidState.Error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Failed to start process: @androidState.Error
                </MudAlert>
            }

            <TerminalOutput Terminal="@androidState"
                            Height="450px"
                            Placeholder="Run Android tests to see output here…"
                            ContainerId="android-terminal-container"
                            EndElementId="android-terminal-end"
                            OnScreenshotClicked="@ShowScreenshot" />

            @if (!androidState.IsRunning && androidState.ExitCode.HasValue && (androidPassed + androidFailed) > 0)
            {
                <MudPaper Elevation="0"
                          Style="background:#2d2d2d;padding:8px 16px;margin-top:2px;border-radius:0 0 4px 4px;font-family:'Cascadia Code','Consolas',monospace;font-size:0.85rem;">
                    <span style="color:@(androidFailed == 0 ? "#4ec9b0" : "#ff6b6b")">
