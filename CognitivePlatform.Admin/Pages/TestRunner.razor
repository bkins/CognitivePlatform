                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="@AbortWindows">
                        Abort
                    </MudButton>
                }
                else if (_windowsExitCode.HasValue)
                {
                    @if (_windowsExitCode == 0)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle"
                                 Size="Size.Small">
                            Exit 0 — OK
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Error"
                                 Size="Size.Small">
                            Exit @_windowsExitCode — Failed
                        </MudChip>
                    }
                }
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Filled"
