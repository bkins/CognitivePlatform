    private static IReadOnlyList<string> DetectTestProjects()
    {
        var roots = new[]
        {
            @"C:\Users\benho\source\repos\CognitivePlatform",
            @"C:\Users\benho\source\repos\LocalAIAssistant"
        };

        var projects = new List<string>();

        foreach (var root in roots)
        {
            if (!Directory.Exists(root)) continue;

            try
            {
                var files = Directory.GetFiles(root, "*.csproj", SearchOption.AllDirectories);
                foreach (var file in files)
                {
                    // Skip bin/obj directories
                    if (file.Contains($"{Path.DirectorySeparatorChar}bin{Path.DirectorySeparatorChar}") ||
                        file.Contains($"{Path.DirectorySeparatorChar}obj{Path.DirectorySeparatorChar}"))
                    {
                        continue;
                    }

                    // Check if it's a test project
                    if (IsTestProject(file))
                    {
                        projects.Add(file);
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error scanning root {root}: {ex.Message}");
            }
        }

        return projects;
    }

    private static bool IsTestProject(string csprojPath)
    {
        var filename = Path.GetFileNameWithoutExtension(csprojPath);
        
        // Exclude runner/setup/seeder projects
        if (filename.Contains("DemoSetup", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("ValidationPlatform.Runner", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("Seeder", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // Exclude integration tests and UI smoke tests from the Unit Tests runner
        if (filename.Contains("Integration", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("Smoke", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("UI.Windows", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (filename.Contains("Test", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("Tests", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        try
        {
            var content = File.ReadAllText(csprojPath);
            if (content.Contains("Microsoft.NET.Test.Sdk", StringComparison.OrdinalIgnoreCase) ||
                content.Contains("xunit", StringComparison.OrdinalIgnoreCase) ||
                content.Contains("nunit", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        catch
        {
            // Ignore read errors
        }

        return false;
    }

    private sealed class FailedTestDetails
    {
        public string Project { get; set; } = "";
        public string TestName { get; set; } = "";
        public List<string> Output { get; } = new();
    }

    private static List<FailedTestDetails> ParseFailedTests(TerminalLine[] lines)
    {
        var failedTests = new List<FailedTestDetails>();
        string currentProject = "Unknown";
        FailedTestDetails? currentFailedTest = null;

        for (int i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            var text = line.Text;
            var trimmed = text.Trim();

            if (trimmed.StartsWith("=== Running tests for:") && trimmed.EndsWith("==="))
            {
                currentProject = trimmed.Substring(22, trimmed.Length - 25).Trim();
                currentFailedTest = null;
                continue;
            }

            if (line.Kind == TerminalLineKind.Fail)
            {
                // Skip the word "Failed"
                string namePart = trimmed.Substring(6).Trim();
                // Strip trailing "[...]" duration if present
                int bracketIdx = namePart.LastIndexOf('[');
                if (bracketIdx != -1)
                {
                    namePart = namePart.Substring(0, bracketIdx).Trim();
                }

                currentFailedTest = new FailedTestDetails
                {
                    Project = currentProject,
                    TestName = namePart
                };
                failedTests.Add(currentFailedTest);
                continue;
            }

            if (line.Kind == TerminalLineKind.Pass)
            {
                currentFailedTest = null;
                continue;
            }

            if (currentFailedTest != null)
            {
                if (trimmed.StartsWith("Test Run Failed.") ||
                    trimmed.StartsWith("Total tests:") ||
                    trimmed.StartsWith("Failed:") ||
                    trimmed.StartsWith("Passed:") ||
                    trimmed.StartsWith("Total time:"))
                {
                    currentFailedTest = null;
                    continue;
                }

                currentFailedTest.Output.Add(text);
            }
        }

        return failedTests;
    }

    private static bool IsApiPortActive()
    {
        try
        {
            using var tcp = new System.Net.Sockets.TcpClient();
            var result = tcp.BeginConnect("localhost", 5273, null, null);
            var success = result.AsyncWaitHandle.WaitOne(TimeSpan.FromMilliseconds(500));
            if (!success) return false;
            tcp.EndConnect(result);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private sealed class ApiLifecycle : IAsyncDisposable
    {
        private Process? _process;
        private readonly ITerminalStateService _terminalService;
        private readonly string _terminalId;

        public ApiLifecycle(ITerminalStateService terminalService, string terminalId)
        {
            _terminalService = terminalService;
            _terminalId = terminalId;
        }

        private static void KillOrphanedApiProcesses()
        {
            try
            {
                foreach (var proc in Process.GetProcessesByName("CognitivePlatform.Api"))
                {
                    try { proc.Kill(entireProcessTree: true); } catch { }
                }
            }
            catch { }
        }

        public async Task StartIfNeededAsync()
        {
            if (IsApiPortActive())
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[API is already running on port 5273. Using existing instance.]", TerminalLineKind.Normal));
                return;
            }

            // Ensure any orphaned/dangling CognitivePlatform.Api processes from prior aborted/failed runs are cleaned up first
            KillOrphanedApiProcesses();

            _terminalService.AppendLine(_terminalId, new TerminalLine("[Starting local API on port 5273...]", TerminalLineKind.Normal));

            var exePath = @"C:\Users\benho\source\repos\CognitivePlatform\CognitivePlatform\bin\Debug\net10.0\CognitivePlatform.Api.exe";
            var startInfo = new ProcessStartInfo
            {
                FileName = exePath,
                Arguments = "--urls \"http://0.0.0.0:5273;http://localhost:5273;http://192.168.0.33:5273\"",
                WorkingDirectory = Path.GetDirectoryName(exePath),
                UseShellExecute = false,
                CreateNoWindow = true,
                RedirectStandardOutput = false,
                RedirectStandardError = false
            };
            startInfo.EnvironmentVariables["ASPNETCORE_ENVIRONMENT"] = "Development";

            _process = new Process { StartInfo = startInfo };
            _process.Start();

            // Wait for port 5273 to become active (up to 15 seconds)
            var limit = DateTime.UtcNow.AddSeconds(15);
            bool started = false;
            while (DateTime.UtcNow < limit)
            {
                await Task.Delay(500);
                if (IsApiPortActive())
                {
                    started = true;
                    break;
                }
                if (_process.HasExited)
                {
                    break;
                }
            }

            if (started)
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[API started successfully on port 5273.]", TerminalLineKind.Normal));
            }
            else
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[Warning: API failed to start or port 5273 did not activate in time.]", TerminalLineKind.Error));
            }
        }

        public async ValueTask DisposeAsync()
        {
            if (_process != null && !_process.HasExited)
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[Stopping local API...]", TerminalLineKind.Normal));
                try
                {
                    _process.Kill(entireProcessTree: true);
                    await _process.WaitForExitAsync();
                    _terminalService.AppendLine(_terminalId, new TerminalLine("[API stopped.]", TerminalLineKind.Normal));
                }
                catch (Exception ex)
                {
                    _terminalService.AppendLine(_terminalId, new TerminalLine($"[Error stopping API: {ex.Message}]", TerminalLineKind.Error));
                }
                _process.Dispose();
            }

            // Always call process cleanup to be absolutely sure no process remains orphaned
            KillOrphanedApiProcesses();
        }
    }

    // ── Disposal ──────────────────────────────────────────────────────────────────

    public ValueTask DisposeAsync()
    {
        TerminalService.StateChanged -= OnTerminalChanged;
        return ValueTask.CompletedTask;
    }
}
