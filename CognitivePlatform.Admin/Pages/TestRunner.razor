        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# Test Failures Summary ({failedTests.Count} Failed Tests)");
        sb.AppendLine();
        foreach (var test in failedTests)
        {
            sb.AppendLine($"### ❌ [{test.Project}] {test.TestName}");
            if (test.Output.Count > 0)
            {
                sb.AppendLine("```");
                foreach (var line in test.Output.Take(12))
