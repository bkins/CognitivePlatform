    private static string SanitizeTerminalText(string text)
    {
        if (text.Contains('Γ'))
        {
            text = text.Replace("ΓöÇ", "─")
                       .Replace("Γöé", "│")
                       .Replace("Γöî", "┌")
                       .Replace("ΓöÉ", "┐")
                       .Replace("Γöö", "└")
                       .Replace("Γöÿ", "┘")
                       .Replace("Γö£", "├")
                       .Replace("Γöñ", "┤")
                       .Replace("Γö¼", "┬")
                       .Replace("Γö┤", "┴")
                       .Replace("Γö╝", "┼");
        }
        return text;
    }

    private static TerminalLine ClassifyLine(string text, bool isError)
    {
        text = SanitizeTerminalText(text);
        var trimmed = text.TrimStart();

        if (trimmed.StartsWith("Passed ", StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("[PASS]",    StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("✓")
         || trimmed.Contains("✔"))
            return new TerminalLine(text, TerminalLineKind.Pass);

        if (trimmed.StartsWith("Failed ", StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("[FAIL]",    StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("✗")
         || trimmed.Contains("✘"))
            return new TerminalLine(text, TerminalLineKind.Fail);

        if (trimmed.StartsWith("Passed!", StringComparison.OrdinalIgnoreCase))
            return new TerminalLine(text, TerminalLineKind.PassSummary);

        if (trimmed.StartsWith("Failed!", StringComparison.OrdinalIgnoreCase))
            return new TerminalLine(text, TerminalLineKind.FailSummary);

        if (isError)
        {
            // Filter out benign diagnostic chatter that native tools (adb, monkey) emit to stderr
            if (trimmed.Contains("file pulled", StringComparison.OrdinalIgnoreCase) ||
                trimmed.StartsWith("args:", StringComparison.OrdinalIgnoreCase) ||
                trimmed.StartsWith("arg:", StringComparison.OrdinalIgnoreCase) ||
                trimmed.StartsWith("data=", StringComparison.OrdinalIgnoreCase))
            {
                return new TerminalLine(text, TerminalLineKind.Normal);
            }

            return new TerminalLine(text, TerminalLineKind.Error);
        }

        return new TerminalLine(text, TerminalLineKind.Normal);
    }

    private static string LineColor(TerminalLineKind kind) => kind switch
    {
