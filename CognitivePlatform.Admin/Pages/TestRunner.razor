                <MudPaper Elevation="0"
                          Style="background:#2d2d2d;padding:8px 16px;margin-top:2px;border-radius:0 0 4px 4px;font-family:'Cascadia Code','Consolas',monospace;font-size:0.85rem;">
                    <span style="color:@(_windowsFailed == 0 ? "#4ec9b0" : "#ff6b6b")">
                        @_windowsPassed / @(_windowsPassed + _windowsFailed) passed
