    private sealed class FailedTestDetails
    {
        public string Project { get; set; } = "";
        public string TestName { get; set; } = "";
        public List<string> Output { get; } = new();
    }

    private static List<FailedTestDetails> ParseFailedTests(TerminalLine[] lines, string defaultSuiteName = "Unknown")
    {
        var failedTests = new List<FailedTestDetails>();
        string currentProject = defaultSuiteName;
        FailedTestDetails? currentFailedTest = null;

        for (int i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            var text = line.Text;
            var trimmed = text.Trim();

            if (trimmed.StartsWith("=== Running tests for:") && trimmed.EndsWith("==="))
            {
                currentProject = trimmed.Substring(22, trimmed.Length - 25).Trim();
                currentFailedTest = null;
                continue;
            }

            if (trimmed.StartsWith(">>> PHASE", StringComparison.OrdinalIgnoreCase))
            {
                currentProject = trimmed.Substring(4).Trim();
                currentFailedTest = null;
                continue;
            }

            // Check if line indicates a test or step failure
            bool isFailLine = line.Kind == TerminalLineKind.Fail
                           || trimmed.StartsWith("Failed ", StringComparison.OrdinalIgnoreCase)
                           || trimmed.Contains("[FAIL]", StringComparison.OrdinalIgnoreCase)
                           || trimmed.StartsWith("FAIL:", StringComparison.OrdinalIgnoreCase)
                           || trimmed.StartsWith("[-]", StringComparison.OrdinalIgnoreCase)
                           || trimmed.Contains("✗")
                           || trimmed.Contains("✘");

            bool isSummaryLine = trimmed.StartsWith("Failed!", StringComparison.OrdinalIgnoreCase)
                              || trimmed.StartsWith("Test Run Failed", StringComparison.OrdinalIgnoreCase)
                              || trimmed.StartsWith("Total tests:", StringComparison.OrdinalIgnoreCase)
                              || trimmed.StartsWith("Failed:", StringComparison.OrdinalIgnoreCase)
                              || trimmed.StartsWith("Passed:", StringComparison.OrdinalIgnoreCase)
                              || trimmed.StartsWith("Total time:", StringComparison.OrdinalIgnoreCase)
                              || trimmed.StartsWith("Finished in", StringComparison.OrdinalIgnoreCase);

            if (isFailLine && !isSummaryLine)
            {
                string namePart = trimmed;
                if (namePart.StartsWith("[xUnit.net", StringComparison.OrdinalIgnoreCase))
                {
                    int closeBracket = namePart.IndexOf(']');
                    if (closeBracket >= 0 && closeBracket < namePart.Length - 1)
                    {
                        namePart = namePart.Substring(closeBracket + 1).Trim();
                    }
                    if (namePart.EndsWith("[FAIL]", StringComparison.OrdinalIgnoreCase))
                    {
                        namePart = namePart.Substring(0, namePart.Length - 6).Trim();
                    }
                }
                else if (namePart.StartsWith("Failed ", StringComparison.OrdinalIgnoreCase))
                {
                    namePart = namePart.Substring(7).Trim();
                }
                else if (namePart.StartsWith("[FAIL]", StringComparison.OrdinalIgnoreCase))
                {
                    namePart = namePart.Substring(6).Trim();
                }
                else if (namePart.StartsWith("FAIL:", StringComparison.OrdinalIgnoreCase))
                {
                    namePart = namePart.Substring(5).Trim();
                }
                else if (namePart.StartsWith("[-]", StringComparison.OrdinalIgnoreCase))
                {
                    namePart = namePart.Substring(3).Trim();
                }

                // Strip trailing duration like "[12 ms]"
                int bracketIdx = namePart.LastIndexOf('[');
                if (bracketIdx > 0 && namePart.EndsWith("]"))
                {
                    namePart = namePart.Substring(0, bracketIdx).Trim();
                }

                var cleanName = string.IsNullOrWhiteSpace(namePart) ? "Failed Step / Test" : namePart;

                var existing = failedTests.FirstOrDefault(t => t.Project == currentProject && t.TestName == cleanName);
                if (existing != null)
                {
                    currentFailedTest = existing;
                }
                else
                {
                    currentFailedTest = new FailedTestDetails
                    {
                        Project = currentProject,
                        TestName = cleanName
                    };
                    failedTests.Add(currentFailedTest);
                }
                continue;
            }

            if (line.Kind == TerminalLineKind.Pass || trimmed.StartsWith("Passed ", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("[PASS]"))
            {
                currentFailedTest = null;
                continue;
            }

            if (isSummaryLine)
            {
                currentFailedTest = null;
                continue;
            }

            if (currentFailedTest != null)
            {
                if (!string.IsNullOrWhiteSpace(text))
                {
                    currentFailedTest.Output.Add(text);
                }
            }
        }

        // Fallback: If no structured test failure markers were matched, but error lines exist:
        if (failedTests.Count == 0)
        {
            var problemLines = lines.Where(l => l.Kind == TerminalLineKind.Error || l.Kind == TerminalLineKind.Fail)
                                    .Where(l => !l.Text.Contains("file pulled", StringComparison.OrdinalIgnoreCase) &&
                                                !l.Text.StartsWith("args:", StringComparison.OrdinalIgnoreCase) &&
                                                !l.Text.StartsWith("arg:", StringComparison.OrdinalIgnoreCase) &&
                                                !l.Text.StartsWith("data=", StringComparison.OrdinalIgnoreCase))
                                    .ToList();
            if (problemLines.Count > 0)
            {
                var errorSummary = new FailedTestDetails
                {
                    Project = currentProject,
                    TestName = "Execution Failure / Error Output"
                };
                foreach (var pl in problemLines)
                {
                    errorSummary.Output.Add(pl.Text);
                }
                failedTests.Add(errorSummary);
            }
        }

        return failedTests;
    }

    private static void AppendFailureSummaryToTerminal(ITerminalStateService terminalService, string terminalId, List<FailedTestDetails> failedTests)
    {
        if (failedTests.Count == 0) return;

        terminalService.AppendLine(terminalId, new TerminalLine(string.Empty));
        terminalService.AppendLine(terminalId, new TerminalLine("==================================================================", TerminalLineKind.FailSummary));
        terminalService.AppendLine(terminalId, new TerminalLine($"                FAILED TESTS SUMMARY ({failedTests.Count} FAILURE{(failedTests.Count == 1 ? "" : "S")})                ", TerminalLineKind.FailSummary));
        terminalService.AppendLine(terminalId, new TerminalLine("==================================================================", TerminalLineKind.FailSummary));

        var grouped = failedTests.GroupBy(t => t.Project);
        foreach (var group in grouped)
        {
            terminalService.AppendLine(terminalId, new TerminalLine(string.Empty));
            terminalService.AppendLine(terminalId, new TerminalLine($"📁 Project / Suite: {group.Key}", TerminalLineKind.Normal));
            terminalService.AppendLine(terminalId, new TerminalLine("------------------------------------------------------------------", TerminalLineKind.Normal));

            foreach (var test in group)
            {
                terminalService.AppendLine(terminalId, new TerminalLine($"❌ {test.TestName}", TerminalLineKind.Fail));

                if (test.Output.Count > 0)
                {
                    var meaningfulLines = test.Output
                                              .Where(l => !string.IsNullOrWhiteSpace(l.Trim()))
                                              .Where(l => !l.Trim().StartsWith("Failed " + test.TestName, StringComparison.OrdinalIgnoreCase))
                                              .ToList();

                    if (meaningfulLines.Count > 0)
                    {
                        foreach (var outputLine in meaningfulLines)
                        {
                            var trimmed = outputLine.Trim();

                            if (trimmed.StartsWith("Error Message:", StringComparison.OrdinalIgnoreCase) ||
                                trimmed.StartsWith("Assert.", StringComparison.OrdinalIgnoreCase) ||
                                trimmed.StartsWith("Expected", StringComparison.OrdinalIgnoreCase) ||
                                trimmed.StartsWith("System.", StringComparison.OrdinalIgnoreCase) ||
                                trimmed.StartsWith("Moq.", StringComparison.OrdinalIgnoreCase) ||
                                trimmed.StartsWith("Stack Trace:", StringComparison.OrdinalIgnoreCase) ||
                                trimmed.StartsWith("Exception:", StringComparison.OrdinalIgnoreCase))
                            {
                                terminalService.AppendLine(terminalId, new TerminalLine($"   ▶ {trimmed}", TerminalLineKind.Error));
                            }
                            else
                            {
                                terminalService.AppendLine(terminalId, new TerminalLine($"     {trimmed}", TerminalLineKind.Normal));
                            }
                        }
                    }
                    else
                    {
                        terminalService.AppendLine(terminalId, new TerminalLine("     (No additional failure output captured)", TerminalLineKind.Normal));
                    }
                }
                else
                {
                    terminalService.AppendLine(terminalId, new TerminalLine("     (No failure output captured)", TerminalLineKind.Normal));
                }

                terminalService.AppendLine(terminalId, new TerminalLine(string.Empty));
            }
        }
        terminalService.AppendLine(terminalId, new TerminalLine("==================================================================", TerminalLineKind.FailSummary));
    }

    private static bool IsApiPortActive()
    {
        try
        {
            using var tcp = new System.Net.Sockets.TcpClient();
            var result = tcp.BeginConnect("localhost", 5273, null, null);
            var success = result.AsyncWaitHandle.WaitOne(TimeSpan.FromMilliseconds(500));
            if (!success) return false;
            tcp.EndConnect(result);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private sealed class ApiLifecycle : IAsyncDisposable
    {
        private Process? _process;
        private readonly ITerminalStateService _terminalService;
        private readonly string _terminalId;

        public ApiLifecycle(ITerminalStateService terminalService, string terminalId)
        {
            _terminalService = terminalService;
            _terminalId = terminalId;
        }

        public static void KillOrphanedProcesses()
        {
            var processNames = new[]
            {
                "CognitivePlatform.Api",
                "LocalAIAssistant.Ui.Maui",
                "WatchList.Ui.Maui",
                "InsAndOuts.Ui.Maui",
                "ValidationPlatform.Runner"
            };

            foreach (var name in processNames)
            {
                try
                {
                    foreach (var proc in Process.GetProcessesByName(name))
                    {
                        try { proc.Kill(entireProcessTree: true); } catch { }
                    }
                }
                catch { }
            }
        }

        public async Task StartIfNeededAsync()
        {
            if (IsApiPortActive())
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[API is already running on port 5273. Using existing instance.]", TerminalLineKind.Normal));
                return;
            }

            // Ensure any orphaned/dangling test or API processes from prior runs are cleaned up first
            KillOrphanedProcesses();

            _terminalService.AppendLine(_terminalId, new TerminalLine("[Starting local API on port 5273...]", TerminalLineKind.Normal));

            var exePath = @"C:\Users\benho\source\repos\CognitivePlatform\CognitivePlatform\bin\Debug\net10.0\CognitivePlatform.Api.exe";
            var startInfo = new ProcessStartInfo
            {
                FileName = exePath,
                Arguments = "--urls \"http://0.0.0.0:5273;http://localhost:5273;http://192.168.0.33:5273\"",
                WorkingDirectory = Path.GetDirectoryName(exePath),
                UseShellExecute = false,
                CreateNoWindow = true,
                RedirectStandardOutput = false,
                RedirectStandardError = false
            };
            startInfo.EnvironmentVariables["ASPNETCORE_ENVIRONMENT"] = "Development";

            _process = new Process { StartInfo = startInfo };
            _process.Start();

            // Wait for port 5273 to become active (up to 15 seconds)
            var limit = DateTime.UtcNow.AddSeconds(15);
            bool started = false;
            while (DateTime.UtcNow < limit)
            {
                await Task.Delay(500);
                if (IsApiPortActive())
                {
                    started = true;
                    break;
                }
                if (_process.HasExited)
                {
                    break;
                }
            }

            if (started)
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[API started successfully on port 5273.]", TerminalLineKind.Normal));
            }
            else
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[Warning: API failed to start or port 5273 did not activate in time.]", TerminalLineKind.Error));
            }
        }

        public async ValueTask DisposeAsync()
        {
            if (_process != null && !_process.HasExited)
            {
                _terminalService.AppendLine(_terminalId, new TerminalLine("[Stopping local API...]", TerminalLineKind.Normal));
                try
                {
                    _process.Kill(entireProcessTree: true);
                    await _process.WaitForExitAsync();
                    _terminalService.AppendLine(_terminalId, new TerminalLine("[API stopped.]", TerminalLineKind.Normal));
                }
                catch (Exception ex)
                {
                    _terminalService.AppendLine(_terminalId, new TerminalLine($"[Error stopping API: {ex.Message}]", TerminalLineKind.Error));
                }
                _process.Dispose();
            }

            // Always call process cleanup to be absolutely sure no test or child process remains orphaned
            KillOrphanedProcesses();
        }
    }

    // ── Disposal ──────────────────────────────────────────────────────────────────

    public ValueTask DisposeAsync()
    {
        TerminalService.StateChanged -= OnTerminalChanged;
        return ValueTask.CompletedTask;
    }
}
