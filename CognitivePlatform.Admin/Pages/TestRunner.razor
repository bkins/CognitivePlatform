@page "/tests"
@using System.Diagnostics
@using CognitivePlatform.Admin.Services
@implements IAsyncDisposable
@inject IJSRuntime            Js
@inject NavigationManager     Nav
@inject ITerminalStateService TerminalService

<PageTitle>Test Runner — CP Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Test Runner</MudText>

<MudGrid Spacing="4">

    @* ── Android ──────────────────────────────────────────────────────────── *@
    @{
        var androidState = TerminalService.Get("test-android");
        var androidLines = androidState.Snapshot();
        int androidPassed = androidLines.Count(l => l.Kind == TerminalLineKind.Pass);
        int androidFailed = androidLines.Count(l => l.Kind == TerminalLineKind.Fail);
    }
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" />
                <MudText Typo="Typo.h6">Android</MudText>
                <MudSpacer />
                @if (androidState.IsRunning)
                {
                    <MudChip T="string"
                             Color="Color.Warning"
                             Icon="@Icons.Material.Filled.RunCircle"
                             Size="Size.Small">
                        @(androidState.ElapsedDisplay.Length > 0 ? androidState.ElapsedDisplay : "Running…")
                    </MudChip>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="@AbortAndroid">
                        Abort
                    </MudButton>
                }
                else if (androidState.ExitCode.HasValue)
                {
                    @if (androidState.ExitCode == 0)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle"
                                 Size="Size.Small">
                            Exit 0 — OK
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Error"
                                 Size="Size.Small">
                            Exit @androidState.ExitCode — Failed
                        </MudChip>
                    }
                }
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@androidState.IsRunning"
                           OnClick="@RunAndroidAsync">
                    Run
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           Disabled="@androidState.IsRunning"
                           OnClick="@ClearAndroid">
                    Clear
                </MudButton>
            </MudStack>

            @if (androidState.Error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Failed to start process: @androidState.Error
                </MudAlert>
            }

            <MudPaper Elevation="4"
                      Style="background:#1e1e1e;padding:16px;height:450px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:0.83rem;">
                @if (androidLines.Length == 0)
                {
                    <span style="color:#6b7280;font-style:italic">Run Android tests to see output here…</span>
                }
                else
                {
                    @foreach (var line in androidLines)
                    {
                        <div style="color:@LineColor(line.Kind);white-space:pre-wrap;line-height:1.55">@line.Text</div>
                    }
                }
                <div id="android-terminal-end"></div>
            </MudPaper>

            @if (!androidState.IsRunning && androidState.ExitCode.HasValue && (androidPassed + androidFailed) > 0)
            {
                <MudPaper Elevation="0"
                          Style="background:#2d2d2d;padding:8px 16px;margin-top:2px;border-radius:0 0 4px 4px;font-family:'Cascadia Code','Consolas',monospace;font-size:0.85rem;">
                    <span style="color:@(androidFailed == 0 ? "#4ec9b0" : "#ff6b6b")">
                        @androidPassed / @(androidPassed + androidFailed) passed
                    </span>
                    @if (androidFailed > 0)
                    {
                        <span style="color:#ff6b6b;margin-left:12px">@androidFailed failed</span>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudItem>

    @* ── Windows ──────────────────────────────────────────────────────────── *@
    @{
        var windowsState = TerminalService.Get("test-windows");
        var windowsLines = windowsState.Snapshot();
        int windowsPassed = windowsLines.Count(l => l.Kind == TerminalLineKind.Pass);
        int windowsFailed = windowsLines.Count(l => l.Kind == TerminalLineKind.Fail);
    }
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Computer" />
                <MudText Typo="Typo.h6">Windows</MudText>
                <MudSpacer />
                @if (windowsState.IsRunning)
                {
                    <MudChip T="string"
                             Color="Color.Warning"
                             Icon="@Icons.Material.Filled.RunCircle"
                             Size="Size.Small">
                        @(windowsState.ElapsedDisplay.Length > 0 ? windowsState.ElapsedDisplay : "Running…")
                    </MudChip>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="@AbortWindows">
                        Abort
                    </MudButton>
                }
                else if (windowsState.ExitCode.HasValue)
                {
                    @if (windowsState.ExitCode == 0)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle"
                                 Size="Size.Small">
                            Exit 0 — OK
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Error"
                                 Size="Size.Small">
                            Exit @windowsState.ExitCode — Failed
                        </MudChip>
                    }
                }
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@windowsState.IsRunning"
                           OnClick="@RunWindowsAsync">
                    Run
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           Disabled="@windowsState.IsRunning"
                           OnClick="@ClearWindows">
                    Clear
                </MudButton>
            </MudStack>

            @if (windowsState.Error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Failed to start process: @windowsState.Error
                </MudAlert>
            }

            <MudPaper Elevation="4"
                      Style="background:#1e1e1e;padding:16px;height:450px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:0.83rem;">
                @if (windowsLines.Length == 0)
                {
                    <span style="color:#6b7280;font-style:italic">Run Windows tests to see output here…</span>
                }
                else
                {
                    @foreach (var line in windowsLines)
                    {
                        <div style="color:@LineColor(line.Kind);white-space:pre-wrap;line-height:1.55">@line.Text</div>
                    }
                }
                <div id="windows-terminal-end"></div>
            </MudPaper>

            @if (!windowsState.IsRunning && windowsState.ExitCode.HasValue && (windowsPassed + windowsFailed) > 0)
            {
                <MudPaper Elevation="0"
                          Style="background:#2d2d2d;padding:8px 16px;margin-top:2px;border-radius:0 0 4px 4px;font-family:'Cascadia Code','Consolas',monospace;font-size:0.85rem;">
                    <span style="color:@(windowsFailed == 0 ? "#4ec9b0" : "#ff6b6b")">
                        @windowsPassed / @(windowsPassed + windowsFailed) passed
                    </span>
                    @if (windowsFailed > 0)
                    {
                        <span style="color:#ff6b6b;margin-left:12px">@windowsFailed failed</span>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudItem>

    @* ── Evaluation dashboard link ───────────────────────────────────────────── *@
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Speed" />
                <MudText Typo="Typo.h6">Model Evaluation</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           OnClick="@(() => Nav.NavigateTo("/evaluation"))">
                    Open Evaluation Dashboard
                </MudButton>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                Run the interpreter evaluator, view score history, and track training corpus progress on the Evaluation page.
            </MudText>
        </MudPaper>
    </MudItem>


</MudGrid>

@code {
    // ── Constants ─────────────────────────────────────────────────────────────────

    private const string LaaRepoDir = @"C:\Users\benho\source\repos\LocalAIAssistant";

    private static readonly string PwshExe = ResolvePwsh();

    private static string ResolvePwsh()
    {
        // 1. Well-known PowerShell 7 install paths (MSI / system-wide)
        string[] hardcoded =
        [
            @"C:\Program Files\PowerShell\7\pwsh.exe"
          , @"C:\Program Files\PowerShell\pwsh.exe"
          , Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.LocalApplicationData)
                       , @"Microsoft\WindowsApps\pwsh.exe")
        ];
        foreach (var path in hardcoded)
        {
            if (File.Exists(path)) return path;
        }

        // 2. Walk every directory in the current process PATH.
        //    Handles Store installs, winget installs, and non-standard locations.
        var pathVar = System.Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
        foreach (var dir in pathVar.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            try
            {
                var candidate = Path.Combine(dir.Trim(), "pwsh.exe");
                if (File.Exists(candidate)) return candidate;
            }
            catch { /* skip inaccessible or malformed entries */ }
        }

        // 3. PowerShell 7 not found — fall back to Windows PowerShell 5.1 which is
        //    always present on Windows and handles the same -NonInteractive -ExecutionPolicy Bypass -File syntax.
        const string ps51 = @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe";
        if (File.Exists(ps51)) return ps51;

        return "powershell"; // guaranteed to exist on any Windows machine
    }

    /// <summary>
    /// Returns the path to pwsh.exe (PowerShell 7) specifically, or null if not installed.
    /// Unlike ResolvePwsh(), this never falls back to powershell.exe — callers that
    /// require PS7 syntax must fail gracefully when this returns null.
    /// </summary>
    private static string? FindPwsh7()
    {
        string[] candidates =
        [
            @"C:\Program Files\PowerShell\7\pwsh.exe"
          , @"C:\Program Files\PowerShell\pwsh.exe"
          , Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.LocalApplicationData)
                       , @"Microsoft\WindowsApps\pwsh.exe")
        ];
        foreach (var path in candidates)
            if (File.Exists(path)) return path;

        var pathVar = System.Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
        foreach (var dir in pathVar.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            try
            {
                var candidate = Path.Combine(dir.Trim(), "pwsh.exe");
                if (File.Exists(candidate)) return candidate;
            }
            catch { /* skip inaccessible or malformed entries */ }
        }

        // PS7 not found via hardcoded paths or PATH directory scan.
        // Return the bare command name and let the OS resolve it via PATH —
        // handles non-standard install locations, winget installs, and Store
        // installs that add only a shell alias rather than a full .exe path.
        return "pwsh";
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        TerminalService.StateChanged += OnTerminalChanged;
    }

    private void OnTerminalChanged(string id)
    {
        if (id is not ("test-android" or "test-windows")) return;
        try
        {
            var endId = id == "test-android" ? "android-terminal-end" : "windows-terminal-end";
            _ = InvokeAsync(async () => { StateHasChanged(); await ScrollToBottomAsync(endId); });
        }
        catch { /* component disposed */ }
    }

    // ── Android execution ─────────────────────────────────────────────────────────

    private async Task RunAndroidAsync()
    {
        var androidState = TerminalService.Get("test-android");
        if (androidState.IsRunning) return;

        TerminalService.Clear("test-android");
        TerminalService.MarkRunning("test-android", true);

        try
        {
            // ── Step 1: check for a connected device ──────────────────────────────
            var deviceLines = new List<string>();

            TerminalService.AppendLine("test-android", new TerminalLine("$ adb devices"));
            TerminalService.AppendLine("test-android", new TerminalLine(string.Empty));

            var adbStart = new ProcessStartInfo
            {
                FileName               = "adb"
              , Arguments              = "devices"
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            var adbExitCode = await TerminalService.RunProcessAsync(
                "test-android"
              , adbStart
              , (text, isError) =>
                {
                    if (!isError) deviceLines.Add(text);
                    return new TerminalLine(text, isError ? TerminalLineKind.Error : TerminalLineKind.Normal);
                });

            if (adbExitCode is null) return; // aborted

            TerminalService.AppendLine("test-android", new TerminalLine(string.Empty));

            var hasDevice = deviceLines.Skip(1).Any(line => !string.IsNullOrWhiteSpace(line));
            if (!hasDevice)
            {
                TerminalService.AppendLine("test-android", new TerminalLine("No Android device connected.", TerminalLineKind.Error));
                TerminalService.SetExitCode("test-android", 1);
                return;
            }

            // ── Step 2: run the smoke test script ─────────────────────────────────
            var scriptPath = Path.Combine(LaaRepoDir, @"Tests\LAA.SmokeTests.Android\SmokeTest-Android.ps1");
            var psArgs     = $@"-NonInteractive -ExecutionPolicy Bypass -File ""{scriptPath}""";

            TerminalService.AppendLine("test-android", new TerminalLine($"$ pwsh {psArgs}"));
            TerminalService.AppendLine("test-android", new TerminalLine(string.Empty));

            var testStart = new ProcessStartInfo
            {
                FileName               = PwshExe
              , Arguments              = psArgs
              , WorkingDirectory       = LaaRepoDir
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            var testExitCode = await TerminalService.RunProcessAsync("test-android", testStart, ClassifyLine);
            TerminalService.SetExitCode("test-android", testExitCode);
        }
        finally
        {
            TerminalService.MarkRunning("test-android", false);
        }
    }

    private void AbortAndroid()  => TerminalService.Abort("test-android");
    private void ClearAndroid()  => TerminalService.Clear("test-android");

    // ── Windows execution ─────────────────────────────────────────────────────────

    private async Task RunWindowsAsync()
    {
        var windowsState = TerminalService.Get("test-windows");
        if (windowsState.IsRunning) return;

        TerminalService.Clear("test-windows");
        TerminalService.MarkRunning("test-windows", true);

        try
        {
            var pwsh7      = FindPwsh7();
            var scriptPath = Path.Combine(LaaRepoDir, @"Tests\LAA.SmokeTests.Windows\SmokeTest-Windows.ps1");
            var scriptDir  = Path.GetDirectoryName(scriptPath)!;
            var psArgs     = $@"-NonInteractive -ExecutionPolicy Bypass -File ""{scriptPath}""";

            TerminalService.AppendLine("test-windows", new TerminalLine($"$ {pwsh7} {psArgs}"));
            TerminalService.AppendLine("test-windows", new TerminalLine(string.Empty));

            var startInfo = new ProcessStartInfo
            {
                FileName               = pwsh7
              , Arguments              = psArgs
              , WorkingDirectory       = scriptDir
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            var exitCode = await TerminalService.RunProcessAsync("test-windows", startInfo, ClassifyLine);
            TerminalService.SetExitCode("test-windows", exitCode);
        }
        finally
        {
            TerminalService.MarkRunning("test-windows", false);
        }
    }

    private void AbortWindows()  => TerminalService.Abort("test-windows");
    private void ClearWindows()  => TerminalService.Clear("test-windows");

    // ── Helpers ───────────────────────────────────────────────────────────────────

    private static TerminalLine ClassifyLine(string text, bool isError)
    {
        if (isError) return new TerminalLine(text, TerminalLineKind.Error);

        var trimmed = text.TrimStart();

        if (trimmed.StartsWith("Passed ", StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("[PASS]",    StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("✓")
         || trimmed.Contains("✔"))
            return new TerminalLine(text, TerminalLineKind.Pass);

        if (trimmed.StartsWith("Failed ", StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("[FAIL]",    StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("✗")
         || trimmed.Contains("✘"))
            return new TerminalLine(text, TerminalLineKind.Fail);

        if (trimmed.StartsWith("Passed!", StringComparison.OrdinalIgnoreCase))
            return new TerminalLine(text, TerminalLineKind.PassSummary);

        if (trimmed.StartsWith("Failed!", StringComparison.OrdinalIgnoreCase))
            return new TerminalLine(text, TerminalLineKind.FailSummary);

        return new TerminalLine(text, TerminalLineKind.Normal);
    }

    private static string LineColor(TerminalLineKind kind) => kind switch
    {
        TerminalLineKind.Pass        => "#4ec9b0"
      , TerminalLineKind.Fail        => "#ff6b6b"
      , TerminalLineKind.Error       => "#ff6b6b"
      , TerminalLineKind.PassSummary => "#4ec9b0"
      , TerminalLineKind.FailSummary => "#ff6b6b"
      , _                            => "#d4d4d4"
    };

    private async Task ScrollToBottomAsync(string terminalEndId)
    {
        try
        {
            await Js.InvokeVoidAsync("eval"
                                   , $"var el=document.getElementById('{terminalEndId}');if(el)el.scrollIntoView({{behavior:'instant'}});");
        }
        catch { /* ignore during disposal or when DOM is not ready */ }
    }

    // ── Disposal ──────────────────────────────────────────────────────────────────

    public ValueTask DisposeAsync()
    {
        TerminalService.StateChanged -= OnTerminalChanged;
        return ValueTask.CompletedTask;
    }
}
