            }

            <MudPaper Elevation="4"
                      Style="background:#1e1e1e;padding:16px;height:450px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:0.83rem;">
                @if (_evalOutput.Count == 0)
                {
                    <span style="color:#6b7280;font-style:italic">Run the evaluator to see output here…</span>
                }
                else
