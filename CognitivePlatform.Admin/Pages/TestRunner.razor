    @* ── Score History ─────────────────────────────────────────────────────────── *@
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" />
                <MudText Typo="Typo.h6">Evaluator Score History</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@LoadScoreHistory">
                    Refresh
                </MudButton>
            </MudStack>

            @if (_scoreHistoryError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">@_scoreHistoryError</MudAlert>
            }
            else if (_scoreHistoryRows.Count == 0)
            {
                <MudText Color="Color.Secondary" Typo="Typo.body2"
                         Style="font-style:italic">
                    No eval result files found in C:\CP\Data\EvalResults\
                </MudText>
            }
            else
            {
                <MudTable T="ScoreRow" Items="@_scoreHistoryRows" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Model</MudTh>
                        <MudTh Style="text-align:right">Avg Score</MudTh>
                        <MudTh Style="text-align:right">JSON Fails</MudTh>
                        <MudTh Style="text-align:right">Param Fails</MudTh>
                        <MudTh Style="text-align:right">Tok/s</MudTh>
                        <MudTh Style="text-align:center">Trend</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd>@row.RunDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>@row.Model</MudTd>
                        <MudTd Style="@ScoreCellStyle(row)" class="text-right">@row.AvgScore.ToString("F1")</MudTd>
                        <MudTd Style="text-align:right">@row.JsonFails</MudTd>
                        <MudTd Style="text-align:right">@row.ParamFails</MudTd>
                        <MudTd Style="text-align:right">@row.TokPerSecond.ToString("F1")</MudTd>
                        <MudTd Style="text-align:center;font-size:1.1rem">@TrendArrow(row)</MudTd>
