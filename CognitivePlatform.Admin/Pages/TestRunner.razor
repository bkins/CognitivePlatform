</MudGrid>

@code {
    // ── Types ─────────────────────────────────────────────────────────────────────

    private sealed record OutputLine(string Text, LineKind Kind = LineKind.Normal);

    private enum LineKind
    {
        Normal
      , Error
      , Pass
      , Fail
      , PassSummary
      , FailSummary
    }

    // ── Constants ─────────────────────────────────────────────────────────────────

    private const string LaaRepoDir = @"C:\Users\benho\source\repos\LocalAIAssistant";
    private const string CpRepoDir   = @"C:\Users\benho\source\repos\CognitivePlatform";

    private static readonly string PwshExe = ResolvePwsh();

    private static string ResolvePwsh()
    {
        // 1. Well-known PowerShell 7 install paths (MSI / system-wide)
        string[] hardcoded =
        [
            @"C:\Program Files\PowerShell\7\pwsh.exe"
          , @"C:\Program Files\PowerShell\pwsh.exe"
          , Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.LocalApplicationData)
                       , @"Microsoft\WindowsApps\pwsh.exe")
        ];
        foreach (var path in hardcoded)
        {
            if (File.Exists(path)) return path;
        }

        // 2. Walk every directory in the current process PATH.
        //    Handles Store installs, winget installs, and non-standard locations.
        var pathVar = System.Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
        foreach (var dir in pathVar.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            try
            {
                var candidate = Path.Combine(dir.Trim(), "pwsh.exe");
                if (File.Exists(candidate)) return candidate;
            }
            catch { /* skip inaccessible or malformed entries */ }
        }

        // 3. PowerShell 7 not found — fall back to Windows PowerShell 5.1 which is
        //    always present on Windows and handles the same -NonInteractive -ExecutionPolicy Bypass -File syntax.
        const string ps51 = @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe";
        if (File.Exists(ps51)) return ps51;

        return "powershell"; // guaranteed to exist on any Windows machine
    }

    /// <summary>
    /// Returns the path to pwsh.exe (PowerShell 7) specifically, or null if not installed.
    /// Unlike ResolvePwsh(), this never falls back to powershell.exe — callers that
    /// require PS7 syntax must fail gracefully when this returns null.
    /// </summary>
    private static string? FindPwsh7()
    {
        string[] candidates =
        [
            @"C:\Program Files\PowerShell\7\pwsh.exe"
          , @"C:\Program Files\PowerShell\pwsh.exe"
          , Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.LocalApplicationData)
                       , @"Microsoft\WindowsApps\pwsh.exe")
        ];
        foreach (var path in candidates)
            if (File.Exists(path)) return path;

        var pathVar = System.Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
        foreach (var dir in pathVar.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            try
            {
                var candidate = Path.Combine(dir.Trim(), "pwsh.exe");
                if (File.Exists(candidate)) return candidate;
            }
            catch { /* skip */ }
        }
        return null;
    }

    // ── Android state ─────────────────────────────────────────────────────────────

    private readonly List<OutputLine>    _androidOutput   = [];
    private bool                         _androidRunning;
    private int?                         _androidExitCode;
    private string?                      _androidRunError;
    private int                          _androidPassed;
    private int                          _androidFailed;
    private Process?                     _androidProcess;
    private CancellationTokenSource?     _androidCts;

    // ── Windows state ─────────────────────────────────────────────────────────────

    private readonly List<OutputLine>    _windowsOutput   = [];
    private bool                         _windowsRunning;
    private int?                         _windowsExitCode;
    private string?                      _windowsRunError;
    private int                          _windowsPassed;
    private int                          _windowsFailed;
    private Process?                     _windowsProcess;
    private CancellationTokenSource?     _windowsCts;

    // ── Evaluator state ───────────────────────────────────────────────────────────

    private readonly List<OutputLine>    _evalOutput   = [];
    private bool                         _evalRunning;
    private int?                         _evalExitCode;
    private string?                      _evalRunError;
    private Process?                     _evalProcess;
    private CancellationTokenSource?     _evalCts;

    // ── Android execution ─────────────────────────────────────────────────────────

    private async Task RunAndroidAsync()
    {
        if (_androidRunning) return;

        _androidRunning  = true;
        _androidExitCode = null;
        _androidRunError = null;
        _androidPassed   = 0;
        _androidFailed   = 0;
        _androidOutput.Clear();
        _androidCts = new CancellationTokenSource();

        StateHasChanged();

        try
        {
            // ── Step 1: check for a connected device ──────────────────────────────
            var deviceLines = new List<string>();

            _androidOutput.Add(new("$ adb devices", LineKind.Normal));
            _androidOutput.Add(new(string.Empty, LineKind.Normal));
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync("android-terminal-end");

            var adbStart = new ProcessStartInfo
            {
                FileName               = "adb"
              , Arguments              = "devices"
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            _androidProcess = new Process { StartInfo = adbStart };

            _androidProcess.OutputDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() =>
                {
                    deviceLines.Add(eventArgs.Data);
                    _androidOutput.Add(new(eventArgs.Data, LineKind.Normal));
                    StateHasChanged();
                });
                await ScrollToBottomAsync("android-terminal-end");
            };

            _androidProcess.ErrorDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() => { _androidOutput.Add(new(eventArgs.Data, LineKind.Error)); StateHasChanged(); });
                await ScrollToBottomAsync("android-terminal-end");
            };

            var adbAborted = false;
            try
            {
                _androidProcess.Start();
                _androidProcess.BeginOutputReadLine();
                _androidProcess.BeginErrorReadLine();
                await _androidProcess.WaitForExitAsync(_androidCts.Token);
            }
            catch (OperationCanceledException)
            {
                _androidOutput.Add(new("[Aborted by user]", LineKind.Error));
                adbAborted = true;
            }
            catch (Exception ex)
            {
                _androidRunError = ex.Message;
                _androidOutput.Add(new($"[Error: {ex.Message}]", LineKind.Error));
                adbAborted = true;
            }
            finally
            {
                _androidProcess?.Dispose();
                _androidProcess = null;
            }

            if (adbAborted) return;

            _androidOutput.Add(new(string.Empty, LineKind.Normal));

            // Lines after the "List of devices attached" header that are non-empty indicate attached devices
            var hasDevice = deviceLines
                .Skip(1)
                .Any(line => !string.IsNullOrWhiteSpace(line));

            if (!hasDevice)
            {
                _androidOutput.Add(new("No Android device connected.", LineKind.Error));
                await InvokeAsync(StateHasChanged);
                await ScrollToBottomAsync("android-terminal-end");
                return;
            }

            // ── Step 2: run the smoke test script ─────────────────────────────────
            var scriptPath = Path.Combine(LaaRepoDir, @"Tests\LAA.SmokeTests.Android\SmokeTest-Android.ps1");
            var psArgs     = $@"-NonInteractive -ExecutionPolicy Bypass -File ""{scriptPath}""";

            _androidOutput.Add(new($"$ pwsh {psArgs}", LineKind.Normal));
            _androidOutput.Add(new(string.Empty, LineKind.Normal));
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync("android-terminal-end");

            var testStart = new ProcessStartInfo
            {
                FileName               = PwshExe
              , Arguments              = psArgs
              , WorkingDirectory       = LaaRepoDir
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            _androidProcess = new Process { StartInfo = testStart };

            _androidProcess.OutputDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() =>
                {
                    var kind = ClassifyLine(eventArgs.Data);
                    if (kind == LineKind.Pass) _androidPassed++;
                    else if (kind == LineKind.Fail) _androidFailed++;
                    _androidOutput.Add(new(eventArgs.Data, kind));
                    StateHasChanged();
                });
                await ScrollToBottomAsync("android-terminal-end");
            };

            _androidProcess.ErrorDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() => { _androidOutput.Add(new(eventArgs.Data, LineKind.Error)); StateHasChanged(); });
                await ScrollToBottomAsync("android-terminal-end");
            };

            try
            {
                _androidProcess.Start();
                _androidProcess.BeginOutputReadLine();
                _androidProcess.BeginErrorReadLine();
                await _androidProcess.WaitForExitAsync(_androidCts.Token);
                _androidExitCode = _androidProcess.ExitCode;
            }
            catch (OperationCanceledException)
            {
                _androidOutput.Add(new("[Aborted by user]", LineKind.Error));
            }
            catch (Exception ex)
            {
                _androidRunError = ex.Message;
                _androidOutput.Add(new($"[Error: {ex.Message}]", LineKind.Error));
            }
            finally
            {
                _androidProcess?.Dispose();
                _androidProcess = null;
            }
        }
        finally
        {
            _androidRunning = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync("android-terminal-end");
        }
    }

    private void AbortAndroid()
    {
        _androidCts?.Cancel();
        try { _androidProcess?.Kill(entireProcessTree: true); }
        catch { /* process may have already exited */ }
    }

    private void ClearAndroid()
    {
        _androidOutput.Clear();
        _androidExitCode = null;
        _androidRunError = null;
        _androidPassed   = 0;
        _androidFailed   = 0;
    }

    // ── Windows execution ─────────────────────────────────────────────────────────

    private async Task RunWindowsAsync()
    {
        if (_windowsRunning) return;

        _windowsRunning  = true;
        _windowsExitCode = null;
        _windowsRunError = null;
        _windowsPassed   = 0;
        _windowsFailed   = 0;
        _windowsOutput.Clear();
        _windowsCts = new CancellationTokenSource();

        StateHasChanged();

        // SmokeTest-Windows.ps1 uses PS7 syntax ($var::StaticMember) that Windows
        // PowerShell 5.1 cannot parse. Fail early with a clear message if PS7 is absent.
        var pwsh7 = FindPwsh7();
        if (pwsh7 is null)
        {
            _windowsOutput.Add(new("[Error: Windows smoke tests require PowerShell 7 (pwsh.exe).]", LineKind.Error));
            _windowsOutput.Add(new("[The script uses PS7-only syntax ($var::StaticMember) that Windows PowerShell 5.1 cannot parse.]", LineKind.Error));
            _windowsOutput.Add(new("[Install PowerShell 7 from: https://aka.ms/install-powershell]", LineKind.Error));
            _windowsExitCode = 1;
            _windowsRunning  = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var scriptPath = Path.Combine(LaaRepoDir, @"Tests\LAA.SmokeTests.Windows\SmokeTest-Windows.ps1");
        var scriptDir  = Path.GetDirectoryName(scriptPath)!;
        var psArgs     = $@"-NonInteractive -ExecutionPolicy Bypass -File ""{scriptPath}""";

        _windowsOutput.Add(new($"$ {pwsh7} {psArgs}", LineKind.Normal));
        _windowsOutput.Add(new(string.Empty, LineKind.Normal));
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync("windows-terminal-end");

        try
        {
            var startInfo = new ProcessStartInfo
            {
                FileName               = pwsh7
              , Arguments              = psArgs
              , WorkingDirectory       = scriptDir
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            _windowsProcess = new Process { StartInfo = startInfo };

            _windowsProcess.OutputDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() =>
                {
                    var kind = ClassifyLine(eventArgs.Data);
                    if (kind == LineKind.Pass) _windowsPassed++;
                    else if (kind == LineKind.Fail) _windowsFailed++;
                    _windowsOutput.Add(new(eventArgs.Data, kind));
                    StateHasChanged();
                });
                await ScrollToBottomAsync("windows-terminal-end");
            };

            _windowsProcess.ErrorDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() => { _windowsOutput.Add(new(eventArgs.Data, LineKind.Error)); StateHasChanged(); });
                await ScrollToBottomAsync("windows-terminal-end");
            };

            try
            {
                _windowsProcess.Start();
                _windowsProcess.BeginOutputReadLine();
                _windowsProcess.BeginErrorReadLine();
                await _windowsProcess.WaitForExitAsync(_windowsCts.Token);
                _windowsExitCode = _windowsProcess.ExitCode;
            }
            catch (OperationCanceledException)
            {
                _windowsOutput.Add(new("[Aborted by user]", LineKind.Error));
            }
            catch (Exception ex)
            {
                _windowsRunError = ex.Message;
                _windowsOutput.Add(new($"[Error: {ex.Message}]", LineKind.Error));
            }
            finally
            {
                _windowsProcess?.Dispose();
                _windowsProcess = null;
            }
        }
        finally
        {
            _windowsRunning = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync("windows-terminal-end");
        }
    }

    private void AbortWindows()
    {
        _windowsCts?.Cancel();
        try { _windowsProcess?.Kill(entireProcessTree: true); }
        catch { /* process may have already exited */ }
    }

    private void ClearWindows()
    {
        _windowsOutput.Clear();
        _windowsExitCode = null;
        _windowsRunError = null;
        _windowsPassed   = 0;
        _windowsFailed   = 0;
    }

    // ── Evaluator execution ───────────────────────────────────────────────────────

    private async Task RunEvalAsync()
    {
        if (_evalRunning) return;

        _evalRunning  = true;
        _evalExitCode = null;
        _evalRunError = null;
        _evalOutput.Clear();
        _evalCts = new CancellationTokenSource();

        StateHasChanged();

        var scriptPath = Path.Combine(CpRepoDir, @"Scripts\Run-InterpreterEval.ps1");
        var psArgs     = $@"-NonInteractive -ExecutionPolicy Bypass -File ""{scriptPath}""";

        _evalOutput.Add(new($"$ {PwshExe} {psArgs}", LineKind.Normal));
        _evalOutput.Add(new(string.Empty, LineKind.Normal));
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync("eval-terminal-end");

        try
        {
            var startInfo = new ProcessStartInfo
            {
                FileName               = PwshExe
              , Arguments              = psArgs
              , WorkingDirectory       = CpRepoDir
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            _evalProcess = new Process { StartInfo = startInfo };

            _evalProcess.OutputDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() =>
                {
                    _evalOutput.Add(new(eventArgs.Data, ClassifyLine(eventArgs.Data)));
                    StateHasChanged();
                });
                await ScrollToBottomAsync("eval-terminal-end");
            };

            _evalProcess.ErrorDataReceived += async (_, eventArgs) =>
            {
                if (eventArgs.Data is null) return;
                await InvokeAsync(() => { _evalOutput.Add(new(eventArgs.Data, LineKind.Error)); StateHasChanged(); });
                await ScrollToBottomAsync("eval-terminal-end");
            };

            try
            {
                _evalProcess.Start();
                _evalProcess.BeginOutputReadLine();
                _evalProcess.BeginErrorReadLine();
                await _evalProcess.WaitForExitAsync(_evalCts.Token);
                _evalExitCode = _evalProcess.ExitCode;
            }
            catch (OperationCanceledException)
            {
                _evalOutput.Add(new("[Aborted by user]", LineKind.Error));
            }
            catch (Exception ex)
            {
                _evalRunError = ex.Message;
                _evalOutput.Add(new($"[Error: {ex.Message}]", LineKind.Error));
            }
            finally
            {
                _evalProcess?.Dispose();
                _evalProcess = null;
            }
        }
        finally
        {
            _evalRunning = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync("eval-terminal-end");
        }
    }

    private void AbortEval()
    {
        _evalCts?.Cancel();
        try { _evalProcess?.Kill(entireProcessTree: true); }
        catch { /* process may have already exited */ }
    }

    private void ClearEval()
    {
        _evalOutput.Clear();
        _evalExitCode = null;
        _evalRunError = null;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────────

    private static LineKind ClassifyLine(string text)
    {
        var trimmed = text.TrimStart();

        // Individual test result lines: "  Passed TestName [50 ms]" / "  Failed TestName [12 ms]"
        if (trimmed.StartsWith("Passed ", StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("[PASS]",    StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("✓")
         || trimmed.Contains("✔"))
            return LineKind.Pass;

        if (trimmed.StartsWith("Failed ", StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("[FAIL]",    StringComparison.OrdinalIgnoreCase)
         || trimmed.Contains("✗")
         || trimmed.Contains("✘"))
            return LineKind.Fail;

        // dotnet test overall summary lines: "Passed! - Failed: 0, Passed: 12, ..."
        if (trimmed.StartsWith("Passed!", StringComparison.OrdinalIgnoreCase))
            return LineKind.PassSummary;

        if (trimmed.StartsWith("Failed!", StringComparison.OrdinalIgnoreCase))
            return LineKind.FailSummary;

        return LineKind.Normal;
    }

    private static string LineColor(LineKind kind) => kind switch
    {
        LineKind.Pass        => "#4ec9b0"
      , LineKind.Fail        => "#ff6b6b"
      , LineKind.Error       => "#ff6b6b"
      , LineKind.PassSummary => "#4ec9b0"
      , LineKind.FailSummary => "#ff6b6b"
      , _                    => "#d4d4d4"
    };

    private async Task ScrollToBottomAsync(string terminalEndId)
    {
        try
        {
            await Js.InvokeVoidAsync("eval"
                                   , $"var el=document.getElementById('{terminalEndId}');if(el)el.scrollIntoView({{behavior:'instant'}});");
        }
        catch { /* ignore during disposal or when DOM is not ready */ }
    }

    // ── Score History ─────────────────────────────────────────────────────────────

    private sealed record ScoreRow(
        DateTime RunDate
      , string   Model
      , double   AvgScore
      , int      JsonFails
      , int      ParamFails
      , double   TokPerSecond
      , bool     IsBestForModel);

    private List<ScoreRow> _scoreHistoryRows = [];
    private string?        _scoreHistoryError;

    protected override void OnInitialized() => LoadScoreHistory();

    private void LoadScoreHistory()
    {
        _scoreHistoryError = null;

        try
        {
            var rawRows = EvalResultParser.LoadAll();

            // Best avg score per model (for highlight)
            var bestScore = rawRows
                .GroupBy(row => row.Model)
                .ToDictionary(group => group.Key, group => group.Max(row => row.AvgScore));

            _scoreHistoryRows = rawRows
                .Select(row => new ScoreRow(
                    row.RunDate
                  , row.Model
                  , row.AvgScore
                  , row.JsonFails
                  , row.ParamFails
                  , row.TokPerSecond
                  , row.AvgScore == bestScore[row.Model]))
                .ToList();
        }
        catch (Exception ex)
        {
            _scoreHistoryError = ex.Message;
        }
    }

    private string ScoreCellStyle(ScoreRow row)
    {
        var color = row.IsBestForModel ? "color:#f0c040;font-weight:600" : string.Empty;
        return $"text-align:right;{color}";
    }

    private string TrendArrow(ScoreRow current)
    {
        // Find the immediately previous run for the same model
        var previous = _scoreHistoryRows
            .Where(row => row.Model == current.Model && row.RunDate < current.RunDate)
            .OrderByDescending(row => row.RunDate)
            .FirstOrDefault();

        if (previous is null) return string.Empty;

        var delta = current.AvgScore - previous.AvgScore;

        if (delta > 0.5)  return "↑";
        if (delta < -0.5) return "↓";
        return "=";
    }

    // ── Disposal ──────────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        _androidCts?.Cancel();
        _androidCts?.Dispose();
        try { _androidProcess?.Kill(entireProcessTree: true); }
        catch { /* ignore */ }
        _androidProcess?.Dispose();

        _windowsCts?.Cancel();
        _windowsCts?.Dispose();
        try { _windowsProcess?.Kill(entireProcessTree: true); }
        catch { /* ignore */ }
        _windowsProcess?.Dispose();

        _evalCts?.Cancel();
        _evalCts?.Dispose();
        try { _evalProcess?.Kill(entireProcessTree: true); }
        catch { /* ignore */ }
        _evalProcess?.Dispose();
    }
