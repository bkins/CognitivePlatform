@page "/tests"
@using System.Diagnostics
@using CognitivePlatform.Admin.Services
@implements IAsyncDisposable
@inject IJSRuntime Js

<PageTitle>Test Runner — CP Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Test Runner</MudText>

<MudGrid Spacing="4">

    @* ── Android ──────────────────────────────────────────────────────────── *@
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" />
                <MudText Typo="Typo.h6">Android</MudText>
                <MudSpacer />
                @if (_androidRunning)
                {
                    <MudChip T="string"
                             Color="Color.Warning"
                             Icon="@Icons.Material.Filled.RunCircle"
                             Size="Size.Small">
                        Running…
                    </MudChip>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="@AbortAndroid">
                        Abort
                    </MudButton>
                }
                else if (_androidExitCode.HasValue)
                {
                    @if (_androidExitCode == 0)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle"
                                 Size="Size.Small">
                            Exit 0 — OK
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Error"
                                 Size="Size.Small">
                            Exit @_androidExitCode — Failed
                        </MudChip>
                    }
                }
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@_androidRunning"
                           OnClick="@RunAndroidAsync">
                    Run
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           Disabled="@_androidRunning"
                           OnClick="@ClearAndroid">
                    Clear
                </MudButton>
            </MudStack>

            @if (_androidRunError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Failed to start process: @_androidRunError
                </MudAlert>
            }

            <MudPaper Elevation="4"
                      Style="background:#1e1e1e;padding:16px;height:450px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:0.83rem;">
                @if (_androidOutput.Count == 0)
                {
                    <span style="color:#6b7280;font-style:italic">Run Android tests to see output here…</span>
                }
                else
                {
                    @foreach (var line in _androidOutput)
                    {
                        <div style="color:@LineColor(line.Kind);white-space:pre-wrap;line-height:1.55">@line.Text</div>
                    }
                }
                <div id="android-terminal-end"></div>
            </MudPaper>

            @if (!_androidRunning && _androidExitCode.HasValue && (_androidPassed + _androidFailed) > 0)
            {
                <MudPaper Elevation="0"
                          Style="background:#2d2d2d;padding:8px 16px;margin-top:2px;border-radius:0 0 4px 4px;font-family:'Cascadia Code','Consolas',monospace;font-size:0.85rem;">
                    <span style="color:@(_androidFailed == 0 ? "#4ec9b0" : "#ff6b6b")">
                        @_androidPassed / @(_androidPassed + _androidFailed) passed
                    </span>
                    @if (_androidFailed > 0)
                    {
                        <span style="color:#ff6b6b;margin-left:12px">@_androidFailed failed</span>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudItem>

    @* ── Windows ──────────────────────────────────────────────────────────── *@
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Computer" />
                <MudText Typo="Typo.h6">Windows</MudText>
                <MudSpacer />
                @if (_windowsRunning)
                {
                    <MudChip T="string"
                             Color="Color.Warning"
                             Icon="@Icons.Material.Filled.RunCircle"
                             Size="Size.Small">
                        Running…
                    </MudChip>
                    <MudButton Variant="Variant.Outlined"
