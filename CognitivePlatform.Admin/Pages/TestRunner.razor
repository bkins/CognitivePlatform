@page "/tests"
@using System.Diagnostics
@using System.IO
@using CognitivePlatform.Admin.Services
@implements IAsyncDisposable
@inject IJSRuntime            Js
@inject NavigationManager     Nav
@inject ITerminalStateService TerminalService
@inject IConfiguration        Configuration
@inject IPowerShellResolver   PowerShellResolver

<PageTitle>Test Runner — CP Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Test Runner</MudText>

<MudGrid Spacing="4">

    @* ── All System Tests (Full CP Universe) ───────────────────────────────── *@
    @{
        var allTestsState = TerminalService.Get("test-all-system-tests");
        var allTestsLines = allTestsState.Snapshot();
        int allTestsPassed = allTestsLines.Count(l => l.Kind == TerminalLineKind.Pass);
        int allTestsFailed = allTestsLines.Count(l => l.Kind == TerminalLineKind.Fail);
    }
    <MudItem xs="12">
        <MudPaper Elevation="3" Class="pa-4" Style="border: 1px solid #336699; background: #1a2233;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: bold; color: #64b5f6;">All System Tests — Full CP Universe</MudText>
                    <MudText Typo="Typo.caption" Style="color: #90caf9;">Runs every test across all 11 repositories: Unit, Controller Integration, E2E NL Flows, API Probes, UI Smoke, and System Invariant Audit.</MudText>
                </div>
                <MudSpacer />
                @if (allTestsState.IsRunning)
                {
                    <MudChip T="string"
                             Color="Color.Warning"
                             Icon="@Icons.Material.Filled.RunCircle"
                             Size="Size.Medium">
                        @(allTestsState.ElapsedDisplay.Length > 0 ? allTestsState.ElapsedDisplay : "Running Universe Suite…")
                    </MudChip>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Medium"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="@AbortAllSystemTests">
                        Abort
                    </MudButton>
                }
                else if (allTestsState.ExitCode.HasValue)
                {
                    @if (allTestsState.ExitCode == 0)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle"
                                 Size="Size.Medium">
                            Exit 0 — All Passed
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Error"
                                 Size="Size.Medium">
                            Exit @allTestsState.ExitCode — Failures Found
                        </MudChip>
                    }
                }
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.PlayCircleFilled"
                           Disabled="@allTestsState.IsRunning"
                           OnClick="@RunAllSystemTestsAsync">
                    Run All Tests
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           Disabled="@allTestsState.IsRunning"
                           OnClick="@ClearAllSystemTests">
                    Clear
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Disabled="@(allTestsLines.Length == 0)"
                           OnClick="@(() => CopyTerminalAsync("test-all-system-tests"))">
                    Copy Log
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Disabled="@(allTestsLines.Length == 0)"
                           OnClick="@(() => CopyFailuresSummaryAsync("test-all-system-tests"))">
                    Copy Failures
                </MudButton>
            </MudStack>

            @if (allTestsState.Error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Failed to execute universe tests: @allTestsState.Error
                </MudAlert>
            }

            <TerminalOutput Terminal="@allTestsState"
                            Height="400px"
                            Placeholder="Click 'Run All Tests' to execute the complete universe test suite across all 11 repositories…"
                            ContainerId="all-system-tests-terminal-container"
                            EndElementId="all-system-tests-terminal-end"
                            OnScreenshotClicked="@ShowScreenshot" />

            @if (!allTestsState.IsRunning && allTestsState.ExitCode.HasValue && (allTestsPassed + allTestsFailed) > 0)
            {
                <MudPaper Elevation="0"
                          Style="background:#2d2d2d;padding:8px 16px;margin-top:2px;border-radius:0 0 4px 4px;font-family:'Cascadia Code','Consolas',monospace;font-size:0.85rem;">
                    <span style="color:@(allTestsFailed == 0 ? "#4ec9b0" : "#ff6b6b")">
                        @allTestsPassed / @(allTestsPassed + allTestsFailed) passed
                    </span>
                    @if (allTestsFailed > 0)
                    {
                        <span style="color:#ff6b6b;margin-left:12px">@allTestsFailed failed</span>
                    }
                </MudPaper>

                var failedUniverseList = ParseFailedTests(allTestsLines, "All System Tests");
                @if (failedUniverseList.Count > 0)
                {
                    <MudExpansionPanels Class="mt-3">
                        <MudExpansionPanel Title="Failed Tests Summary" Style="background:#2d2d2d; color:#ff6b6b;">
                            <div style="font-family:'Cascadia Code','Consolas',monospace;font-size:0.8rem;max-height:300px;overflow-y:auto;">
                                @foreach (var test in failedUniverseList)
                                {
                                    <div class="mb-2" style="border-bottom: 1px solid #3e3e42; padding-bottom: 8px;">
                                        <div style="font-weight:bold;color:#ff6b6b;">[@test.Project] @test.TestName</div>
                                        <div style="color:#d4d4d4;font-size:0.75rem;white-space:pre-wrap;margin-top:4px;">
                                            @string.Join(System.Environment.NewLine, test.Output.Take(5))
                                            @if (test.Output.Count > 5)
                                            {
                                                <span>...</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            }
        </MudPaper>
    </MudItem>

    @* ── Android ──────────────────────────────────────────────────────────── *@
    @{
        var androidState = TerminalService.Get("test-android");
        var androidLines = androidState.Snapshot();
        int androidPassed = androidLines.Count(l => l.Kind == TerminalLineKind.Pass);
        int androidFailed = androidLines.Count(l => l.Kind == TerminalLineKind.Fail);
