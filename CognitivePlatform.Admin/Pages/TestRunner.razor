    private async Task CopyTerminalAsync(string id)
    {
        var state = TerminalService.Get(id);
        var text = string.Join(System.Environment.NewLine, state.Snapshot().Select(l => l.Text));
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private async Task CopyFailuresSummaryAsync(string id)
    {
        var state = TerminalService.Get(id);
        var suiteTitle = id switch
        {
            "test-all-system-tests" => "All System Tests",
            "test-android"          => "Android Smoke Tests",
            "test-windows"          => "Windows Smoke Tests",
            "test-cognitive-api"    => "Cognitive API Validation",
            "test-unit-tests"       => "Unit Tests",
            "test-system-audit"     => "System Invariant & Architecture Audit",
            _                       => id
        };

        var failedTests = ParseFailedTests(state.Snapshot(), suiteTitle);
        if (failedTests.Count == 0)
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"No test failures detected for {suiteTitle}.");
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# {suiteTitle} — Failures Summary ({failedTests.Count} Failed {(failedTests.Count == 1 ? "Item" : "Items")})");
        sb.AppendLine();
        foreach (var test in failedTests)
        {
            sb.AppendLine($"### ❌ [{test.Project}] {test.TestName}");
            if (test.Output.Count > 0)
            {
                sb.AppendLine("```");
                foreach (var line in test.Output.Take(15))
                {
                    sb.AppendLine(line);
                }
                if (test.Output.Count > 15)
                {
                    sb.AppendLine("...");
                }
                sb.AppendLine("```");
            }
            sb.AppendLine();
        }

        await Js.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString().TrimEnd());
    }

    private static bool TryExtractPngPath(string text, out string path)
    {
        path = string.Empty;
        if (string.IsNullOrWhiteSpace(text)) return false;
        var idx = text.IndexOf(".png", StringComparison.OrdinalIgnoreCase);
        if (idx == -1) return false;

        var match = System.Text.RegularExpressions.Regex.Match(text, @"[A-Za-z]:\\[^\s]+\.png");
        if (match.Success)
        {
            path = match.Value;
            return true;
        }
        return false;
    }

