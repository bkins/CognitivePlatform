        if (filename.Contains("DemoSetup", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("ValidationPlatform.Runner", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("Seeder", StringComparison.OrdinalIgnoreCase))
