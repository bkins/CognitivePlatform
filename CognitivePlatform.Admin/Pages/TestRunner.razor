    private string LaaRepoDir => Configuration["SystemPaths:LocalAIAssistantRepo"] ?? @"C:\Users\benho\source\repos\LocalAIAssistant";

    private string PwshExe => PowerShellResolver.ResolvePwsh();

    private string? FindPwsh7() => PowerShellResolver.FindPwsh7();

    // ── Lifecycle ─────────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        TerminalService.StateChanged += OnTerminalChanged;
    }

    private void OnTerminalChanged(string id)
    {
        if (id is not ("test-all-system-tests" or "test-android" or "test-windows" or "test-cognitive-api" or "test-unit-tests" or "test-system-audit")) return;
        try
        {
            var containerId = id switch
            {
                "test-all-system-tests" => "all-system-tests-terminal-container",
                "test-android"          => "android-terminal-container",
                "test-windows"          => "windows-terminal-container",
                "test-cognitive-api"    => "cognitive-terminal-container",
                "test-unit-tests"       => "unit-tests-terminal-container",
                "test-system-audit"     => "system-audit-terminal-container",
                _ => ""
            };
            _ = InvokeAsync(async () => { StateHasChanged(); await ScrollToBottomAsync(containerId); });
        }
        catch { /* component disposed */ }
    }

    // ── Android execution ─────────────────────────────────────────────────────────

    private async Task RunAndroidAsync()
    {
        var androidState = TerminalService.Get("test-android");
        if (androidState.IsRunning) return;

        TerminalService.Clear("test-android");
        TerminalService.MarkRunning("test-android", true);

        try
        {
            await using var api = new ApiLifecycle(TerminalService, "test-android");
            await api.StartIfNeededAsync();

            // ── Step 1: check for a connected device ──────────────────────────────
            var deviceLines = new List<string>();

            TerminalService.AppendLine("test-android", new TerminalLine("$ adb devices"));
            TerminalService.AppendLine("test-android", new TerminalLine(string.Empty));

            var adbStart = new ProcessStartInfo
            {
                FileName               = "adb"
              , Arguments              = "devices"
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            var adbExitCode = await TerminalService.RunProcessAsync(
                "test-android"
              , adbStart
              , (text, isError) =>
                {
                    if (!isError) deviceLines.Add(text);
                    return new TerminalLine(text, isError ? TerminalLineKind.Error : TerminalLineKind.Normal);
                });

            if (adbExitCode is null) return; // aborted

            TerminalService.AppendLine("test-android", new TerminalLine(string.Empty));

            var hasDevice = deviceLines.Skip(1).Any(line => !string.IsNullOrWhiteSpace(line));
            if (!hasDevice)
            {
                TerminalService.AppendLine("test-android", new TerminalLine("No Android device connected.", TerminalLineKind.Error));
                TerminalService.SetExitCode("test-android", 1);
                return;
            }

            // ── Step 2: run the smoke test script ─────────────────────────────────
            var scriptPath = Path.Combine(LaaRepoDir, @"Tests\LAA.SmokeTests.Android\SmokeTest-Android.ps1");
            var psArgs     = $@"-NonInteractive -ExecutionPolicy Bypass -File ""{scriptPath}""";
            if (_forceFailureAndroid)
            {
                psArgs += " -ForceFailure";
            }

            TerminalService.AppendLine("test-android", new TerminalLine($"$ pwsh {psArgs}"));
            TerminalService.AppendLine("test-android", new TerminalLine(string.Empty));

            var testStart = new ProcessStartInfo
            {
                FileName               = PwshExe
              , Arguments              = psArgs
              , WorkingDirectory       = LaaRepoDir
              , RedirectStandardOutput = true
              , RedirectStandardError  = true
              , UseShellExecute        = false
              , CreateNoWindow         = true
            };

            var testExitCode = await TerminalService.RunProcessAsync("test-android", testStart, ClassifyLine, timeout: TimeSpan.FromMinutes(3));
            TerminalService.SetExitCode("test-android", testExitCode);

            var failedTests = ParseFailedTests(androidState.Snapshot(), "Android Smoke Tests");
            if (failedTests.Count > 0)
            {
                AppendFailureSummaryToTerminal(TerminalService, "test-android", failedTests);
            }
        }
        finally
        {
            TerminalService.MarkRunning("test-android", false);
        }
    }

    private void AbortAndroid()  => TerminalService.Abort("test-android");
    private void ClearAndroid()  => TerminalService.Clear("test-android");

