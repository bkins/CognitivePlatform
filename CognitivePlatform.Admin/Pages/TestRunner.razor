            filename.Contains("Smoke", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("UI.Windows", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (filename.Contains("Test", StringComparison.OrdinalIgnoreCase) ||
            filename.Contains("Tests", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        try
        {
            var content = File.ReadAllText(csprojPath);
            if (content.Contains("Microsoft.NET.Test.Sdk", StringComparison.OrdinalIgnoreCase) ||
                content.Contains("xunit", StringComparison.OrdinalIgnoreCase) ||
                content.Contains("nunit", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        catch
        {
            // Ignore read errors
        }

        return false;
    }

