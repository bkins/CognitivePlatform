@page "/journals"
@implements IDisposable
@inject IAdminJournalClient JournalClient
@inject EnvironmentService  EnvService
@inject IDialogService      DialogService
@inject ISnackbar           Snackbar
@using System.Text.Json
@using System.Xml.Linq
@using Markdig

<PageTitle>Journal Admin — CP Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Journal Admin</MudText>
    <MudSpacer />
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        @_entries.Count entries (@_entries.Count(entry => entry.IsDeleted) deleted)
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@OpenCreateDialogAsync">
        New Entry
    </MudButton>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                   title="Reload entries"
                   OnClick="@LoadEntriesAsync"
                   Disabled="@_loadingEntries" />
</MudStack>

@if (_loadingEntries && _entries.Count == 0)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_entriesError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_entriesError</MudAlert>
}

<MudGrid>
    @* ── Left panel: entry list ── *@
    <MudItem xs="12" md="4">
        <MudTextField @bind-Value="_entrySearch"
                      Label="Search entries"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Immediate="true"
                      DebounceInterval="200"
                      Class="mb-2" />

        <MudPaper Elevation="1" Style="max-height:720px;overflow-y:auto;">
            <MudList Dense="true" T="JournalEntryAdminDto" SelectedValue="_selectedEntry"
                     SelectedValueChanged="@OnEntrySelected">
                @foreach (var entry in FilteredEntries)
                {
                    <MudListItem Value="@entry" Dense="true">
                        <MudStack Spacing="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.caption" Style="font-family:monospace">
                                    @entry.Id[..8]…
                                </MudText>
                                @if (entry.IsDeleted)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Style="height:16px;font-size:10px">DELETED</MudChip>
                                }
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @AdminDateFormat.Short(entry.CreatedUtc)
                                </MudText>
                            </MudStack>
                            @if (entry.LatestText is not null)
                            {
                                <MudText Typo="Typo.body2" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px">
                                    @entry.LatestText
                                </MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                @entry.RevisionCount revision(s)
                            </MudText>
                        </MudStack>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        </MudPaper>
    </MudItem>

    @* ── Right panel: revisions + correction form ── *@
    <MudItem xs="12" md="8">
        @if (_selectedEntry is null)
        {
            <MudPaper Elevation="0" Class="pa-8 d-flex justify-center align-center" Style="min-height:300px;">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Tertiary" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary">Select an entry to view revisions</MudText>
                </MudStack>
            </MudPaper>
        }
        else
        {
            @* Entry header *@
            <MudCard Elevation="2" Class="mb-4">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Class="mb-1">
                        <MudText Typo="Typo.subtitle2" Style="font-family:monospace;flex:1">@_selectedEntry.Id</MudText>
                        @if (_selectedEntry.IsDeleted)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">DELETED</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">ACTIVE</MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Created @AdminDateFormat.Long(_selectedEntry.CreatedUtc)
                    </MudText>
                    @if (_selectedEntry.DeletedReason is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">
                            Deletion reason: @_selectedEntry.DeletedReason
                        </MudText>
                    }
                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        @if (_selectedEntry.IsDeleted)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="@(() => RestoreEntryAsync(_selectedEntry))">
                                Restore
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => PromptSoftDeleteAsync(_selectedEntry))">
                                Soft Delete
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DeleteForever"
                                   OnClick="@(() => ConfirmHardDeleteAsync(_selectedEntry))">
                            Hard Delete
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>

            @* Revisions *@
            @if (_loadingRevisions)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-4" />
            }
            else if (_revisionsError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_revisionsError</MudAlert>
            }
            else if (_revisions.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">No revisions found for this entry.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    Revision History (@_revisions.Count)
                </MudText>

                <MudDataGrid Items="@_revisions"
                             Dense="true"
                             Hover="true"
                             SortMode="SortMode.None"
                             Class="mb-4">
                    <Columns>
                        <TemplateColumn Title="Date">
                            <CellTemplate>
                                <MudText Typo="Typo.caption" Style="white-space:nowrap">
                                    @AdminDateFormat.Short(context.Item.CreatedUtc)
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="State">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Item.State</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Excerpt">
                            <CellTemplate>
                                <MudText Typo="Typo.body2"
                                         Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:240px">
                                    @(context.Item.Text.Length > 80 ? context.Item.Text[..80] + "…" : context.Item.Text)
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Mood">
                            <CellTemplate>
                                @if (context.Item.Mood is not null)
                                {
                                    <MudText Typo="Typo.caption">@context.Item.Mood</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="0">
                                    <MudIconButton Icon="@(context.Item == _selectedRevision
                                                           ? Icons.Material.Filled.VisibilityOff
                                                           : Icons.Material.Filled.Visibility)"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   title="View full text"
                                                   OnClick="@(() => SelectRevision(
                                                                  context.Item == _selectedRevision
                                                                  ? null : context.Item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Secondary"
                                                   title="Edit Revision"
                                                   OnClick="@(() => OpenEditRevisionDialog(context.Item))" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>

                @* Selected revision full text *@
                @if (_selectedRevision is not null)
                {
                    <MudCard Elevation="1" Class="mb-4">
                        <MudCardContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.subtitle2">Revision @_selectedRevision.RevisionId[..8]…</MudText>
                                <MudSpacer />

                                @* ── Format selector ── *@
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @foreach (TextFormat fmt in Enum.GetValues(typeof(TextFormat)))
                                    {
                                        <MudButton Size="Size.Small"
                                                   Style="min-width:0;padding:2px 8px"
                                                   Variant="@(_format == fmt ? Variant.Filled : Variant.Outlined)"
                                                   Color="@(_format == fmt ? Color.Primary : Color.Default)"
                                                   OnClick="@(() => _format = fmt)">
                                            @FormatLabel(fmt)
                                        </MudButton>
                                    }
                                </MudStack>

                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @AdminDateFormat.Long(_selectedRevision.CreatedUtc)
                                </MudText>
                            </MudStack>

                            @if (_selectedRevision.Tags is { Length: > 0 })
                            {
                                <MudStack Row="true" Spacing="1" Class="mb-2">
                                    @foreach (var tag in _selectedRevision.Tags)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                                    }
                                </MudStack>
                            }

                            @* ── Rendered content ── *@
                            @if (ActiveFormat == TextFormat.Markdown)
                            {
                                <MudPaper Elevation="0" Class="pa-3"
                                          Style="background:var(--mud-palette-background-grey);font-size:0.9rem;">
                                    @((MarkupString)Markdown.ToHtml(_selectedRevision.Text, _markdownPipeline))
                                </MudPaper>
                            }
                            else if (ActiveFormat == TextFormat.Json)
                            {
                                <MudPaper Elevation="0" Class="pa-2"
                                          Style="background:var(--mud-palette-background-grey);overflow-x:auto;">
                                    <pre style="margin:0;font-size:0.82rem;font-family:'Cascadia Code','Consolas',monospace;white-space:pre-wrap">@PrettyJson(_selectedRevision.Text)</pre>
                                </MudPaper>
                            }
                            else if (ActiveFormat == TextFormat.Xml)
                            {
                                <MudPaper Elevation="0" Class="pa-2"
                                          Style="background:var(--mud-palette-background-grey);overflow-x:auto;">
                                    <pre style="margin:0;font-size:0.82rem;font-family:'Cascadia Code','Consolas',monospace;white-space:pre-wrap">@PrettyXml(_selectedRevision.Text)</pre>
                                </MudPaper>
                            }
                            else
                            {
                                <MudPaper Elevation="0" Class="pa-3"
                                          Style="background:var(--mud-palette-background-grey);white-space:pre-wrap;font-size:0.9rem;">
                                    @_selectedRevision.Text
                                </MudPaper>
                            }
                        </MudCardContent>
                    </MudCard>
                }
            }

            @* ── Add correction revision ── *@
            <MudExpansionPanels>
                <MudExpansionPanel Text="Add Admin Correction Revision">
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="_correctionText"
                                      Label="Revision text"
                                      Lines="6"
                                      FullWidth="true"
                                      Required="true" />

                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_correctionTags"
                                              Label="Tags (comma-separated, optional)"
                                              FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudTextField @bind-Value="_correctionMood"
                                              Label="Mood (optional)"
                                              FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudNumericField @bind-Value="_correctionMoodScore"
                                                 Label="Mood score (optional)"
                                                 Min="1"
                                                 Max="10"
                                                 FullWidth="true" />
                            </MudItem>
                        </MudGrid>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@SubmitCorrectionAsync"
                                       Disabled="@(string.IsNullOrWhiteSpace(_correctionText) || _submittingCorrection)">
                                @if (_submittingCorrection)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>Submit Correction</span>
                                }
                            </MudButton>

                            @if (_correctionMessage is not null)
                            {
                                <MudAlert Severity="@_correctionSeverity" Dense="true">@_correctionMessage</MudAlert>
                            }
                        </MudStack>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudItem>
</MudGrid>

@* ── Create Entry Dialog ── *@
<MudDialog @bind-Visible="_createDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Create Journal Entry</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_createEntryText"
                          Label="Entry Content"
                          Lines="6"
                          FullWidth="true"
                          Required="true" />

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_createEntryTags"
                                  Label="Tags (comma-separated, optional)"
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_createEntryMood"
                                  Label="Mood (optional)"
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField @bind-Value="_createEntryMoodScore"
                                     Label="Mood score (optional)"
                                     Min="1"
                                     Max="10"
                                     FullWidth="true" />
                </MudItem>
            </MudGrid>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@SubmitCreateEntryAsync"
                   Disabled="@(string.IsNullOrWhiteSpace(_createEntryText) || _creatingEntry)">
            @if (_creatingEntry)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>Create Entry</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* ── Edit Revision Dialog ── *@
<MudDialog @bind-Visible="_editRevisionDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Journal Revision (@_editingRevision?.RevisionId[..8]…)</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_editRevisionText"
                          Label="Revision Content"
                          Lines="6"
                          FullWidth="true"
                          Required="true" />

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editRevisionTags"
                                  Label="Tags (comma-separated, optional)"
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_editRevisionMood"
                                  Label="Mood (optional)"
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField @bind-Value="_editRevisionMoodScore"
                                     Label="Mood score (optional)"
                                     Min="1"
                                     Max="10"
                                     FullWidth="true" />
                </MudItem>
            </MudGrid>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editRevisionDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   OnClick="@SubmitEditRevisionAsync"
                   Disabled="@(string.IsNullOrWhiteSpace(_editRevisionText) || _savingRevision)">
            @if (_savingRevision)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>Save Changes</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* ── Soft Delete Reason Dialog ── *@
<MudDialog @bind-Visible="_softDeleteDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Soft Delete Entry</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_softDeleteReason"
                      Label="Deletion Reason (optional)"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _softDeleteDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="@SubmitSoftDeleteAsync"
                   Disabled="@_deletingEntry">
            @if (_deletingEntry)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>Soft Delete</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private enum TextFormat { Auto, Plain, Markdown, Json, Xml }

    private static readonly MarkdownPipeline _markdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private static readonly JsonSerializerOptions PrettyJsonOpts =
        new() { WriteIndented = true };

    private List<JournalEntryAdminDto>    _entries           = [];
    private List<JournalRevisionAdminDto> _revisions         = [];
    private JournalEntryAdminDto?         _selectedEntry;
    private JournalRevisionAdminDto?      _selectedRevision;
    private bool                          _loadingEntries;
    private bool                          _loadingRevisions;
    private TextFormat                    _format            = TextFormat.Auto;
    private TextFormat                    _detectedFormat    = TextFormat.Plain;
    private string?                       _entriesError;
    private string?                       _revisionsError;
    private string                        _entrySearch       = string.Empty;

    private TextFormat ActiveFormat
        => _format == TextFormat.Auto ? _detectedFormat : _format;

    private string  _correctionText      = string.Empty;
    private string  _correctionTags      = string.Empty;
    private string? _correctionMood;
    private int?    _correctionMoodScore;
    private bool    _submittingCorrection;
    private string? _correctionMessage;
    private Severity _correctionSeverity = Severity.Success;

    private IEnumerable<JournalEntryAdminDto> FilteredEntries =>
        string.IsNullOrWhiteSpace(_entrySearch)
            ? _entries
            : _entries.Where(entry =>
                  (entry.LatestText?.Contains(_entrySearch, StringComparison.OrdinalIgnoreCase) ?? false)
               || entry.Id.Contains(_entrySearch, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        EnvService.EnvironmentChanged += OnEnvironmentChanged;
    }

    protected override async Task OnInitializedAsync() => await LoadEntriesAsync();

    private void OnEnvironmentChanged()
        => InvokeAsync(async () =>
        {
            _selectedEntry     = null;
            _selectedRevision  = null;
            _format            = TextFormat.Auto;
            _detectedFormat    = TextFormat.Plain;
            _revisions         = [];
            _correctionMessage = null;
            await LoadEntriesAsync();
            StateHasChanged();
        });

    // ── Format detection & rendering ──────────────────────────────────────────

    private string FormatLabel(TextFormat fmt) => fmt switch
    {
        TextFormat.Auto     => $"Auto ({FormatShortName(_detectedFormat)})"
      , TextFormat.Plain    => "Raw"
      , TextFormat.Markdown => "MD"
      , TextFormat.Json     => "JSON"
      , TextFormat.Xml      => "XML"
      , _                   => fmt.ToString()
    };

    private static string FormatShortName(TextFormat fmt) => fmt switch
    {
        TextFormat.Plain    => "Raw"
      , TextFormat.Markdown => "MD"
      , TextFormat.Json     => "JSON"
      , TextFormat.Xml      => "XML"
      , _                   => "?"
    };

    private static TextFormat DetectFormat(string text)
    {
        var trimmed = text.AsSpan().TrimStart();
        if (trimmed.IsEmpty) return TextFormat.Plain;

        // JSON — starts with { or [
        if (trimmed[0] is '{' or '[')
        {
            try
            {
                JsonSerializer.Deserialize<JsonElement>(text);
                return TextFormat.Json;
            }
            catch { /* not valid JSON */ }
        }

        // XML / XAML — starts with < (but not markdown emphasis like <word>)
        if (trimmed[0] == '<' && trimmed.Length > 1 && trimmed[1] != ' ')
        {
            try
            {
                XDocument.Parse(text);
                return TextFormat.Xml;
            }
            catch { /* not valid XML */ }
        }

        // Markdown heuristics — look for common syntax patterns
        if (text.Contains("**")
         || text.Contains("##")
         || text.StartsWith("# ")
         || text.Contains("```")
         || text.Contains("- [ ]")
         || (text.Contains('[') && text.Contains("](")))
            return TextFormat.Markdown;

        return TextFormat.Plain;
    }

    private static string PrettyJson(string text)
    {
        try
        {
            var element = JsonSerializer.Deserialize<JsonElement>(text);
            return JsonSerializer.Serialize(element, PrettyJsonOpts);
        }
        catch
        {
            return text;
        }
    }

    private static string PrettyXml(string text)
    {
        try   { return XDocument.Parse(text).ToString(); }
        catch { return text; }
    }

    public void Dispose()
    {
        EnvService.EnvironmentChanged -= OnEnvironmentChanged;
    }

    private async Task LoadEntriesAsync()
    {
        _loadingEntries = true;
        _entriesError   = null;

        try
        {
            var result = await JournalClient.GetEntriesAsync();
            _entries    = [..result];
        }
        catch (Exception ex)
        {
            _entriesError = $"Failed to load entries: {ex.Message}";
        }
        finally
        {
            _loadingEntries = false;
        }
    }

    private void SelectRevision(JournalRevisionAdminDto? revision)
    {
        _selectedRevision = revision;
        if (revision is not null)
        {
            _format         = TextFormat.Auto;
            _detectedFormat = DetectFormat(revision.Text);
        }
    }

    private async Task OnEntrySelected(JournalEntryAdminDto? entry)
    {
        _selectedEntry     = entry;
        _selectedRevision  = null;
        _format            = TextFormat.Auto;
        _detectedFormat    = TextFormat.Plain;
        _revisions         = [];
        _correctionMessage = null;

        if (entry is null) return;

        _loadingRevisions = true;
        _revisionsError   = null;

        try
        {
            var result  = await JournalClient.GetRevisionsAsync(entry.Id);
            _revisions  = [..result];
        }
        catch (Exception ex)
        {
            _revisionsError = $"Failed to load revisions: {ex.Message}";
        }
        finally
        {
            _loadingRevisions = false;
        }
    }

    private async Task SubmitCorrectionAsync()
    {
        if (_selectedEntry is null 
         || _correctionText.HasNoValue()) return;

        _submittingCorrection = true;
        _correctionMessage    = null;

        try
        {
            var tags = _correctionTags.Split(','
                                           , StringSplitOptions.RemoveEmptyEntries 
                                           | StringSplitOptions.TrimEntries);

            var revisionId = await JournalClient.AddCorrectionAsync(_selectedEntry.Id
                                                                  , new AddCorrectionRevisionRequest
                                                                    {
                                                                            Text      = _correctionText
                                                                          , Tags      = tags
                                                                          , Mood      = _correctionMood?.HasNoValue() ?? true 
                                                                                                ? null 
                                                                                                : _correctionMood
                                                                          , MoodScore = _correctionMoodScore
                                                                    });

            if (revisionId is not null)
            {
                _correctionMessage  = $"Correction revision added: {revisionId[..8]}…";
                _correctionSeverity = Severity.Success;
                _correctionText     = string.Empty;
                _correctionTags     = string.Empty;
                _correctionMood     = null;
                _correctionMoodScore = null;
                
                await OnEntrySelected(_selectedEntry);
            }
            else
            {
                _correctionMessage  = "Failed to add correction — check the API logs.";
                _correctionSeverity = Severity.Warning;
            }
        }
        catch (Exception ex)
        {
            _correctionMessage  = $"Error: {ex.Message}";
            _correctionSeverity = Severity.Error;
        }
        finally
        {
            _submittingCorrection = false;
        }
    }

    // ── CRUD Operations ───────────────────────────────────────────────────────

    private bool                      _createDialogOpen;
    private string                    _createEntryText       = string.Empty;
    private string                    _createEntryTags       = string.Empty;
    private string?                   _createEntryMood;
    private int?                      _createEntryMoodScore;
    private bool                      _creatingEntry;

    private bool                      _editRevisionDialogOpen;
    private JournalRevisionAdminDto?  _editingRevision;
    private string                    _editRevisionText      = string.Empty;
    private string                    _editRevisionTags      = string.Empty;
    private string?                   _editRevisionMood;
    private int?                      _editRevisionMoodScore;
    private bool                      _savingRevision;

    private bool                      _softDeleteDialogOpen;
    private JournalEntryAdminDto?     _entryToSoftDelete;
    private string                    _softDeleteReason      = string.Empty;
    private bool                      _deletingEntry;

    private Task OpenCreateDialogAsync()
    {
        _createEntryText      = string.Empty;
        _createEntryTags      = string.Empty;
        _createEntryMood      = null;
        _createEntryMoodScore = null;
        _createDialogOpen     = true;
        return Task.CompletedTask;
    }

    private async Task SubmitCreateEntryAsync()
    {
        if (_createEntryText.HasNoValue()) return;

        _creatingEntry = true;
        try
        {
            var tags = _createEntryTags.Split(','
                                            , StringSplitOptions.RemoveEmptyEntries 
                                            | StringSplitOptions.TrimEntries);

            var entryId = await JournalClient.CreateEntryAsync(new CreateJournalEntryAdminDto
                                                               {
                                                                   Text      = _createEntryText
                                                                 , Tags      = tags
                                                                 , Mood      = _createEntryMood?.HasNoValue() ?? true ? null : _createEntryMood
                                                                 , MoodScore = _createEntryMoodScore
                                                               });

            if (entryId is not null)
            {
                Snackbar.Add($"Journal entry created: {entryId[..8]}…", Severity.Success);
                _createDialogOpen = false;
                await LoadEntriesAsync();
                var created = _entries.FirstOrDefault(entry => entry.Id == entryId);
                if (created is not null)
                {
                    await OnEntrySelected(created);
                }
            }
            else
            {
                Snackbar.Add("Failed to create journal entry — check API logs.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating entry: {ex.Message}", Severity.Error);
        }
        finally
        {
            _creatingEntry = false;
        }
    }

    private void OpenEditRevisionDialog(JournalRevisionAdminDto revision)
    {
        _editingRevision       = revision;
        _editRevisionText      = revision.Text;
        _editRevisionTags      = revision.Tags is { Length: > 0 } ? string.Join(", ", revision.Tags) : string.Empty;
        _editRevisionMood      = revision.Mood;
        _editRevisionMoodScore = revision.MoodScore;
        _editRevisionDialogOpen = true;
    }

    private async Task SubmitEditRevisionAsync()
    {
        if (_editingRevision is null 
         || _selectedEntry is null
         || _editRevisionText.HasNoValue()) return;

        _savingRevision = true;
        try
        {
            var tags = _editRevisionTags.Split(','
                                             , StringSplitOptions.RemoveEmptyEntries 
                                             | StringSplitOptions.TrimEntries);

            var success = await JournalClient.UpdateRevisionAsync(
                _selectedEntry.Id
              , _editingRevision.RevisionId
              , new UpdateJournalRevisionAdminDto
                {
                    Text      = _editRevisionText
                  , Tags      = tags
                  , Mood      = _editRevisionMood?.HasNoValue() ?? true ? null : _editRevisionMood
                  , MoodScore = _editRevisionMoodScore
                });

            if (success)
            {
                Snackbar.Add("Revision updated successfully.", Severity.Success);
                _editRevisionDialogOpen = false;
                await OnEntrySelected(_selectedEntry);
            }
            else
            {
                Snackbar.Add("Failed to update revision — check API logs.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating revision: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingRevision = false;
        }
    }

    private void PromptSoftDeleteAsync(JournalEntryAdminDto entry)
    {
        _entryToSoftDelete     = entry;
        _softDeleteReason      = string.Empty;
        _softDeleteDialogOpen = true;
    }

    private async Task SubmitSoftDeleteAsync()
    {
        if (_entryToSoftDelete is null) return;

        _deletingEntry = true;
        try
        {
            var success = await JournalClient.SoftDeleteEntryAsync(
                _entryToSoftDelete.Id
              , new SoftDeleteJournalAdminDto { Reason = _softDeleteReason.HasNoValue() ? null : _softDeleteReason });

            if (success)
            {
                Snackbar.Add("Entry soft-deleted.", Severity.Success);
                _softDeleteDialogOpen = false;
                await LoadEntriesAsync();
                if (_selectedEntry?.Id == _entryToSoftDelete.Id)
                {
                    _selectedEntry = _entries.FirstOrDefault(entry => entry.Id == _entryToSoftDelete.Id);
                }
            }
            else
            {
                Snackbar.Add("Failed to soft-delete entry.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting entry: {ex.Message}", Severity.Error);
        }
        finally
        {
            _deletingEntry = false;
        }
    }

    private async Task RestoreEntryAsync(JournalEntryAdminDto entry)
    {
        try
        {
            var success = await JournalClient.RestoreEntryAsync(entry.Id);
            if (success)
            {
                Snackbar.Add("Entry restored.", Severity.Success);
                await LoadEntriesAsync();
                if (_selectedEntry?.Id == entry.Id)
                {
                    _selectedEntry = _entries.FirstOrDefault(item => item.Id == entry.Id);
                }
            }
            else
            {
                Snackbar.Add("Failed to restore entry.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error restoring entry: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmHardDeleteAsync(JournalEntryAdminDto entry)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Hard Delete"
          , $"Permanently delete entry '{entry.Id}' and ALL its revisions? This cannot be undone."
          , yesText: "Hard Delete"
          , cancelText: "Cancel");

        if (confirmed == true)
        {
            await DoHardDeleteAsync(entry);
        }
    }

    private async Task DoHardDeleteAsync(JournalEntryAdminDto entry)
    {
        try
        {
            var success = await JournalClient.HardDeleteEntryAsync(entry.Id);
            if (success)
            {
                Snackbar.Add("Entry permanently deleted.", Severity.Success);
                _selectedEntry    = null;
                _selectedRevision = null;
                _revisions        = [];
                await LoadEntriesAsync();
            }
            else
            {
                Snackbar.Add("Hard delete failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error during hard delete: {ex.Message}", Severity.Error);
        }
    }
}
