@page "/"
@implements IDisposable
@using System.Diagnostics
@using System.Text
@using CognitivePlatform.Admin.Services.ToolScript.Models
@inject IAdminSystemClient  SystemClient
@inject EnvironmentService  EnvService
@inject ITerminalStateService TerminalService

<PageTitle>System Health — CP Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">System Health</MudText>
    <MudSpacer />
    @if (_lastRefreshed.HasValue)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Last refreshed: @_lastRefreshed.Value.ToString("HH:mm:ss")
        </MudText>
    }
    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                   Title="Refresh now"
                   OnClick="@RefreshAsync"
                   Disabled="@_loading" />
</MudStack>

@if (_loading 
  && _stats is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_stats is not null)
{
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Environment</MudText>
                    <MudText Typo="Typo.h5">@_stats.EnvironmentName</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">LLM Provider</MudText>
                    <MudText Typo="Typo.h5">@_stats.LlmProvider</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_stats.LlmModel</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Database</MudText>
                    <MudText Typo="Typo.body2" Style="word-break: break-all;">@_stats.DatabasePath</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_stats.GroqUsage is { HasData: true } usage)
    {
        <MudText Typo="Typo.h6" Class="mt-6 mb-2">Groq Rate Limits</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Requests</MudText>
                        <MudText Typo="Typo.body2">
                            @usage.Requests.Remaining / @usage.Requests.Limit remaining
                            (@usage.Requests.UsagePercent.ToString("F1")% used)
                        </MudText>
                        <MudProgressLinear Value="@usage.Requests.UsagePercent"
                                           Color="@UsageColor(usage.Requests.UsagePercent)"
                                           Rounded="true"
                                           Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Tokens</MudText>
                        <MudText Typo="Typo.body2">
                            @usage.Tokens.Remaining / @usage.Tokens.Limit remaining
                            (@usage.Tokens.UsagePercent.ToString("F1")% used)
                        </MudText>
                        <MudProgressLinear Value="@usage.Tokens.UsagePercent"
                                           Color="@UsageColor(usage.Tokens.UsagePercent)"
                                           Rounded="true"
                                           Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            Captured at @AdminDateFormat.Short(usage.CapturedAt)
        </MudText>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            No Groq usage data yet — data appears after the first LLM call.
        </MudAlert>
    }

    @if (_stats.LanIntegrations is { Count: > 0 })
    {
        <MudText Typo="Typo.h6" Class="mt-6 mb-2">LAN Integrations</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            These services connect to your Android phone over the local network.
            Configure the phone IP in <code>appsettings.{Environment}.json</code> (gitignored).
            Leave empty to use the disconnected provider — no connection attempts, no log errors.
        </MudText>
        <MudGrid>
            @foreach (var integration in _stats.LanIntegrations)
            {
                <MudItem xs="12" sm="6">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                                <MudText Typo="Typo.subtitle2">@integration.Name</MudText>
                                @if (integration.IsConfigured)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Success"
                                             Icon="@Icons.Material.Filled.Wifi">
                                        Configured
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Default"
                                             Icon="@Icons.Material.Filled.WifiOff">
                                        Disconnected
                                    </MudChip>
                                }
                            </MudStack>
                            @if (integration.IsConfigured)
                            {
                                <MudText Typo="Typo.body2" Style="font-family:monospace;word-break:break-all">
                                    @integration.ConfiguredUrl
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Not configured — using disconnected provider.
                                    Set <code>@integration.ConfigKey</code> to enable.
                                </MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-1">
                                @integration.Note
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Remote Agent Poller</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
        Manages the background workstation poller daemon that submits remote prompts to Antigravity.
    </MudText>
    <MudCard Elevation="2" Class="mb-6">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700">Poller Daemon Status</MudText>
                        @if (_pollerRunning)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.PlayArrow">
                                @(_pollerRunningViaAdmin ? "Running (Via Admin)" : "Running (External)")
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Stop">
                                Stopped
                            </MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Script Path: <code>@GetPollerScriptPath()</code>
                    </MudText>
                    @if (_pollerError is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@_pollerError</MudText>
                    }
                </MudStack>
                <MudSpacer />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@_pollerRunning"
                           OnClick="@StartPollerAsync">
                    Start Poller
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Stop"
                           Disabled="@(!_pollerRunning)"
                           OnClick="@StopPollerAsync">
                    Stop Poller
                </MudButton>
            </MudStack>
        </MudCardContent>
        @if (_pollerRunningViaAdmin || _showPollerConsole)
        {
            <MudCardActions>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           StartIcon="@(_showPollerConsole ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="@(() => _showPollerConsole = !_showPollerConsole)">
                    Console Output
                </MudButton>
            </MudCardActions>
            <MudCollapse Expanded="_showPollerConsole">
                <MudCardContent Class="pt-0">
                    <TerminalOutput Terminal="@TerminalService.Get("remote-agent-poller")" />
                </MudCardContent>
            </MudCollapse>
        }
    </MudCard>

    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Object Store</MudText>
    <MudDataGrid Items="@_stats.ObjectCounts"
                 Dense="true"
                 Hover="true"
                 SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="@(count => count.TypeName)"    Title="Type" />
            <PropertyColumn Property="@(count => count.Total)"       Title="Total" />
            <PropertyColumn Property="@(count => count.SoftDeleted)" Title="Soft Deleted" />
            <TemplateColumn Title="Active">
                <CellTemplate>
                    <MudText>@(context.Item.Total - context.Item.SoftDeleted)</MudText>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@code {
    private SystemStatsResponse? _stats;
    private bool                 _loading;
    private string?              _error;
    private DateTime?            _lastRefreshed;
    private Timer?               _refreshTimer;

    private bool                 _pollerRunning;
    private bool                 _pollerRunningViaAdmin;
    private bool                 _showPollerConsole;
    private string?              _pollerError;

    private string GetPollerScriptPath() => @"C:\Users\benho\source\repos\AI.Workspace\Antigravity\remote-agent-poller.ps1";

    private bool IsPollerRunningExternally()
    {
        try
        {
            using var ps = System.Management.Automation.PowerShell.Create();
            ps.AddScript("Get-CimInstance Win32_Process -Filter \"name = 'pwsh.exe' or name = 'powershell.exe'\" | Select-Object -ExpandProperty CommandLine");
            var results = ps.Invoke();
            foreach (var res in results)
            {
                if (res?.ToString()?.Contains("remote-agent-poller.ps1", StringComparison.OrdinalIgnoreCase) == true)
                {
                    return true;
                }
            }
        }
        catch
        {
            // ignore
        }
        return false;
    }

    private void UpdatePollerStatus()
    {
        _pollerRunningViaAdmin = TerminalService.Get("remote-agent-poller").IsRunning;
        var runningExternally = IsPollerRunningExternally();
        
        if (_pollerRunningViaAdmin)
        {
            _pollerRunning = true;
        }
        else
        {
            _pollerRunning = runningExternally;
        }
    }

    private void OnTerminalChanged(string terminalId)
    {
        if (terminalId != "remote-agent-poller") return;
        InvokeAsync(() =>
        {
            UpdatePollerStatus();
            StateHasChanged();
        });
    }

    private async Task StartPollerAsync()
    {
        var scriptPath = GetPollerScriptPath();
        if (!System.IO.File.Exists(scriptPath))
        {
            _pollerError = $"Poller script not found at {scriptPath}";
            return;
        }

        _pollerError = null;
        _showPollerConsole = true;

        var startInfo = new ProcessStartInfo
                        {
                            FileName               = "pwsh"
                          , Arguments              = $"-NoProfile -ExecutionPolicy Bypass -File \"{scriptPath}\""
                          , RedirectStandardOutput = true
                          , RedirectStandardError  = true
                          , UseShellExecute        = false
                          , CreateNoWindow         = true
                          , StandardOutputEncoding = Encoding.UTF8
                          , StandardErrorEncoding  = Encoding.UTF8
                        };

        _ = Task.Run(async () =>
        {
            try
            {
                TerminalService.MarkRunning("remote-agent-poller", true);
                var exitCode = await TerminalService.RunProcessAsync("remote-agent-poller", startInfo);
                TerminalService.SetExitCode("remote-agent-poller", exitCode);
            }
            catch (Exception ex)
            {
                TerminalService.SetError("remote-agent-poller", ex.Message);
            }
            finally
            {
                TerminalService.MarkRunning("remote-agent-poller", false);
            }
        });

        await Task.Delay(500);
        UpdatePollerStatus();
    }

    private async Task StopPollerAsync()
    {
        _pollerError = null;

        if (_pollerRunningViaAdmin)
        {
            TerminalService.Abort("remote-agent-poller");
        }
        else
        {
            try
            {
                using var ps = System.Management.Automation.PowerShell.Create();
                ps.AddScript("Get-CimInstance Win32_Process -Filter \"name = 'pwsh.exe' or name = 'powershell.exe'\" | Where-Object { $_.CommandLine -like \"*remote-agent-poller.ps1*\" } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }");
                ps.Invoke();
            }
            catch (Exception ex)
            {
                _pollerError = $"Failed to stop external poller: {ex.Message}";
            }
        }

        await Task.Delay(500);
        UpdatePollerStatus();
    }

    protected override void OnInitialized()
    {
        EnvService.EnvironmentChanged += OnEnvironmentChanged;
        TerminalService.StateChanged += OnTerminalChanged;
        UpdatePollerStatus();
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        _refreshTimer = new Timer(async _ =>
                                  {
                                      await RefreshAsync();
                                      await InvokeAsync(StateHasChanged);
                                  }
                                , null
                                , TimeSpan.FromSeconds(30)
                                , TimeSpan.FromSeconds(30));
    }

    private void OnEnvironmentChanged()
        => InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });

    private async Task RefreshAsync()
    {
        _loading = true;
        _error   = null;

        try
        {
            _stats         = await SystemClient.GetStatsAsync();
            _lastRefreshed = DateTime.Now;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load stats: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color UsageColor(double percent) => percent switch
    {
        >= 90 => Color.Error
      , >= 70 => Color.Warning
      , _     => Color.Success
    };

    public void Dispose()
    {
        EnvService.EnvironmentChanged -= OnEnvironmentChanged;
        TerminalService.StateChanged -= OnTerminalChanged;
        _refreshTimer?.Dispose();
    }
}
