@using CognitivePlatform.Admin.Services
@using CognitivePlatform.Admin.Services.ToolScript.Models

<MudPaper id="@ContainerId"
          Elevation="4"
          Class="@Class"
          Style="@ComputedStyle">

    @if (_lines.Length == 0)
    {
        <div style="color:#888;font-style:italic;">
            @Placeholder
        </div>
    }
    else
    {
        @foreach (var line in _lines)
        {
            var color = LineColor(line.Kind);
            var sanitized = SanitizeText(line.Text);

            <div style="color:@color;white-space:pre-wrap;line-height:1.55;">
                @if (OnScreenshotClicked.HasDelegate && TryExtractPngPath(sanitized, out var path))
                {
                    <span>Captured failure screenshot: </span>
                    <a href="javascript:void(0)"
                       @onclick="@(() => OnScreenshotClicked.InvokeAsync(path))"
                       style="color:#569cd6;text-decoration:underline;cursor:pointer">
                        @System.IO.Path.GetFileName(path)
                    </a>
                }
                else
                {
                    @((MarkupString)FormatLineHtml(sanitized, color))
                }
            </div>
        }
    }

    @if (EndElementId.HasValue())
    {
        <div id="@EndElementId"></div>
    }

</MudPaper>

@code
{
    [Parameter]
    public TerminalState? Terminal { get; set; }

    [Parameter]
    public IReadOnlyList<TerminalLine>? Lines { get; set; }

    [Parameter]
    public string Height { get; set; } = "400px";

    [Parameter]
    public string Placeholder { get; set; } = "Run this tool to see output...";

    [Parameter]
    public string? ContainerId { get; set; }

    [Parameter]
    public string? EndElementId { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public EventCallback<string> OnScreenshotClicked { get; set; }

    [Parameter]
    public Func<TerminalLineKind, string>? CustomColorResolver { get; set; }

    private TerminalLine[] _lines =>
        Lines is not null
            ? [..Lines]
            : Terminal?.Snapshot() ?? [];

    private string ComputedStyle =>
        $"background:#1e1e1e;padding:16px;height:{Height};overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:0.83rem;{Style}";

    private string LineColor(TerminalLineKind kind)
    {
        if (CustomColorResolver is not null)
        {
            return CustomColorResolver(kind);
        }

        return kind switch
        {
            TerminalLineKind.Pass        => "#4ec9b0"
          , TerminalLineKind.Fail        => "#ff6b6b"
          , TerminalLineKind.Error       => "#ff6b6b"
          , TerminalLineKind.Warning     => "#ffd166"
          , TerminalLineKind.PassSummary => "#4ec9b0"
          , TerminalLineKind.FailSummary => "#ff6b6b"
          , _                            => "#d4d4d4"
        };
    }

    private static bool TryExtractPngPath(string text, out string path)
    {
        path = "";
        const string marker = "Screenshot saved -> ";
        var idx = text.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return false;

        path = text[(idx + marker.Length)..].Trim();
        return path.EndsWith(".png", StringComparison.OrdinalIgnoreCase);
    }

    private static string SanitizeText(string text)
    {
        if (text.Contains('Γ'))
        {
            text = text.Replace("ΓöÇ", "─")
                       .Replace("Γöé", "│")
                       .Replace("Γöî", "┌")
                       .Replace("ΓöÉ", "┐")
                       .Replace("Γöö", "└")
                       .Replace("Γöÿ", "┘")
                       .Replace("Γö£", "├")
                       .Replace("Γöñ", "┤")
                       .Replace("Γö¼", "┬")
                       .Replace("Γö┤", "┴")
                       .Replace("Γö╝", "┼");
        }
        return text;
    }

    private static string FormatLineHtml(string text, string defaultColor)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(text);

        // Highlight box drawing divider lines
        if (encoded.Contains('─') || encoded.Contains('═'))
        {
            return $"<span style=\"color:#505050\">{encoded}</span>";
        }

        // Highlight [TELE] telemetry markers
        if (encoded.Contains("[TELE]"))
        {
            encoded = encoded.Replace("[TELE]", "<span style=\"color:#c586c0;font-weight:600\">[TELE]</span>");
        }

        // Highlight markdown header lines (# Header)
        var trimmed = encoded.TrimStart();
        if (trimmed.StartsWith("# ") || trimmed.StartsWith("## ") || trimmed.StartsWith("### "))
        {
            return $"<span style=\"color:#64b5f6;font-weight:bold\">{encoded}</span>";
        }

        // Format **Key**: value markdown bold patterns
        if (encoded.Contains("**"))
        {
            encoded = System.Text.RegularExpressions.Regex.Replace(
                encoded,
                @"\*\*([^*]+)\*\*",
                "<b style=\"color:#9cdcfe\">$1</b>");
        }

        return encoded;
    }
}