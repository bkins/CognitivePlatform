<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName Condition="'$(AssemblyName)' == ''">CognitivePlatform.Api</AssemblyName>
    <FileDescription Condition="'$(FileDescription)' == ''">CognitivePlatform.Api</FileDescription>
    <ApplicationIcon>appicon_background.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CP.Shared.Primitives" Version="0.1.44" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.11" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Development\" />
    <Folder Include="Data\Media\" />
    <Folder Include="Data\QA\" />
    <Folder Include="Prompts\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Prompts\system.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\Application Documentation\The CP Universe\Complete Universe.md">
      <Link>_Documentation\Complete Universe.md</Link>
    </Content>
  </ItemGroup>

</Project>
