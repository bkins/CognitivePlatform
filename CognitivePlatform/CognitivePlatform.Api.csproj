<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName Condition="'$(AssemblyName)' == ''">CognitivePlatform.Api</AssemblyName>
    <FileDescription Condition="'$(FileDescription)' == ''">CognitivePlatform.Api</FileDescription>
    <ApplicationIcon>appicon_background.ico</ApplicationIcon>
    <UserSecretsId>1be4e63f-a96d-44f6-b08f-ed88ee0739bc</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE; VERBOSE_STARTUP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConfigurationDiagnostics" Version="1.0.5" />
    <PackageReference Include="CP.Shared.Primitives" Version="1.1.0.47" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.11" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Development\" />
    <Folder Include="Data\Media\" />
    <Folder Include="Data\QA\" />
    <Folder Include="Prompts\" />
    <Folder Include="Startup\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Prompts\system.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Prompts\grounding.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\Application Documentation\The CP Universe\_Core\Complete Universe.md">
      <Link>_Documentation\Complete Universe.md</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CP.Client.Core\CP.Client.Core\CP.Client.Core.csproj" />
  </ItemGroup>

  <Target Name="KillRunningProcesses" BeforeTargets="PrepareForBuild">
    <Message Importance="high" Text="Killing running instances of CognitivePlatform.Api..." />
    <Exec Command="taskkill /f /im CognitivePlatform.Api.exe 2&gt;nul || exit 0" IgnoreExitCode="true" />
  </Target>

</Project>
